@namespace ServiceDeskSystem.Components.UI
@using ServiceDeskSystem.Application.Services.Localization
@using ServiceDeskSystem.Application.Services.Toasts.Models
@inject ILocalizationService L

@* toast-container: position from the toast-position setting, see Styles/input.css. *@
<div class="toast-container pointer-events-none fixed z-[100000] flex flex-col gap-2" role="status" aria-live="polite">
    @foreach (var toast in Toasts)
    {
        <div @key="toast.Id" data-toast="@toast.Type.ToString().ToLowerInvariant()"
             class="pointer-events-auto flex min-w-[300px] max-w-[400px] items-baseline gap-3 rounded-lg border border-line bg-surface px-3.5 py-2.5 @(toast.IsHiding ? "animate-toast-out" : "animate-toast-in")">
            <span data-toast-label class="shrink-0 font-mono text-13 @LabelClass(toast.Type)">@Label(toast.Type)</span>
            <span data-toast-message class="flex-1 text-13 text-fg">@toast.Message</span>
            <button type="button"
                    @onclick="@(() => OnRemoveToast.InvokeAsync(toast))"
                    data-toast-close
                    class="shrink-0 font-mono text-15 leading-none text-muted hover:text-fg"
                    aria-label="@L.Translate("common.close")">×</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ToastMessage> Toasts { get; set; } = [];

    [Parameter]
    public EventCallback<ToastMessage> OnRemoveToast { get; set; }

    // Mono type labels instead of colored icons.
    private static string Label(ToastType type) => type switch
    {
        ToastType.Success => "ok",
        ToastType.Error => "err",
        ToastType.Warning => "warn",
        _ => "info",
    };

    private static string LabelClass(ToastType type) => type switch
    {
        ToastType.Success => "text-accent-ink",
        ToastType.Error or ToastType.Warning => "text-danger",
        _ => "text-muted",
    };
}
