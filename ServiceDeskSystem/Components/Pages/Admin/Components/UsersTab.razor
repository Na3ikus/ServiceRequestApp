@inherits BaseComponent
@using ServiceDeskSystem.Domain.Enums

@{
    var rows = GetFilteredUsers();
}

<AdminToolbar @bind-Value="SearchQuery">
    <Actions>
        <span data-register-note class="font-mono text-13 text-muted">@Heading("admin.usersRegisterNote")</span>
    </Actions>
</AdminToolbar>

@if (rows is null)
{
    <p data-loading class="px-3.5 py-7 font-mono text-13 text-muted">@Heading("common.loading")</p>
}
else if (rows.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(SearchQuery))
    {
        <EmptyState Message="@L.Translate("admin.noUsers")" />
    }
    else
    {
        <EmptyState Message="@L.Translate("admin.noSearchResults")" ActionText="@Heading("admin.clearSearch")" OnAction="ClearSearch" />
    }
}
else
{
    <div class="overflow-x-auto">
        <table data-term class="w-full min-w-[640px] border-collapse text-left text-14">
            <thead>
                <tr class="border-b border-line font-mono text-13 text-muted">
                    <th class="font-normal" aria-sort="ascending">@Heading("admin.user") <span aria-hidden="true">↑</span></th>
                    <th class="w-64 font-normal">@Heading("admin.role")</th>
                    <th class="w-24 font-normal">@Heading("admin.active")</th>
                    <th class="w-16 font-normal"><span class="sr-only">@L.Translate("admin.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in rows)
                {
                    if (Row.IsDeleting(user.Id))
                    {
                        <DeletePrompt @key="@($"delete-{user.Id}")" Columns="4" Kind="user" Name="@user.Login"
                                      IsDeleting="Row.IsBusy" OnConfirm="() => DeleteUserAsync(user)" OnCancel="Row.Close" />
                        continue;
                    }

                    <tr @key="user.Id" data-row="@user.Id" data-inactive="@(!user.IsActive)"
                        class="border-b border-dashed border-line hover:bg-surface @(user.IsActive ? null : "[&>td]:opacity-60")">
                        <td>
                            <div class="flex min-w-0 items-center gap-2.5">
                                <Avatar Name="@GetDisplayName(user)" Size="AvatarSize.Sm" />
                                <div class="min-w-0">
                                    <div class="truncate text-fg">@GetDisplayName(user)</div>
                                    <div class="truncate font-mono text-13 text-muted">@@@user.Login</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="flex flex-wrap items-center gap-2">
                                @if (CanEditUserRole(user))
                                {
                                    <SegmentedControl Label="@L.Translate("admin.role")" Options="RoleOptions"
                                                      Value="@user.Role.ToString()" ValueChanged="value => ChangeRoleAsync(user, value)" />
                                    @if (failedRoleUserId == user.Id)
                                    {
                                        <span data-role-error role="status" class="font-mono text-13 text-danger">✗ @Heading("admin.notSaved")</span>
                                    }
                                }
                                else
                                {
                                    <RoleTag Role="user.Role" />
                                }
                            </div>
                        </td>
                        <td>
                            <ToggleSwitch Label="@L.Translate("admin.active")" Value="user.IsActive" Disabled="@(!CanToggleUserStatus(user))"
                                          ValueChanged="_ => ToggleUserStatusAsync(user.Id)" />
                        </td>
                        <td class="whitespace-nowrap text-right font-mono text-13">
                            @if (CanDeleteUser(user))
                            {
                                <button type="button" data-action="delete" class="text-muted hover:text-danger"
                                        title="@L.Translate("common.delete")" aria-label="@L.Translate("common.delete")"
                                        @onclick="() => Row.ConfirmDelete(user.Id)">×</button>
                            }
                            else
                            {
                                <span class="text-muted" title="@L.Translate("admin.cannotDeleteAdmin")">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
