@using ServiceDeskSystem.Application.Services.WorkLogs
@using ServiceDeskSystem.Domain.Entities
@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent
@inject IWorkLogService WorkLogService

@* Staff only: the ticket page renders this section for admins and developers. *@
<section data-section="worklog" class="border-t border-line py-6">
    <div class="mb-3 flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-13 text-muted"># @Heading("details.workLogs")</h2>
        @if (logs is { Count: > 0 })
        {
            <span data-total class="font-mono text-13 text-muted">@Heading("details.totalTime") @FormatDuration(TotalTimeMinutes)</span>
        }
    </div>

    @if (logs is null)
    {
        <div class="h-9 rounded-md bg-surface" aria-busy="true"></div>
    }
    else if (logs.Count == 0)
    {
        <p class="font-mono text-13 text-muted">&gt; @L.Translate("details.noWorkLogs")</p>
    }
    else
    {
        <ul class="border-t border-dashed border-line">
            @foreach (var log in logs.OrderByDescending(l => l.DateLogged))
            {
                <li data-worklog class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-dashed border-line py-2">
                    <span class="w-28 shrink-0 font-mono text-13 text-muted">@ToLocal(log.DateLogged).ToString("dd MMM yyyy", UiCulture)</span>
                    <span class="min-w-0 flex-1 basis-48 whitespace-pre-wrap break-words text-14 text-fg">@log.Description</span>
                    <span class="font-mono text-13 text-muted">@log.User?.Login</span>
                    <span class="w-20 text-right font-mono text-13 text-fg">@FormatDuration(log.TimeSpentMinutes)</span>
                    @if (log.UserId == CurrentUserId || IsAdmin)
                    {
                        <button type="button" class="btn-ghost h-6 px-1.5 font-mono text-13 hover:text-danger"
                                title="@L.Translate("common.delete")" aria-label="@DeleteLabel(log)"
                                @onclick="() => DeleteLogAsync(log.Id)">×</button>
                    }
                </li>
            }
        </ul>
    }

    <div data-worklog-form class="mt-3 flex flex-wrap gap-2">
        <input type="date" class="input-field w-40 font-mono text-13 [color-scheme:light] dark:[color-scheme:dark]"
               aria-label="@L.Translate("details.workDate")" @bind="newLogDate" @bind:after="MarkDateTouched" />
        <input type="number" min="1" class="input-field w-28 font-mono text-13"
               aria-label="@L.Translate("details.timeSpentMinutes")" placeholder="@L.Translate("details.timeSpentMinutes")"
               @bind="newLogMinutes" />
        <input type="text" class="input-field min-w-48 flex-1 basis-56"
               aria-label="@L.Translate("details.workDescription")" placeholder="@Heading("details.workDescription")"
               @bind="newLogDescription" />
        <button type="button" data-add-worklog class="btn-ghost h-9 px-3 text-15 text-fg disabled:opacity-50"
                disabled="@isSaving" @onclick="SaveWorkLogAsync">
            @Heading(isSaving ? "common.saving" : "details.addShort")
        </button>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p role="alert" class="mt-2 text-13 text-danger">@errorMessage</p>
    }
</section>

@code {
    private List<WorkLog>? logs;
    private bool isSaving;
    private string? errorMessage;

    private int newLogMinutes = 60;
    private DateTime newLogDate;
    private bool dateTouched;
    private string newLogDescription = string.Empty;

    [Parameter, EditorRequired] public int TicketId { get; set; }

    [Parameter, EditorRequired] public bool IsAdmin { get; set; }

    [Parameter, EditorRequired] public int CurrentUserId { get; set; }

    private int TotalTimeMinutes => logs?.Sum(l => l.TimeSpentMinutes) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        newLogDate = UserZone.Today.ToDateTime(TimeOnly.MinValue);
        await LoadLogsAsync();
    }

    protected override void OnTimeZoneChanged(object? sender, EventArgs e)
    {
        // The browser reports its zone after the first render: "today" may be another day there.
        _ = InvokeAsync(() =>
        {
            if (!dateTouched)
            {
                newLogDate = UserZone.Today.ToDateTime(TimeOnly.MinValue);
            }

            StateHasChanged();
        });
    }

    private void MarkDateTouched() => dateTouched = true;

    private string DeleteLabel(WorkLog log) =>
        $"{L.Translate("common.delete")}: {ToLocal(log.DateLogged).ToString("dd MMM yyyy", UiCulture)}, {FormatDuration(log.TimeSpentMinutes)}, {log.Description}";

    private async Task LoadLogsAsync()
    {
        var result = await WorkLogService.GetWorkLogsByTicketIdAsync(TicketId);
        logs = result.ToList();
    }

    private async Task SaveWorkLogAsync()
    {
        if (isSaving)
        {
            return;
        }

        if (newLogMinutes <= 0)
        {
            errorMessage = L.Translate("details.invalidTime");
            return;
        }

        if (string.IsNullOrWhiteSpace(newLogDescription))
        {
            errorMessage = L.Translate("details.invalidDescription");
            return;
        }

        isSaving = true;
        errorMessage = null;

        // The picked day starts at local midnight in the user's zone; stored as UTC.
        (bool Success, string? ErrorMessage) result;
        try
        {
            var day = DateOnly.FromDateTime(newLogDate);
            result = await WorkLogService.AddWorkLogAsync(TicketId, CurrentUserId, newLogMinutes, UserZone.ToUtc(newLogDate.Date), newLogDescription.Trim(), day);
        }
        finally
        {
            isSaving = false;
        }

        if (result.Success)
        {
            newLogMinutes = 60;
            newLogDescription = string.Empty;
            newLogDate = UserZone.Today.ToDateTime(TimeOnly.MinValue);
            dateTouched = false;
            await LoadLogsAsync();
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }
    }

    private async Task DeleteLogAsync(int id)
    {
        var result = await WorkLogService.DeleteWorkLogAsync(id, CurrentUserId);
        if (result.Success)
        {
            await LoadLogsAsync();
        }
    }

    private string FormatDuration(int minutes)
    {
        var hours = minutes / 60;
        var mins = minutes % 60;
        if (hours > 0)
        {
            return mins > 0 ? $"{hours}{L.Translate("details.hr")} {mins:00}{L.Translate("details.min")}" : $"{hours}{L.Translate("details.hr")}";
        }

        return $"{mins}{L.Translate("details.min")}";
    }
}
