@inherits BaseComponent

@{
    var filteredProducts = GetFilteredProducts();
}

<!-- Table Section Card -->
<div class="atab-card">

    <!-- Toolbar -->
    <div class="atab-toolbar">
        <div class="atab-toolbar-left">
            <h2 class="atab-title">@L.Translate("admin.products")</h2>
            @if (filteredProducts is not null)
            {
                <span class="atab-count-badge">@filteredProducts.Count</span>
            }
        </div>
        <div class="atab-toolbar-right">
            <div class="atab-search-wrap">
                <svg class="atab-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
                </svg>
                <input type="search"
                       class="atab-search-input"
                       placeholder="@(L.Translate("search.label"))..."
                       @bind="SearchQuery"
                       @bind:event="oninput" />
            </div>
            <button @onclick="ShowAddProduct" class="atab-add-btn">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                @L.Translate("admin.addProduct")
            </button>
        </div>
    </div>

    @if (Products is null)
    {
        <div class="atab-loading">
            <svg class="atab-spinner" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>@L.Translate("common.loading")</span>
        </div>
    }
    else if (filteredProducts is not null && filteredProducts.Count == 0)
    {
        <div class="atab-empty">
            <div class="atab-empty-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
            <p class="atab-empty-title">@(string.IsNullOrWhiteSpace(SearchQuery) ? L.Translate("admin.noProducts") : L.Translate("admin.noSearchResults"))</p>
            @if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                <button class="atab-empty-clear" @onclick="@(() => SearchQuery = string.Empty)">
                    @L.Translate("admin.clearSearch")
                </button>
            }
        </div>
    }
    else
    {
        <div class="atab-table-wrap">
            <table class="atab-table">
                <thead>
                    <tr>
                        <th class="atab-th sortable @(SortColumn == "name" ? "sort-active" : "")"
                            style="min-width: 160px;"
                            @onclick="@(() => SetSort("name"))">
                            @L.Translate("admin.name")
                            <span class="sort-arrow">@GetSortArrow("name")</span>
                        </th>
                        <th class="atab-th" style="min-width: 220px;">@L.Translate("admin.description")</th>
                        <th class="atab-th sortable @(SortColumn == "version" ? "sort-active" : "")"
                            style="width: 100px; white-space: nowrap;"
                            @onclick="@(() => SetSort("version"))">
                            @L.Translate("admin.version")
                            <span class="sort-arrow">@GetSortArrow("version")</span>
                        </th>
                        <th class="atab-th sortable @(SortColumn == "techstack" ? "sort-active" : "")"
                            style="min-width: 170px; white-space: nowrap;"
                            @onclick="@(() => SetSort("techstack"))">
                            @L.Translate("admin.techStack")
                            <span class="sort-arrow">@GetSortArrow("techstack")</span>
                        </th>
                        <th class="atab-th atab-th-center" style="width: 70px;">
                            <svg style="width:1rem;height:1rem;display:inline-block;vertical-align:middle;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                            </svg>
                        </th>
                        <th class="atab-th atab-th-actions" style="width: 100px;">@L.Translate("admin.actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in filteredProducts!)
                    {
                        <tr class="atab-row">
                            <td class="atab-td atab-td-primary">@product.Name</td>
                            <td class="atab-td atab-td-desc">
                                <span class="atab-desc-text" title="@product.Description">@product.Description</span>
                            </td>
                            <td class="atab-td atab-td-nowrap">
                                <span class="atab-version-badge">@product.CurrentVersion</span>
                            </td>
                            <td class="atab-td atab-td-nowrap">
                                @if (product.TechStack is not null)
                                {
                                    <span class="atab-stack-badge @GetStackColorClass(product.TechStack.Type)">
                                        @product.TechStack.Name
                                    </span>
                                }
                            </td>
                            <td class="atab-td atab-td-center">
                                <span class="atab-ticket-count @(product.Tickets?.Count > 0 ? "has-tickets" : "")">
                                    @(product.Tickets?.Count ?? 0)
                                </span>
                            </td>
                            <td class="atab-td atab-td-actions">
                                <button @onclick="@(() => EditProduct(product))"
                                        class="atab-action-btn edit"
                                        title="@L.Translate("common.edit")">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </button>
                                <button @onclick="@(() => DeleteProduct(product))"
                                        class="atab-action-btn delete @(product.Tickets?.Count > 0 ? "disabled" : "")"
                                        disabled="@(product.Tickets?.Count > 0)"
                                        title="@(product.Tickets?.Count > 0 ? L.Translate("admin.cannotDeleteProductWithTickets") : L.Translate("common.delete"))">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="atab-footer">
            <span class="atab-footer-info">
                @if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    @($"{filteredProducts!.Count} / {Products?.Count ?? 0}")
                }
                else
                {
                    @($"{Products?.Count ?? 0}")
                }
            </span>
        </div>
    }
</div>

<!-- Modal -->
<Modal IsOpen="ShowModal"
       Title="@ModalTitle"
       Subtitle="@L.Translate("admin.products")"
       ErrorMessage="@ErrorMessage"
       IsSaving="IsSaving"
       OnClose="CloseModal"
       OnSave="SaveModal"
       CancelText="@L.Translate("common.cancel")"
       SaveText="@L.Translate("common.save")"
       SavingText="@L.Translate("common.saving")">
    <HeaderIcon>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
    </HeaderIcon>
    <ChildContent>
        <div class="amodal-field">
            <label class="amodal-label">@L.Translate("admin.name")</label>
            <input type="text" @bind="EditingProduct.Name" class="amodal-input"
                   placeholder="@L.Translate("admin.productNamePlaceholder")" />
        </div>
        <div class="amodal-field">
            <label class="amodal-label">@L.Translate("admin.description")</label>
            <textarea @bind="EditingProduct.Description" rows="3" class="amodal-input amodal-textarea"
                      placeholder="@L.Translate("admin.productDescriptionPlaceholder")"></textarea>
        </div>
        <div class="amodal-row-2">
            <div class="amodal-field">
                <label class="amodal-label">@L.Translate("admin.version")</label>
                <input type="text" @bind="EditingProduct.CurrentVersion" class="amodal-input"
                       placeholder="1.0.0" />
            </div>
            <div class="amodal-field">
                <label class="amodal-label">@L.Translate("admin.techStack")</label>
                <select @bind="EditingProduct.TechStackId" class="amodal-input amodal-select">
                    @foreach (var ts in TechStacks ?? [])
                    {
                        <option value="@ts.Id">@ts.Name (@ts.Type)</option>
                    }
                </select>
            </div>
        </div>
    </ChildContent>
</Modal>
