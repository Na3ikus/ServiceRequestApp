<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ServiceDeskSystemApp.ViewModels"
             x:Class="ServiceDeskSystemApp.Views.CreateTicketPage"
             x:DataType="vm:CreateTicketViewModel"
             Title="Create Ticket">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="New Ticket" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

            <Label Text="Title" FontAttributes="Bold" />
            <Entry Text="{Binding Title}" Placeholder="Brief summary of the issue" />

            <Label Text="Type" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding TicketTypes}" SelectedItem="{Binding SelectedType}" />

            <Label Text="Priority" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" />

            <Label Text="Description" FontAttributes="Bold" />
            <Editor Text="{Binding Description}" 
                    Placeholder="Detailed description..." 
                    HeightRequest="150" />

            <!-- Actually I'll use DataTrigger instead to avoid converter -->
            <Label Text="{Binding ErrorMessage}" TextColor="Red">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ErrorMessage}" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding ErrorMessage}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button Text="Create" Command="{Binding CreateTicketCommand}" Margin="0,20,0,0" />
            
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
