@using ServiceDeskSystem.Domain.Entities
@using ServiceDeskSystem.Domain.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="kanban-board overflow-x-auto pb-4" @ref="boardContainer">
    <div class="flex gap-3 min-w-max h-full">
        @foreach (var column in Columns)
        {
            var col = column;
            var colTickets = GetTicketsForColumn(col);

            <section class="kanban-column flex flex-col w-72 flex-shrink-0" aria-label="@GetStatusText(col)">
                <div class="mb-2 flex items-center justify-between px-1 font-mono text-13">
                    <h3 data-column-title class="text-muted"># @GetStatusText(col).ToLower(UiCulture)</h3>
                    <span class="tabular-nums text-muted">@colTickets.Count</span>
                </div>

                <div class="kanban-drop-zone flex-1 min-h-[200px] space-y-2 rounded-lg border border-line bg-surface p-2"
                     @ref="dropZoneRefs[col]">
                    @if (colTickets.Count == 0)
                    {
                        <p class="select-none px-1 py-6 text-center font-mono text-13 text-muted">@L.Translate("kanban.noTickets").ToLower(UiCulture)</p>
                    }
                    else
                    {
                        @foreach (var ticket in colTickets)
                        {
                            <KanbanCard @key="ticket.Id" Ticket="ticket"
                                        CanDrag="@CanUserDragTicket(ticket)" />
                        }
                    }
                </div>
            </section>
        }
    </div>
</div>

@code {
    private static readonly TicketStatus[] Columns =
    [
        TicketStatus.New,
        TicketStatus.Open,
        TicketStatus.InProgress,
        TicketStatus.Testing,
        TicketStatus.CodeReview,
        TicketStatus.Done,
        TicketStatus.Resolved,
        TicketStatus.Closed,
    ];

    private readonly Dictionary<TicketStatus, ElementReference> dropZoneRefs = new();
    private DotNetObjectReference<KanbanBoard>? dotnetRef;
    private ElementReference boardContainer;

    [Parameter, EditorRequired]
    public IReadOnlyList<Ticket> Tickets { get; set; } = [];

    /// <summary>Current user ID — needed to determine if a card is draggable.</summary>
    [Parameter]
    public int CurrentUserId { get; set; }

    /// <summary>If true, Admin can drag any ticket.</summary>
    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public EventCallback<(int TicketId, TicketStatus NewStatus)> OnStatusChanged { get; set; }

    // Initialize drop zones by status key
    private void EnsureDropZoneRef(TicketStatus status)
    {
        if (!dropZoneRefs.ContainsKey(status))
            dropZoneRefs[status] = default;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        foreach (var col in Columns)
            EnsureDropZoneRef(col);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotnetRef = DotNetObjectReference.Create(this);

            // Enable horizontal auto-scroll when dragging near board edges
            await JSRuntime.InvokeVoidAsync("kanban.initBoard", boardContainer);

            foreach (var col in Columns)
            {
                // Each call is a round-trip; the board can be removed mid-loop (view switch, filter, navigation),
                // and passing the disposed reference to JS would throw ObjectDisposedException.
                if (dotnetRef is null)
                    return;

                if (dropZoneRefs.TryGetValue(col, out var el))
                {
                    await JSRuntime.InvokeVoidAsync("kanban.initDropZone", el, dotnetRef, col.ToString());
                }
            }
        }
    }

    /// <summary>Called from JS when a ticket is dropped onto a column.</summary>
    [JSInvokable]
    public async Task OnTicketDropped(int ticketId, string newStatusStr)
    {
        if (Enum.TryParse<TicketStatus>(newStatusStr, out var newStatus))
        {
            if (OnStatusChanged.HasDelegate)
            {
                await OnStatusChanged.InvokeAsync((ticketId, newStatus));
            }
        }
    }

    private List<Ticket> GetTicketsForColumn(TicketStatus status)
        => Tickets.Where(t => t.Status == status).ToList();

    private bool CanUserDragTicket(Ticket ticket)
        => IsAdmin || ticket.DeveloperId == CurrentUserId;

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            dotnetRef?.Dispose();
            dotnetRef = null;
        }

        base.Dispose(disposing);
    }
}
