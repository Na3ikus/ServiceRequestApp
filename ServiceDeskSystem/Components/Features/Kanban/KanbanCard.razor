@using ServiceDeskSystem.Domain.Entities
@using ServiceDeskSystem.Domain.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent

<!-- Created by Nazar "N1h3" Hutsol -->
<div data-kanban-card class="kanban-card @(CanDrag ? "cursor-grab active:cursor-grabbing" : "cursor-pointer")
     flex flex-col gap-2 rounded-lg border border-line bg-canvas p-3 hover:border-muted"
     @ref="cardElement" draggable="@(CanDrag ? "true" : "false")" @onclick="HandleClick">
    <div class="flex items-center justify-between gap-2">
        <div class="flex min-w-0 flex-wrap items-center gap-1.5">
            <span class="font-mono text-13 text-muted">#@Ticket.Id</span>
            <TypeTag Type="Ticket.Type" />
        </div>
        <PriorityTag Priority="Ticket.Priority" />
    </div>

    <a href="@($"/ticket/{Ticket.Id}")" class="line-clamp-2 text-15 leading-snug text-fg hover:underline" draggable="false"
       @onclick:preventDefault="true">@Ticket.Title</a>

    @if (Ticket.Tags.Count > 0 || (IsAdminOrDeveloper && !Ticket.IsPriorityAssessed))
    {
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            @foreach (var tag in Ticket.Tags.Take(3))
            {
                <span class="inline-flex items-center gap-1.5 text-13 text-muted">
                    <span class="h-2 w-2 rounded-full" style="background-color: @tag.Color" aria-hidden="true"></span>@tag.Name
                </span>
            }
            @if (Ticket.Tags.Count > 3)
            {
                <span class="font-mono text-13 text-muted">+@(Ticket.Tags.Count - 3)</span>
            }
            @if (IsAdminOrDeveloper && !Ticket.IsPriorityAssessed)
            {
                <span data-triage class="font-mono text-13 text-danger">[@Heading("tickets.triageRequired")]</span>
            }
        </div>
    }

    <div class="flex items-center justify-between gap-2 border-t border-dashed border-line pt-2 text-13">
        <span class="flex min-w-0 items-center gap-1.5 text-muted">
            <Avatar Name="@Ticket.Author?.Login" Size="AvatarSize.Sm" />
            <span class="truncate">@Ticket.Author?.Login</span>
        </span>
        @if (Ticket.Developer is not null)
        {
            <span class="flex min-w-0 items-center gap-1.5 text-fg">
                <Avatar Name="@Ticket.Developer.Login" Size="AvatarSize.Sm" />
                <span class="truncate">@Ticket.Developer.Login</span>
            </span>
        }
        else
        {
            <span class="shrink-0 text-muted">@Heading("table.unassigned")</span>
        }
    </div>
</div>

@code {
    private ElementReference cardElement;
    private TicketStatus? _lastInitializedStatus = null;
    private bool _lastCanDrag = false;

    [Parameter, EditorRequired]
    public Ticket Ticket { get; set; } = null!;

    [Parameter]
    public bool CanDrag { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-initialize draggable whenever CanDrag is true and the status or drag permission changed.
        // This is critical: after a card moves to a new column Blazor re-renders it with new Ticket.Status,
        // but firstRender is false, so without this check the JS listener would still report the old sourceStatus.
        if (CanDrag && (firstRender || Ticket.Status != _lastInitializedStatus || CanDrag != _lastCanDrag))
        {
            _lastInitializedStatus = Ticket.Status;
            _lastCanDrag = CanDrag;
            await JSRuntime.InvokeVoidAsync("kanban.initDraggable", cardElement, Ticket.Id, Ticket.Status.ToString());
        }
    }

    private void HandleClick() => ViewTicket(Ticket.Id);
}
