@using ServiceDeskSystem.Application.Services.Localization
@inject ILocalizationService L
@inject IJSRuntime JS
@implements IDisposable

<div class="relative inline-block text-left" @onclick:stopPropagation="true">
    <button type="button"
            @onclick="ToggleDropdown"
            class="btn-ghost inline-flex items-center gap-1 font-mono text-[13px]"
            aria-haspopup="menu"
            aria-expanded="@(isOpen ? "true" : "false")">
        <span>@L.CurrentLanguage</span>
        <span aria-hidden="true">▾</span>
    </button>

    @if (isOpen)
    {
        <!-- Backdrop for clicking outside -->
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>

        <div class="absolute right-0 z-50 mt-1 w-40 rounded-lg border border-line bg-surface py-1" role="menu">
            @foreach (var lang in L.SupportedLanguages)
            {
                var isSelected = lang.Code == L.CurrentLanguage;
                <button type="button"
                        @onclick="@(() => SelectLanguage(lang.Code))"
                        role="menuitem"
                        aria-current="@(isSelected ? "true" : "false")"
                        class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-left hover:bg-canvas">
                    <span aria-hidden="true" class="w-3 font-mono text-[13px] text-accent-ink">@(isSelected ? "›" : "")</span>
                    <span class="font-mono text-[13px] text-muted">@lang.Code</span>
                    <span class="text-[13px] text-fg">@lang.NativeName</span>
                </button>
            }
        </div>
    }
</div>

@code {
    private bool isOpen;

    protected override void OnInitialized()
    {
        L.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        isOpen = !isOpen;
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private async Task SelectLanguage(string code)
    {
        L.SetLanguage(code);
        isOpen = false;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "settings.language", code);
        }
        catch { }
    }

    public void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
    }
}
