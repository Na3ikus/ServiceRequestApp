@page "/settings"
@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent
@rendermode InteractiveServer
@using ServiceDeskSystem.Application.Services.Preferences
@using ServiceDeskSystem.Components.Pages.Settings.Controls

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-3xl mx-auto p-4 sm:p-6">
    <PageHeader Segments="SettingsSegments" />

    <h2 class="font-mono text-[13px] text-muted mt-6 mb-1"># appearance</h2>
    <SettingRow Label="@L.Translate("settings.theme")">
        <SegmentedControl Label="@L.Translate("settings.theme")" Options="ThemeOptions"
                          Value="@ThemeValue" ValueChanged="SetTheme" />
    </SettingRow>
    <SettingRow Label="@L.Translate("settings.accent")" Description="@L.Translate($"settings.accent.{prefs.Accent}")">
        <AccentPicker Value="@prefs.Accent" ValueChanged="@(v => SetAsync(PreferenceSchema.Accent, v))" />
    </SettingRow>
    <SettingRow Label="@L.Translate("settings.scale")">
        <SegmentedControl Label="@L.Translate("settings.scale")" Options="ScaleOptions"
                          Value="@prefs.Scale.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          ValueChanged="@(v => SetAsync(PreferenceSchema.Scale, v))" />
    </SettingRow>
    <SettingRow Label="@L.Translate("settings.highContrast")" Description="@L.Translate("settings.highContrastDesc")">
        <ToggleSwitch Label="@L.Translate("settings.highContrast")" Value="@prefs.HighContrast"
                      ValueChanged="@(on => SetAsync(PreferenceSchema.Contrast, on ? "high" : "standard"))" />
    </SettingRow>
    <SettingRow Label="@L.Translate("settings.reduceMotion")" Description="@L.Translate("settings.reduceMotionDesc")">
        <ToggleSwitch Label="@L.Translate("settings.reduceMotion")" Value="@prefs.ReducedMotion"
                      ValueChanged="@(on => SetAsync(PreferenceSchema.ReducedMotion, Bool(on)))" />
    </SettingRow>

    <h2 class="font-mono text-[13px] text-muted mt-6 mb-1"># layout</h2>
    <SettingRow Label="@L.Translate("settings.density")" Description="@L.Translate("settings.densityDesc")">
        <SegmentedControl Label="@L.Translate("settings.density")" Options="DensityOptions"
                          Value="@prefs.Density" ValueChanged="@(v => SetAsync(PreferenceSchema.Density, v))" />
    </SettingRow>
    <SettingRow Label="@L.Translate("settings.contentWidth")">
        <SegmentedControl Label="@L.Translate("settings.contentWidth")" Options="WidthOptions"
                          Value="@prefs.ContentWidth" ValueChanged="@(v => SetAsync(PreferenceSchema.ContentWidth, v))" />
    </SettingRow>

    <h2 class="font-mono text-[13px] text-muted mt-6 mb-1"># locale</h2>
    <SettingRow Label="@L.Translate("settings.language")">
        <SegmentedControl Label="@L.Translate("settings.language")" Options="LanguageOptions"
                          Value="@L.CurrentLanguage" ValueChanged="SetLanguageAsync" />
    </SettingRow>
    <SettingRow Label="@L.Translate("settings.dateFormat")" Description="@Prefs.FormatDate(DateTime.Today)">
        <SegmentedControl Label="@L.Translate("settings.dateFormat")" Options="DateFormatOptions"
                          Value="@prefs.DateFormat" ValueChanged="@(v => SetAsync(PreferenceSchema.DateFormat, v))" />
    </SettingRow>

    <h2 class="font-mono text-[13px] text-muted mt-6 mb-1"># tickets</h2>
    <SettingRow Label="@L.Translate("settings.defaultView")">
        <SegmentedControl Label="@L.Translate("settings.defaultView")" Options="ViewOptions"
                          Value="@prefs.DefaultView" ValueChanged="@(v => SetAsync(PreferenceSchema.DefaultView, v))" />
    </SettingRow>

    <h2 class="font-mono text-[13px] text-muted mt-6 mb-1"># notifications</h2>
    <SettingRow Label="@L.Translate("settings.sound")">
        <ToggleSwitch Label="@L.Translate("settings.sound")" Value="@prefs.Sound"
                      ValueChanged="@(on => SetAsync(PreferenceSchema.Sound, Bool(on)))" />
    </SettingRow>
    <SettingRow Label="@L.Translate("settings.desktopNotifications")"
                Description="@L.Translate(desktopDenied ? "settings.desktopDenied" : "settings.desktopNotificationsDesc")">
        <ToggleSwitch Label="@L.Translate("settings.desktopNotifications")" Value="@prefs.DesktopNotifications"
                      ValueChanged="SetDesktopNotificationsAsync" />
    </SettingRow>
    <SettingRow Label="@L.Translate("settings.toastPosition")">
        <SegmentedControl Label="@L.Translate("settings.toastPosition")" Options="ToastOptions"
                          Value="@prefs.ToastPosition" ValueChanged="@(v => SetAsync(PreferenceSchema.ToastPosition, v))" />
    </SettingRow>

    <h2 class="font-mono text-[13px] text-muted mt-6 mb-1"># keyboard</h2>
    <SettingRow Label="@L.Translate("settings.keyboardShortcuts")">
        <div class="flex items-center gap-3">
            <button type="button" class="font-mono text-[13px] text-fg border border-line rounded-md px-2.5 py-1 hover:bg-surface"
                    @onclick="ShowHotkeysHelpAsync">
                @L.Translate("settings.showAll") <Kbd>?</Kbd>
            </button>
            <ToggleSwitch Label="@L.Translate("settings.keyboardShortcuts")" Value="@prefs.Shortcuts"
                          ValueChanged="@(on => SetAsync(PreferenceSchema.Shortcuts, Bool(on)))" />
        </div>
    </SettingRow>

    @if (isAdmin)
    {
        <h2 class="font-mono text-[13px] text-muted mt-6 mb-1"># system <span class="opacity-60">[admin]</span></h2>
        <SettingRow Label="@L.Translate("settings.database")">
            @StatusTag(isCheckingDb, dbAvailable)
        </SettingRow>
        <SettingRow Label="@L.Translate("settings.smtp")" Description="@(isCheckingSmtp ? null : smtpMessage)">
            @StatusTag(isCheckingSmtp, smtpAvailable)
        </SettingRow>
        <SettingRow Label="@L.Translate("settings.version")">
            <span class="font-mono text-[13px] text-muted">@AppVersion</span>
        </SettingRow>
        <div class="flex justify-end mt-3">
            <button type="button" class="font-mono text-[13px] text-fg border border-line rounded-md px-2.5 py-1 hover:bg-surface disabled:opacity-50"
                    disabled="@(isCheckingDb || isCheckingSmtp)" @onclick="CheckSystemStatusAsync">
                @L.Translate("settings.recheck")
            </button>
        </div>
    }

    <div class="flex justify-end mt-8">
        <button type="button" class="font-mono text-[13px] text-fg border border-line rounded-md px-2.5 py-1 hover:bg-surface"
                @onclick="() => showResetConfirm = true">
            @L.Translate("settings.resetDefaults")
        </button>
    </div>
</div>

<Modal IsOpen="showResetConfirm"
       Title="@L.Translate("settings.resetConfirmTitle")"
       SaveText="@L.Translate("settings.resetConfirmButton")"
       CancelText="@L.Translate("common.cancel")"
       OnSave="ConfirmResetAsync"
       OnClose="() => showResetConfirm = false">
    <p class="text-[15px] text-fg">@L.Translate("settings.resetConfirmText")</p>
</Modal>

@code {
    private RenderFragment StatusTag(bool checking, bool ok) => __builder =>
    {
        if (checking)
        {
            <span class="font-mono text-[13px] text-muted">[...]</span>
        }
        else if (ok)
        {
            <span class="font-mono text-[13px] mark">[ok]</span>
        }
        else
        {
            <span class="font-mono text-[13px] text-danger">[down]</span>
        }
    };
}
