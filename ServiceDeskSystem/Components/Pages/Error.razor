@page "/Error"
@using System.Diagnostics
@inject ILocalizationService L

<!-- Created by Nazar "N1h3" Hutsol -->
<PageTitle>Error</PageTitle>

<StatusScreen Code="500" Message="@L.Translate("errors.unexpected")">
    <a href="/" class="text-fg hover:underline"><span aria-hidden="true" class="text-accent-ink">$ </span>cd ~</a>
    @if (ShowRequestId)
    {
        <p data-request-id class="mt-6 text-13 text-muted">request id: <span class="text-fg">@RequestId</span></p>
    }
    <p class="mt-4 max-w-[70ch] font-sans text-13 text-muted">
        Swapping to the <span class="font-mono text-fg">Development</span> environment (<span class="font-mono text-fg">ASPNETCORE_ENVIRONMENT=Development</span>)
        shows details about the error. Don't enable it for deployed applications: it can show sensitive information from exceptions to end users.
    </p>
</StatusScreen>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
