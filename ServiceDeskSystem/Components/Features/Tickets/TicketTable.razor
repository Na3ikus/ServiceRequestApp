@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent

<!-- Created by Nazar "N1h3" Hutsol -->
@{
    var rows = Sorted();
}
<div class="hidden md:block overflow-x-auto rounded-lg border border-line">
    <table class="w-full border-collapse text-left">
        <thead class="sticky top-0 z-10 bg-surface">
            <tr class="border-b border-line font-mono text-13 text-muted">
                @Header(TicketSort.Id, "#", "w-16")
                @Header(TicketSort.Title, Heading("table.title"), null)
                @Header(TicketSort.Type, Heading("table.type"), "w-28")
                @Header(TicketSort.Status, Heading("table.status"), "w-32")
                @Header(TicketSort.Priority, Heading("table.priority"), "w-28")
                @if (ShowAuthor)
                {
                    @Header(TicketSort.Author, Heading("table.author"), "w-32")
                }
                @if (ShowAssignee)
                {
                    @Header(TicketSort.Assignee, Heading("table.assignee"), "w-32")
                }
                @Header(TicketSort.Created, Heading("table.created"), "w-44")
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in rows)
            {
                <tr data-ticket-row class="cursor-pointer border-b border-dashed border-line last:border-b-0 hover:bg-surface"
                    @onclick="() => OnTicketClick.InvokeAsync(ticket.Id)">
                    <td class="font-mono text-13 text-muted">#@ticket.Id</td>
                    <td class="min-w-0">
                        <a href="@($"/ticket/{ticket.Id}")" class="text-15 text-fg hover:underline" @onclick:stopPropagation="true">@ticket.Title</a>
                        @if (ticket.Tags.Count > 0 || (IsAdminOrDeveloper && !ticket.IsPriorityAssessed))
                        {
                            <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                                @foreach (var tag in ticket.Tags.Take(3))
                                {
                                    <span class="inline-flex items-center gap-1.5 text-13 text-muted">
                                        <span class="h-2 w-2 rounded-full" style="background-color: @tag.Color" aria-hidden="true"></span>@tag.Name
                                    </span>
                                }
                                @if (ticket.Tags.Count > 3)
                                {
                                    <span class="font-mono text-13 text-muted">+@(ticket.Tags.Count - 3)</span>
                                }
                                @if (IsAdminOrDeveloper && !ticket.IsPriorityAssessed)
                                {
                                    <span data-triage class="font-mono text-13 text-danger">[@Heading("tickets.triageRequired")]</span>
                                }
                            </div>
                        }
                    </td>
                    <td><TypeTag Type="ticket.Type" /></td>
                    <td><StatusTag Status="ticket.Status" /></td>
                    <td><PriorityTag Priority="ticket.Priority" /></td>
                    @if (ShowAuthor)
                    {
                        <td class="text-13 text-fg">@(ticket.Author?.Login ?? "—")</td>
                    }
                    @if (ShowAssignee)
                    {
                        <td class="text-13 @(ticket.Developer is null ? "text-muted" : "text-fg")">@(ticket.Developer?.Login ?? Heading("table.unassigned"))</td>
                    }
                    <td class="whitespace-nowrap font-mono text-13 text-muted">@ToLocal(ticket.CreatedAt).ToString("dd MMM yyyy, HH:mm", UiCulture)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="md:hidden">
    <TicketLog Tickets="rows" ShowTriage="IsAdminOrDeveloper" />
</div>

@code {
    private RenderFragment Header(TicketSort column, string text, string? widthClass) => __builder =>
    {
        var active = sort == column;
        <th class="@widthClass font-normal" aria-sort="@(active ? (descending ? "descending" : "ascending") : "none")">
            <button type="button" data-sort="@column" class="inline-flex items-center gap-1 hover:text-fg @(active ? "text-fg" : null)"
                    @onclick="() => SortBy(column)">
                @text<span aria-hidden="true" class="w-3">@(active ? (descending ? "↓" : "↑") : null)</span>
            </button>
        </th>
    };
}
