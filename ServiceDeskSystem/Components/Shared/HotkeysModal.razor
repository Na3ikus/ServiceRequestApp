@using ServiceDeskSystem.Application.Services.Localization
@inject ILocalizationService Loc

<Modal IsOpen="IsVisible"
       Title="@Loc.Translate("settings.hotkeysTitle")"
       Subtitle="@Loc.Translate("settings.hotkeysDesc")"
       OnClose="Close">
    <ChildContent>
        <ul>
            @foreach (var hotkey in Hotkeys)
            {
                <li class="flex items-center justify-between gap-4 border-b border-dashed border-line py-2 last:border-b-0">
                    <span class="text-15 text-fg">@Loc.Translate(hotkey.Action)</span>
                    <span class="flex flex-wrap items-center justify-end gap-1.5">
                        @for (var i = 0; i < hotkey.Keys.Length; i++)
                        {
                            var key = hotkey.Keys[i];
                            if (i > 0)
                            {
                                <span class="text-13 text-muted">@Loc.Translate("common.or")</span>
                            }

                            <Kbd>@key</Kbd>
                        }
                    </span>
                </li>
            }
        </ul>
    </ChildContent>
    <FooterContent>
        <button type="button" data-modal-cancel class="h-9 rounded-md border border-line px-4 text-15 text-muted hover:bg-canvas hover:text-fg" @onclick="Close">@Loc.Translate("common.close")</button>
    </FooterContent>
</Modal>

@code {
    // Alternatives for one action (e.g. "?" or "H"); each is a single key.
    private static readonly (string[] Keys, string Action)[] Hotkeys =
    [
        (["?", "H"], "settings.hotkeyShowHelp"),
        (["N"], "settings.hotkeyNewTicket"),
        (["T"], "settings.hotkeyTicketsList"),
        (["/"], "settings.hotkeySearch"),
        (["D"], "settings.hotkeyTheme"),
    ];

    public bool IsVisible { get; private set; }

    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }
}
