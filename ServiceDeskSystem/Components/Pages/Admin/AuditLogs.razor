@page "/audit-logs"
@inherits BaseComponent
@using System.Globalization
@using ServiceDeskSystem.Components.Pages.Admin.Components
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto p-4 sm:p-6">
    @if (!IsAdmin)
    {
        <PageHeader Segments="Segments" />
        <div data-access-denied>
            <EmptyState Message="@L.Translate("admin.accessDenied")" />
        </div>
    }
    else
    {
        var matching = FilteredLogs.ToList();
        var visible = matching.Take(visibleCount).ToList();

        <PageHeader Segments="Segments" Subtitle="@L.Translate("audit.subtitle")">
            <Status>
                <span data-live="@Live.ToString().ToLowerInvariant()" role="status"
                      class="inline-flex items-center gap-1.5 font-mono @(Live == LiveState.Live ? "text-fg" : "text-muted")">
                    @switch (Live)
                    {
                        case LiveState.Live:
                            <span aria-hidden="true" class="inline-block h-[7px] w-[7px] rounded-full bg-accent-ink"></span><text>live</text>
                            break;
                        case LiveState.Offline:
                            <span aria-hidden="true">○</span>@Heading("audit.realtime.offline")
                            break;
                        default:
                            <span aria-hidden="true">○</span>@Heading("audit.realtime.connecting")
                            break;
                    }
                </span>
                <span data-auto-refresh class="font-mono">· @(isAutoRefreshPaused ? Heading("audit.autoRefreshPaused") : "auto 20s")</span>
            </Status>
            <Actions>
                <button type="button" data-action="pause" class="btn-outline" @onclick="ToggleAutoRefresh">
                    @(isAutoRefreshPaused ? Heading("audit.resumeRefresh") : Heading("audit.pauseRefresh"))
                </button>
                <button type="button" data-action="refresh" class="btn-outline" disabled="@isRefreshing" @onclick="RefreshNowAsync">
                    @(isRefreshing ? Heading("audit.refreshing") : Heading("audit.refreshNow"))
                </button>
                <button type="button" data-action="export" class="btn-outline font-mono" @onclick="ExportToCsvAsync">export.csv</button>
                <button type="button" data-action="clear" class="btn-outline text-danger" aria-expanded="@showClearConfirm.ToString().ToLowerInvariant()"
                        disabled="@showClearConfirm" @onclick="RequestClearLogs">@Heading("audit.clearLogs")…</button>
            </Actions>
        </PageHeader>

        @* Its own row under the header: the prompt is wider than the buttons and would push them onto a new line. *@
        @if (showClearConfirm)
        {
            <div data-clear-prompt class="mb-4 rounded-md border border-danger/50 bg-danger/[.06] py-1 pl-3 pr-1 sm:ml-auto sm:w-fit">
                <ConfirmPrompt Label="audit.log"
                               Note="@($"{string.Format(UiCulture, Heading("audit.clearCount"), TotalLogsCount)} · {Heading("admin.deleteNote")}")"
                               ConfirmText="@Heading("audit.clearLogs")" IsBusy="isClearing"
                               OnConfirm="ConfirmClearLogsAsync" OnCancel="CancelClearLogs" />
            </div>
        }

        <div data-figures class="my-6 flex flex-wrap gap-x-12 gap-y-4">
            @Figure("total", Heading("audit.metrics.total"), TotalLogsCount)
            @Figure("today", Heading("audit.metrics.today"), TodayLogsCount)
            <div data-figure="severity">
                <p class="font-mono text-24 font-medium leading-tight tabular-nums text-fg">
                    <span class="@(CriticalCount > 0 ? "text-danger" : null)">@CriticalCount.ToString("N0", UiCulture)</span>
                    <span class="text-20 text-muted">/</span>
                    @WarningCount.ToString("N0", UiCulture)
                </p>
                <p class="mt-1 font-mono text-13 text-muted"># @Heading("audit.metrics.severity")</p>
            </div>
            @Figure("users", Heading("audit.metrics.users"), UniqueUsersCount)
        </div>

        <div data-filters class="flex flex-wrap items-center gap-2">
            <input type="search" data-search class="input-field h-8 w-full px-2.5 text-14 sm:w-64"
                   placeholder="@L.Translate("audit.searchPlaceholder")" aria-label="@L.Translate("audit.searchPlaceholder")"
                   @bind="SearchTerm" @bind:event="oninput" />
            <SegmentedControl Label="@L.Translate("audit.severity")" Options="SeverityOptions" @bind-Value="SelectedSeverity" />
            <select data-filter="category" class="input-field h-8 w-auto px-2.5 text-13" aria-label="@L.Translate("audit.filter.allCategories")"
                    @bind="SelectedCategory">
                <option value="ALL">@L.Translate("audit.filter.allCategories")</option>
                <option value="CREATE">@L.Translate("audit.category.create")</option>
                <option value="UPDATE">@L.Translate("audit.category.update")</option>
                <option value="DELETE">@L.Translate("audit.category.delete")</option>
                <option value="AUTH">@L.Translate("audit.category.auth")</option>
                <option value="ASSOCIATION">@L.Translate("audit.category.association")</option>
                <option value="OTHER">@L.Translate("audit.category.other")</option>
            </select>
            <select data-filter="entity" class="input-field h-8 w-auto px-2.5 text-13" aria-label="@L.Translate("audit.filter.allEntities")"
                    @bind="SelectedEntity">
                <option value="ALL">@L.Translate("audit.filter.allEntities")</option>
                @foreach (var entity in AvailableEntities)
                {
                    <option value="@entity">@entity</option>
                }
            </select>
            <SegmentedControl Label="@L.Translate("audit.period")" Options="PeriodOptions" @bind-Value="SelectedTimeRange" />
            <select data-filter="user" class="input-field h-8 w-auto px-2.5 text-13" aria-label="@L.Translate("audit.filter.allUsers")"
                    @bind="SelectedUserIdString">
                <option value="ALL">@L.Translate("audit.filter.allUsers")</option>
                @foreach (var user in AvailableUsers)
                {
                    <option value="@user.Id">@user.Login</option>
                }
            </select>
        </div>
        @if (HasActiveFilters)
        {
            <p data-shown class="mt-2.5 font-mono text-13 text-muted">
                @string.Format(UiCulture, L.Translate("audit.shownOf"), matching.Count, TotalLogsCount) ·
                <button type="button" data-action="reset" class="text-fg hover:underline" @onclick="ResetFilters">@Heading("audit.filter.reset")</button>
            </p>
        }

        @if (pendingNewEventsCount > 0)
        {
            <button type="button" data-pending-events
                    class="mt-4 block w-full rounded-md border border-dashed border-accent-ink px-3 py-1.5 text-center font-mono text-13 text-accent-ink hover:bg-surface"
                    @onclick="ApplyPendingEventsAsync">↑ @string.Format(UiCulture, Heading("audit.realtime.newEvents"), pendingNewEventsCount)</button>
        }

        <div data-log class="mt-2">
            @if (logs is null)
            {
                <p data-loading class="px-3.5 py-7 font-mono text-13 text-muted">@Heading("common.loading")</p>
            }
            else if (matching.Count == 0)
            {
                @if (HasActiveFilters)
                {
                    <EmptyState Message="@L.Translate("audit.noLogs")" ActionText="@Heading("audit.filter.reset")" OnAction="ResetFilters" />
                }
                else
                {
                    <EmptyState Message="@L.Translate("audit.noLogs")" />
                }
            }
            else
            {
                @foreach (var day in visible.GroupBy(LocalDate))
                {
                    <section data-day="@day.Key.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                        <h2 class="mb-1 border-b border-line pb-1.5 pt-4 font-mono text-13 font-normal text-muted"># @GetDayHeading(day.Key)</h2>
                        @foreach (var log in day)
                        {
                            var open = openLogId == log.Id;
                            var level = GetLevel(log);
                            var summary = GetLogDisplaySummary(log);
                            <button type="button" data-event="@log.Id" aria-expanded="@(open ? "true" : "false")"
                                    aria-controls="@(open ? $"audit-event-{log.Id}" : null)"
                                    class="flex w-full flex-wrap items-baseline gap-x-3 rounded px-2 py-1.5 text-left font-mono text-13 leading-relaxed hover:bg-surface focus-visible:outline focus-visible:outline-1 focus-visible:-outline-offset-2 focus-visible:outline-accent-ink md:grid md:grid-cols-[4.5rem_2.75rem_8rem_11rem_9rem_minmax(0,1fr)] md:gap-3 @(open ? "bg-surface light:bg-accent/10" : "light:hover:bg-accent/7")"
                                    @onclick="() => ToggleLog(log.Id)">
                                <span data-col="time" class="tabular-nums text-muted">@ToLocal(log.Timestamp).ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
                                <span data-col="level" class="@level.Class">@level.Text</span>
                                <span data-col="user" class="min-w-0 truncate text-fg">@GetUserLabel(log)</span>
                                <span aria-hidden="true" class="basis-full md:hidden"></span>
                                <span data-col="action" class="min-w-0 truncate text-fg">@log.Action</span>
                                <span data-col="entity" class="min-w-0 truncate text-muted">@GetEntityLabel(log)</span>
                                <span data-col="summary" class="min-w-0 basis-full truncate font-sans text-14 text-muted md:basis-auto" title="@summary">@(string.IsNullOrWhiteSpace(summary) ? "—" : summary)</span>
                            </button>
                            @if (open)
                            {
                                @Detail(log)
                            }
                        }
                    </section>
                }

                @if (visible.Count < matching.Count)
                {
                    <button type="button" data-action="more" class="block w-full px-2 py-4 text-left font-mono text-13 text-muted hover:text-fg" @onclick="ShowMore">
                        ↓ @string.Format(UiCulture, Heading("audit.showMore"), Math.Min(PageSize, matching.Count - visible.Count)) · @string.Format(UiCulture, L.Translate("audit.shownOf"), visible.Count, matching.Count)
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    private static string NullMark(string? value) => string.IsNullOrWhiteSpace(value) ? "«null»" : value;

    private RenderFragment Figure(string key, string label, int value) => __builder =>
    {
        <div data-figure="@key">
            <p class="font-mono text-24 font-medium leading-tight tabular-nums text-fg">@value.ToString("N0", UiCulture)</p>
            <p class="mt-1 font-mono text-13 text-muted"># @label</p>
        </div>
    };

    // Opens under its row: when (local, then UTC), who, what; then the diff, or the summary / raw changes.
    private RenderFragment Detail(AuditLog log) => __builder =>
    {
        var payload = GetParsedPayload(log);
        var who = new List<string>();
        if (log.UserId is int userId)
        {
            who.Add($"id {userId}");
        }

        if (!string.IsNullOrWhiteSpace(payload?.IpAddress))
        {
            who.Add(payload.IpAddress);
        }

        <div id="audit-event-@log.Id" data-detail="@log.Id" class="mb-2 bg-surface light:bg-accent/10 px-4 py-3.5 shadow-[inset_2px_0_0_rgb(var(--accent))]">
            <dl class="mb-3 grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-3.5 gap-y-1 text-14">
                <dt class="pt-px font-mono text-13 text-muted">@Heading("audit.when")</dt>
                <dd>
                    @ToLocal(log.Timestamp).ToString("d MMM yyyy, HH:mm:ss", UiCulture)
                    <span class="font-mono text-13 text-muted">· @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) UTC</span>
                </dd>
                <dt class="pt-px font-mono text-13 text-muted">@Heading("audit.who")</dt>
                <dd>
                    @GetUserLabel(log)
                    @if (who.Count > 0)
                    {
                        <span class="font-mono text-13 text-muted">· @string.Join(" · ", who)</span>
                    }
                </dd>
                <dt class="pt-px font-mono text-13 text-muted">@Heading("audit.what")</dt>
                <dd class="font-mono text-13">
                    @log.Action · @GetEntityLabel(log)
                    @if (CanNavigateToEntity(log))
                    {
                        <text> · </text><a data-entity-link href="@($"/ticket/{log.EntityId}")" class="border-b border-dashed border-muted hover:text-fg">@Heading("audit.open")</a>
                    }
                </dd>
            </dl>
            @if (payload?.Diff is { Count: > 0 } diff)
            {
                <div data-diff class="rounded-md border border-line bg-canvas px-3 py-2 font-mono text-13 leading-[1.7]">
                    @foreach (var item in diff)
                    {
                        <div class="mt-1 text-muted first:mt-0">@item.Field</div>
                        <div data-diff-old class="break-words text-danger">- @NullMark(item.OldValue)</div>
                        <div data-diff-new class="break-words text-accent-ink">+ @NullMark(item.NewValue)</div>
                    }
                </div>
            }
            else
            {
                var summary = GetLogDisplaySummary(log);
                <div data-raw class="max-h-48 overflow-y-auto whitespace-pre-wrap break-words rounded-md border border-line bg-canvas px-3 py-2 font-mono text-13 leading-[1.7]">@(string.IsNullOrWhiteSpace(summary) ? L.Translate("audit.noChanges") : summary)@if (payload?.Metadata is { Count: > 0 } meta)
                    {
                        <br /><span class="text-muted">@string.Join(" · ", meta.Select(m => $"{m.Key}: {m.Value}"))</span>
                    }</div>
            }
        </div>
    };
}
