<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand Colors -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryLight">#818CF8</Color>
    <Color x:Key="PrimaryDark">#3730A3</Color>
    <Color x:Key="Accent">#7C3AED</Color>
    <Color x:Key="AccentLight">#A78BFA</Color>

    <!-- Semantic Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessLight">#D1FAE5</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningLight">#FEF3C7</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerLight">#FEE2E2</Color>
    <Color x:Key="Info">#3B82F6</Color>
    <Color x:Key="InfoLight">#DBEAFE</Color>

    <!-- Status Colors -->
    <Color x:Key="StatusNew">#8B5CF6</Color>
    <Color x:Key="StatusOpen">#3B82F6</Color>
    <Color x:Key="StatusInProgress">#F59E0B</Color>
    <Color x:Key="StatusTesting">#06B6D4</Color>
    <Color x:Key="StatusCodeReview">#6366F1</Color>
    <Color x:Key="StatusResolved">#10B981</Color>
    <Color x:Key="StatusDone">#059669</Color>
    <Color x:Key="StatusClosed">#6B7280</Color>

    <!-- Priority Colors -->
    <Color x:Key="PriorityCritical">#EF4444</Color>
    <Color x:Key="PriorityHigh">#F97316</Color>
    <Color x:Key="PriorityMedium">#EAB308</Color>
    <Color x:Key="PriorityLow">#22C55E</Color>

    <!-- Light Theme Surface Colors -->
    <Color x:Key="PageBackgroundLight">#F3F4F6</Color>
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CardBorderLight">#E5E7EB</Color>
    <Color x:Key="TextPrimaryLight">#111827</Color>
    <Color x:Key="TextSecondaryLight">#6B7280</Color>
    <Color x:Key="TextTertiaryLight">#9CA3AF</Color>
    <Color x:Key="SeparatorLight">#E5E7EB</Color>
    <Color x:Key="InputBackgroundLight">#F9FAFB</Color>
    <Color x:Key="InputBorderLight">#D1D5DB</Color>

    <!-- Dark Theme Surface Colors -->
    <Color x:Key="PageBackgroundDark">#111827</Color>
    <Color x:Key="CardBackgroundDark">#1F2937</Color>
    <Color x:Key="CardBorderDark">#374151</Color>
    <Color x:Key="TextPrimaryDark">#F9FAFB</Color>
    <Color x:Key="TextSecondaryDark">#9CA3AF</Color>
    <Color x:Key="TextTertiaryDark">#6B7280</Color>
    <Color x:Key="SeparatorDark">#374151</Color>
    <Color x:Key="InputBackgroundDark">#1F2937</Color>
    <Color x:Key="InputBorderDark">#4B5563</Color>

    <!-- Standard Colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- Grays -->
    <Color x:Key="Gray50">#F9FAFB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>

</ResourceDictionary>