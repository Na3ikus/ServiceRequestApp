@inherits BaseComponent

<div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-6">
    <section aria-labelledby="smtp-connection-heading">
        <h2 id="smtp-connection-heading" class="mb-3 font-mono text-13 text-muted"># @Heading("admin.smtp.connection")</h2>
        <div data-smtp-log role="log" aria-live="polite"
             class="rounded-lg border border-line bg-surface px-3.5 py-3 font-mono text-13 leading-[1.7] break-words">
            @foreach (var entry in Log)
            {
                <div data-log-line="cmd"><span class="text-muted">$</span> @entry.Command</div>
                @if (entry.IsSuccess is null)
                {
                    <div data-log-line="pending" class="text-muted">…</div>
                }
                else if (entry.IsSuccess == true)
                {
                    <div data-log-line="ok"><span class="mark">ok:</span> <span class="text-fg">@entry.Message</span></div>
                }
                else
                {
                    <div data-log-line="err" class="text-danger">err: @entry.Message</div>
                }
            }
            <div aria-hidden="true"><span class="text-muted">$</span> <span class="cursor-blink inline-block w-2 bg-accent text-transparent">_</span></div>
        </div>
        <div class="mt-3 flex gap-2">
            <button type="button" data-action="check" class="btn-outline" disabled="@IsChecking" @onclick="OnCheck">
                @(IsChecking ? Heading("admin.smtp.checking") : Heading("admin.smtp.checkConn"))
            </button>
        </div>
    </section>

    <section aria-labelledby="smtp-test-heading">
        <h2 id="smtp-test-heading" class="mb-3 font-mono text-13 text-muted"># @Heading("admin.smtp.testEmail")</h2>
        <form novalidate class="grid gap-3" @onsubmit="SendAsync" @onsubmit:preventDefault="true">
            <div>
                <label for="smtp-to" class="mb-1 block text-13 text-muted">@L.Translate("admin.smtp.recipientEmail")</label>
                <input id="smtp-to" type="email" class="input-field h-8 px-2.5 text-14" @bind="recipient" @bind:event="oninput" />
            </div>
            <div>
                <label for="smtp-subject" class="mb-1 block text-13 text-muted">@L.Translate("admin.smtp.subject")</label>
                <input id="smtp-subject" type="text" class="input-field h-8 px-2.5 text-14" @bind="subject" @bind:event="oninput" />
            </div>
            <div class="flex justify-end">
                <button type="submit" data-action="send" class="btn-accent h-8 px-3 text-13" disabled="@IsSending">
                    @(IsSending ? Heading("admin.smtp.sending") : Heading("admin.smtp.send"))
                </button>
            </div>
        </form>
    </section>
</div>
