@inherits BaseComponent

<div class="atab-card">
    <!-- Toolbar -->
    <div class="atab-toolbar">
        <div class="atab-toolbar-left">
            <h2 class="atab-title">@L.Translate("admin.techStacks")</h2>
            @if (FilteredStacks is not null)
            {
                <span class="atab-count-badge">@FilteredStacks.Count</span>
            }
        </div>
        <div class="atab-toolbar-right">
            <div class="atab-search-wrap">
                <svg class="atab-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
                </svg>
                <input type="search"
                       class="atab-search-input"
                       placeholder="@(L.Translate("search.label"))..."
                       @bind="searchQuery"
                       @bind:event="oninput" />
            </div>
            <button @onclick="ShowAddTechStack" class="atab-add-btn">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                @L.Translate("admin.addTechStack")
            </button>
        </div>
    </div>

    @if (TechStacks is null)
    {
        <div class="atab-loading">
            <svg class="atab-spinner" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>@L.Translate("common.loading")</span>
        </div>
    }
    else if (FilteredStacks is not null && FilteredStacks.Count == 0)
    {
        <div class="atab-empty">
            <div class="atab-empty-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
            </div>
            <p class="atab-empty-title">@(string.IsNullOrWhiteSpace(searchQuery) ? L.Translate("admin.noTechStacks") : L.Translate("admin.noSearchResults"))</p>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <button class="atab-empty-clear" @onclick="@(() => searchQuery = string.Empty)">
                    @L.Translate("admin.clearSearch")
                </button>
            }
        </div>
    }
    else
    {
        <div class="atab-table-wrap">
            <table class="atab-table">
                <thead>
                    <tr>
                        <th class="atab-th sortable @(sortColumn == "name" ? "sort-active" : "")"
                            @onclick="@(() => SetSort("name"))">
                            @L.Translate("admin.name")
                            <span class="sort-arrow">@GetSortArrow("name")</span>
                        </th>
                        <th class="atab-th sortable @(sortColumn == "type" ? "sort-active" : "")"
                            @onclick="@(() => SetSort("type"))">
                            @L.Translate("admin.type")
                            <span class="sort-arrow">@GetSortArrow("type")</span>
                        </th>
                        <th class="atab-th sortable @(sortColumn == "count" ? "sort-active" : "")"
                            @onclick="@(() => SetSort("count"))">
                            @L.Translate("admin.productsCount")
                            <span class="sort-arrow">@GetSortArrow("count")</span>
                        </th>
                        <th class="atab-th atab-th-actions">@L.Translate("admin.actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ts in FilteredStacks!)
                    {
                        var count = ts.Products?.Count ?? 0;
                        var maxCount = TechStacks!.Max(t => t.Products?.Count ?? 0);

                        <tr class="atab-row">
                            <td class="atab-td atab-td-primary">@ts.Name</td>
                            <td class="atab-td">
                                <span class="atab-type-badge @GetTypeColorClass(ts.Type)">
                                    @ts.Type
                                </span>
                            </td>
                            <td class="atab-td">
                                <div class="atab-progress-cell">
                                    <span class="atab-progress-count">@count</span>
                                    @if (maxCount > 0)
                                    {
                                        <div class="atab-progress-bar-wrap">
                                            <div class="atab-progress-bar"
                                                 style="width: @(count == 0 ? 0 : Math.Max(8, count * 100 / maxCount))%">
                                            </div>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="atab-td atab-td-actions">
                                <button @onclick="@(() => EditTechStack(ts))"
                                        class="atab-action-btn edit"
                                        title="@L.Translate("common.edit")">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </button>
                                <button @onclick="@(() => DeleteTechStack(ts))"
                                        class="atab-action-btn delete @(count > 0 ? "disabled" : "")"
                                        disabled="@(count > 0)"
                                        title="@(count > 0 ? L.Translate("admin.cannotDeleteTechStackWithProducts") : L.Translate("common.delete"))">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="atab-footer">
            <span class="atab-footer-info">
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    @($"{FilteredStacks!.Count} / {TechStacks?.Count ?? 0}")
                }
                else
                {
                    @($"{TechStacks?.Count ?? 0}")
                }
            </span>
        </div>
    }
</div>

<!-- Modal -->
@if (showModal)
{
    <div class="amodal-overlay" @onclick="CloseModal">
        <div class="amodal-box animate-fade-in" @onclick:stopPropagation>
            <button @onclick="CloseModal" class="amodal-close" aria-label="@L.Translate("common.close")">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="amodal-header">
                <div class="amodal-header-icon purple">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                </div>
                <div>
                    <h3 class="amodal-title">@modalTitle</h3>
                    <p class="amodal-subtitle">@L.Translate("admin.techStacks")</p>
                </div>
            </div>

            <div class="amodal-body">
                <div class="amodal-field">
                    <label class="amodal-label">@L.Translate("admin.name")</label>
                    <input type="text" @bind="editingTechStack.Name" class="amodal-input"
                           placeholder="@L.Translate("admin.techStackNamePlaceholder")" />
                </div>
                <div class="amodal-field">
                    <label class="amodal-label">@L.Translate("admin.type")</label>
                    <input type="text" @bind="editingTechStack.Type" class="amodal-input"
                           placeholder="@L.Translate("admin.techStackTypePlaceholder")" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="amodal-error">@errorMessage</div>
                }
            </div>

            <div class="amodal-footer">
                <button @onclick="CloseModal" class="amodal-btn-cancel">
                    @L.Translate("common.cancel")
                </button>
                <button @onclick="SaveModal" disabled="@isSaving" class="amodal-btn-save">
                    @if (isSaving)
                    {
                        <svg class="amodal-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                        <span>@L.Translate("common.saving")</span>
                    }
                    else
                    {
                        <span>@L.Translate("common.save")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
