@inherits BaseComponent

<div data-admin-toolbar class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <input type="search" data-search
           class="input-field h-8 w-full px-2.5 text-14 sm:w-56"
           placeholder="@($"{Heading("search.label")}…")"
           aria-label="@L.Translate("search.label")"
           value="@Value"
           @oninput="OnInputAsync" />
    @if (Actions is not null)
    {
        <div class="flex flex-wrap items-center gap-2">@Actions</div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the search text.
    /// </summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the callback run on every keystroke in the search input.
    /// </summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the content on the right (buttons, notes).
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
