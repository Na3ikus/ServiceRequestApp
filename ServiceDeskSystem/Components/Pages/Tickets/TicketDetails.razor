@page "/ticket/{Id:int}"
@using ServiceDeskSystem.Domain.Enums
@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-6xl mx-auto p-4 sm:p-6">
    @if (!IsLoaded)
    {
        <PageHeader Segments="Segments" />
        <div class="space-y-3" aria-busy="true">
            <div class="h-5 w-48 rounded-md bg-surface"></div>
            <div class="h-8 w-2/3 rounded-md bg-surface"></div>
            <div class="grid gap-10 pt-4 lg:grid-cols-[minmax(0,1fr)_300px]">
                <div class="space-y-3">
                    <div class="h-24 rounded-md bg-surface"></div>
                    <div class="h-16 rounded-md bg-surface"></div>
                    <div class="h-16 rounded-md bg-surface"></div>
                </div>
                <div class="h-80 rounded-lg bg-surface"></div>
            </div>
        </div>
    }
    else if (Ticket is null)
    {
        <PageHeader Segments="Segments" />
        <EmptyState Message="@string.Format(UiCulture, L.Translate("details.notFound"), Id)"
                    ActionText="@Heading(ListTitleKey)" OnAction="GoToList" />
    }
    else
    {
        <PageHeader Segments="Segments">
            <Actions>
                <TicketStatusActions Status="Ticket.Status"
                                     CanManageStatus="CanManageTicketStatus"
                                     ShowTake="ShowTakeButton"
                                     ShowRelease="ShowReleaseButton"
                                     CanDelete="CanManageTicket"
                                     Busy="IsBusy"
                                     OnTransition="UpdateStatusAsync"
                                     OnTake="AssignToMeAsync"
                                     OnRelease="UnassignAsync"
                                     OnDelete="OpenDeleteConfirm" />
            </Actions>
        </PageHeader>

        <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class="font-mono text-13 text-muted">#@Ticket.Id</span>
            <TypeTag Type="Ticket.Type" />
            <StatusTag Status="Ticket.Status" />
            <PriorityTag Priority="Ticket.Priority" />
        </div>
        <h2 data-ticket-title class="mb-5 break-words text-24 font-semibold leading-tight text-fg">@Ticket.Title</h2>

        @if (!Ticket.IsPriorityAssessed && IsAdminOrDeveloper)
        {
            <div data-triage-notice class="mb-6 border-l-2 border-accent bg-surface px-4 py-3">
                <p class="text-15 text-fg">@L.Translate("tickets.triageBannerTitle")</p>
                <p class="mt-0.5 text-13 text-muted">@L.Translate("tickets.triageBannerDesc")</p>
            </div>
        }

        <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-10">
            <div class="lg:col-start-2 lg:row-start-1">
                <TicketPropertiesPanel Ticket="Ticket"
                                       CanEdit="IsAdminOrDeveloper"
                                       AllTags="AllTags"
                                       OnSavePriority="SavePriorityAsync"
                                       OnSaveDates="SaveDatesAsync"
                                       OnAddTag="AssignTagToTicketAsync"
                                       OnRemoveTag="RemoveTagFromTicketAsync" />
            </div>

            <div class="min-w-0 lg:col-start-1 lg:row-start-1">
                <section data-section="description" class="pb-6">
                    <h2 class="mb-3 font-mono text-13 text-muted"># @Heading("details.description")</h2>
                    <div class="ql-editor px-0 py-0 text-15 leading-relaxed text-fg">@QuillSanitizer.Sanitize(Ticket.Description)</div>
                </section>

                @if (!string.IsNullOrWhiteSpace(Ticket.StepsToReproduce))
                {
                    <section data-section="steps" class="border-t border-line py-6">
                        <h2 class="mb-3 font-mono text-13 text-muted"># @Heading("details.stepsToReproduce")</h2>
                        <div class="ql-editor px-0 py-0 text-15 leading-relaxed text-fg">@QuillSanitizer.Sanitize(Ticket.StepsToReproduce)</div>
                    </section>
                }

                @if (IsAdminOrDeveloper)
                {
                    <section data-section="analytical-note" class="border-t border-line py-6">
                        <div class="mb-3 flex items-baseline justify-between gap-4">
                            <h2 class="font-mono text-13 text-muted"># @Heading("details.analyticalNote")</h2>
                            @if (!IsEditingAnalyticalNote)
                            {
                                <button type="button" data-edit-note class="btn-ghost font-mono text-13" @onclick="BeginEditAnalyticalNote">@Heading("common.edit")</button>
                            }
                        </div>

                        @if (IsEditingAnalyticalNote)
                        {
                            <textarea @bind="AnalyticalNoteEdit" rows="4" aria-label="@L.Translate("details.analyticalNote")"
                                      placeholder="@L.Translate("details.analyticalNotePlaceholder")"
                                      class="input-field h-auto resize-y py-2"></textarea>
                            <div class="mt-2 flex justify-end gap-2">
                                <button type="button" class="btn-ghost h-9 px-3 text-15" @onclick="CancelEditAnalyticalNote">@Heading("common.cancel")</button>
                                <button type="button" data-save-note class="btn-accent" disabled="@IsSavingAnalyticalNote" @onclick="SaveAnalyticalNoteAsync">
                                    @Heading(IsSavingAnalyticalNote ? "common.saving" : "common.save")
                                </button>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(Ticket.AnalyticalNote))
                        {
                            <p class="whitespace-pre-wrap rounded-lg border border-line bg-surface px-3.5 py-3 text-14 text-fg">@Ticket.AnalyticalNote</p>
                        }
                        else
                        {
                            <p class="font-mono text-13 text-muted">&gt; @L.Translate("details.noAnalyticalNote")</p>
                        }
                    </section>

                    <WorkLogsSection TicketId="Ticket.Id" IsAdmin="IsAdmin" CurrentUserId="CurrentUserId" />
                }

                <AttachmentsSection TicketId="Ticket.Id" CanDeleteAny="IsAdminOrDeveloper" CurrentUserId="CurrentUserId" />

                <section data-section="activity" class="border-t border-line py-6">
                    <h2 class="mb-3 font-mono text-13 text-muted"># @Heading("details.activity")</h2>
                    <TicketActivity Ticket="Ticket"
                                    History="History"
                                    IsStaff="IsAdminOrDeveloper"
                                    IsAdmin="IsAdmin"
                                    CurrentUserId="CurrentUserId"
                                    OnAddComment="AddCommentAsync"
                                    OnEditComment="SaveCommentEditAsync"
                                    OnDeleteComment="DeleteCommentAsync" />
                </section>
            </div>
        </div>

        <Modal IsOpen="IsDeleteConfirmOpen"
               Title="@string.Format(UiCulture, L.Translate("details.deleteTitle"), Ticket.Id)"
               Danger="true"
               IsSaving="IsDeleting"
               ErrorMessage="@DeleteError"
               CancelText="@L.Translate("common.cancel")"
               SaveText="@L.Translate("details.deleteTicket")"
               SavingText="@L.Translate("details.deleting")"
               OnClose="CloseDeleteConfirm"
               OnSave="DeleteTicketAsync">
            <p class="text-15 text-fg">@L.Translate("details.deleteText")</p>
        </Modal>
    }
</div>
