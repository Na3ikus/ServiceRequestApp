@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@WrapperClass">
    <div id="@elementId" class="min-h-[120px] text-fg"></div>
</div>

@code {
    private string elementId = "quill_" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<RichTextEditor>? dotNetRef;
    private bool isInitialized;
    private string? lastSetValue;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets a value indicating whether the editor drops its own border (it sits inside a framed box).
    /// </summary>
    [Parameter]
    public bool Borderless { get; set; }

    private string WrapperClass => Borderless
        ? "quill-wrapper overflow-hidden"
        : "quill-wrapper overflow-hidden rounded-md border border-line transition-colors focus-within:border-fg";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            lastSetValue = Value;
            await JS.InvokeVoidAsync("window.quillInterop.init", elementId, dotNetRef, Value, Placeholder);
            isInitialized = true;
        }
        else if (isInitialized && Value != lastSetValue)
        {
            lastSetValue = Value;
            await JS.InvokeVoidAsync("window.quillInterop.setContent", elementId, Value);
        }
    }

    [JSInvokable]
    public async Task UpdateContent(string content)
    {
        if (content == "<p><br></p>")
        {
            content = string.Empty;
        }
        
        lastSetValue = content;
        await ValueChanged.InvokeAsync(content);
    }

    public async ValueTask DisposeAsync()
    {
        if (isInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("window.quillInterop.dispose", elementId);
            }
            catch
            {
                // Ignore JS errors on disposal
            }
        }
        dotNetRef?.Dispose();
    }
}
