                                var c = colorInfo.Key;
                                var label = colorInfo.Value;
                                <div class="accent-swatch-wrapper @(accentColor == c ? "is-active" : "")"
                                     @onclick="() => SetAccentColor(c)">
                                    <button class="accent-swatch @(accentColor == c ? "is-active" : "")"
                                            style="@GetAccentSwatchStyle(c)"
                                            title="@c">
                                        @if (accentColor == c)
                                        {
                                            <span class="accent-swatch-check">✓</span>
                                        }
                                    </button>
                                    <span class="accent-swatch-label">@label</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Live preview panel -->
                    <div class="settings-live-preview">
                        <span class="settings-live-preview-label">Preview</span>
                        <div class="settings-preview-card">
                            <div class="settings-preview-dot" style="background: @GetAccentPreviewColor(accentColor);"></div>
                            <span class="settings-preview-text" style="font-size: @GetFontSizePx(fontSize);">
                                @L.Translate("settings.previewText")
                            </span>
                            <span class="settings-preview-btn" style="background: @GetAccentPreviewColor(accentColor);">
                                @L.Translate("settings.previewBtn")
                            </span>
                        </div>
                        <div class="settings-preview-card">
                            <div class="settings-preview-dot" style="background: #10b981;"></div>
                            <span class="settings-preview-text" style="font-size: @GetFontSizePx(fontSize);">
                                @FormatPreviewDate()
                            </span>
                            <span class="text-xs text-gray-400 dark:text-gray-500 ml-auto font-mono">@dateFormat</span>
                        </div>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Custom HEX Accent -->
                <div class="flex flex-col gap-3">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.customAccent")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.customAccentDesc")</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="relative flex-1 max-w-[14rem]">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-mono text-sm">#</span>
                            <input type="text"
                                   maxlength="7"
                                   placeholder="3b82f6"
                                   @bind="customAccentHexInput"
                                   @bind:event="oninput"
                                   class="w-full pl-7 pr-3 py-2 rounded-xl ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                        </div>
                        @if (!string.IsNullOrEmpty(customAccentHexInput))
                        {
                            <div class="w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-600 flex-shrink-0 transition-all"
                                 style="background: @(customAccentHexInput.StartsWith('#') ? customAccentHexInput : '#' + customAccentHexInput);"></div>
                        }
                        <button @onclick="ApplyCustomAccentAsync"
                                class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-all shadow-md shadow-blue-500/20 whitespace-nowrap">
                            @L.Translate("settings.customAccentApply")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(customAccentError))
                    {
                        <p class="text-xs text-red-500 dark:text-red-400">@customAccentError</p>
                    }
                    @if (!string.IsNullOrEmpty(customAccentHex) && accentColor == "custom")
                    {
                        <p class="text-xs text-green-600 dark:text-green-400">✓ Custom color active: @customAccentHex</p>
                    }
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Hover Effect -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.hoverStyle")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.hoverStyleDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <button @onclick='() => SetHoverStyle("standard")'
                                class="@(hoverStyle == "standard" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.hoverStandard")
                        </button>
                        <button @onclick='() => SetHoverStyle("border")'
                                class="@(hoverStyle == "border" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.hoverBorder")
                        </button>
                        <button @onclick='() => SetHoverStyle("elevated")'
                                class="@(hoverStyle == "elevated" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.hoverElevated")
                        </button>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Font Family -->
