@inject ILocalizationService L

<!-- Created by Nazar "N1h3" Hutsol -->
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="RecoverOnNavigate">
    <Found Context="routeData">
        <ErrorBoundary @ref="errorBoundary">
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="ex">
                <StatusScreen Code="error" Message="@L.Translate("errors.unexpected")">
                    <button type="button" data-status-reload class="text-fg hover:underline" onclick="window.location.reload()"><span aria-hidden="true" class="text-accent-ink">$ </span>reload</button>
                </StatusScreen>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
</Router>

@code {
    private ErrorBoundary? errorBoundary;

    // Without this one error keeps "Something went wrong" on every page until a reload.
    private void RecoverOnNavigate(NavigationContext context) => errorBoundary?.Recover();
}
