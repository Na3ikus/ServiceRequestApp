@page "/developer"
@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-7xl mx-auto p-4 sm:p-6">
    @if (!IsDeveloper)
    {
        <div role="alert" class="rounded-md border border-danger px-3 py-2 text-13 text-danger">@L.Translate("developer.accessDenied")</div>
    }
    else
    {
        <PageHeader Segments="Segments" Subtitle="@L.Translate("developer.subtitle")">
            <Actions>
                <SegmentedControl Label="@L.Translate("settings.defaultView")" Options="ViewOptions"
                                  Value="@viewMode" ValueChanged="SetViewMode" />
                <a href="create-ticket" class="btn-accent inline-flex items-center">@Heading("nav.newTicket")</a>
            </Actions>
        </PageHeader>

        <h2 class="mt-2 mb-2 font-mono text-13 text-muted"># @Heading("home.overview")</h2>
        <div class="mb-8 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-3">
            <StatFigure Label="@Heading("developer.assignedTickets")" Value="assignedCount" />
            <StatFigure Label="@Heading("developer.inProgress")" Value="inProgressCount" Total="assignedCount" />
            <StatFigure Label="@Heading("developer.completed")" Value="completedCount" Total="assignedCount" />
        </div>

        @if (tickets is null)
        {
            <div class="space-y-2" aria-busy="true">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="h-11 rounded-md bg-surface"></div>
                }
            </div>
        }
        else if (tickets.Count == 0)
        {
            <EmptyState Message="@L.Translate("developer.noTickets")" ActionText="@Heading("developer.browseTickets")"
                        OnAction="@(() => Navigation.NavigateTo("/tickets"))" />
        }
        else
        {
            var shown = TicketFilter.Apply(tickets, filter);
            <TicketFilters Value="filter" ValueChanged="f => filter = f" Shown="shown.Count" Total="tickets.Count" />

            @if (shown.Count == 0)
            {
                <EmptyState Message="@L.Translate("tickets.nothingFound")" ActionText="@Heading("search.clearFilters")"
                            OnAction="@(() => filter = new TicketFilterState())" />
            }
            else if (viewMode == KanbanView)
            {
                <KanbanBoard Tickets="shown" CurrentUserId="CurrentUserId" IsAdmin="IsAdmin"
                             OnStatusChanged="HandleKanbanStatusChangedAsync" />
            }
            else
            {
                <TicketTable Tickets="shown" OnTicketClick="ViewTicket" ShowAssignee="false" />
            }
        }
    }
</div>
