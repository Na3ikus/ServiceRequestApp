@inherits LayoutComponentBase

<!-- Created by Nazar "N1h3" Hutsol -->
@* The dark class lives on <html> only (prefs.js), so the palette's live preview recolors everything. *@
<div>
    @if (!authRestored)
    {
        <div class="relative z-10 flex h-screen supports-[height:100dvh]:h-dvh items-center justify-center bg-canvas">
            <div class="font-mono text-13 text-muted">@L.Translate("common.loading").ToLower(System.Globalization.CultureInfo.CurrentCulture)</div>
        </div>
    }
    else if (!AuthService.IsAuthenticated)
    {
        @Body
        <RedirectToLogin />
    }
    else
    {
        <div class="relative z-10 flex h-screen supports-[height:100dvh]:h-dvh overflow-hidden bg-canvas pb-[env(safe-area-inset-bottom)]">
            @if (isSidebarOpen)
            {
                <div class="fixed inset-0 z-40 bg-canvas/80 lg:hidden"
                     @onclick="CloseSidebar"></div>
            }

            <aside class="fixed inset-y-0 left-0 z-50 w-64 flex-shrink-0 transform transition-transform duration-200 ease-out lg:static lg:translate-x-0 @(isSidebarOpen ? "translate-x-0" : "-translate-x-full")">
                <NavMenu />
            </aside>

            <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
                <TopProgressBar />
                <header class="sticky top-0 z-30 flex h-12 flex-shrink-0 items-center justify-between gap-4 border-b border-line bg-canvas px-4 lg:px-6">
                    <div class="flex min-w-0 items-center gap-2">
                        <button type="button"
                                @onclick="ToggleSidebar"
                                class="btn-ghost inline-flex items-center justify-center lg:hidden"
                                aria-label="@L.Translate("nav.openMenu")"
                                aria-expanded="@(isSidebarOpen ? "true" : "false")">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                            </svg>
                        </button>
                        <RoutePath />
                    </div>

                    <div class="flex flex-shrink-0 items-center gap-2">
                        <LanguageDropdown />

                        <button type="button"
                                @onclick="Theme.ToggleTheme"
                                class="btn-ghost inline-flex items-center justify-center"
                                aria-label="@L.Translate("theme.toggle")">
                            @if (Theme.IsDarkMode)
                            {
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                </svg>
                            }
                            else
                            {
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                                </svg>
                            }
                        </button>

                        <div class="notification-wrapper relative">
                            <button type="button"
                                    @onclick="ToggleNotificationsAsync"
                                    class="btn-ghost relative inline-flex items-center justify-center"
                                    aria-label="@L.Translate("notifications.title")"
                                    aria-haspopup="true"
                                    aria-expanded="@(IsNotificationsOpen ? "true" : "false")">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                                </svg>
                                @if (UnreadNotificationsCount > 0)
                                {
                                    <span class="absolute -right-1.5 -top-1.5 rounded bg-accent px-1 font-mono text-12 leading-4 text-on-accent">@UnreadNotificationsCount</span>
                                }
                            </button>

                            @if (IsNotificationsOpen)
                            {
                                <div class="absolute right-0 z-50 mt-1 w-[360px] max-w-[calc(100vw-1.5rem)] overflow-hidden rounded-lg border border-line bg-surface">
                                    <div class="flex items-center justify-between gap-2 border-b border-line px-3 py-2">
                                        <span class="font-mono text-13 text-muted">
                                            # notifications
                                            @if (UnreadNotificationsCount > 0)
                                            {
                                                <span class="text-fg">@UnreadNotificationsCount</span>
                                            }
                                        </span>
                                        @if (UnreadNotificationsCount > 0)
                                        {
                                            <button type="button"
                                                    class="text-13 text-muted hover:text-fg"
                                                    @onclick="MarkNotificationsAsReadAsync">
                                                @L.Translate("notifications.markAllRead")
                                            </button>
                                        }
                                    </div>

                                    <div class="max-h-[28rem] overflow-y-auto">
                                        @if (!Notifications.Any())
                                        {
                                            <EmptyState Message="@L.Translate("notifications.empty")" />
                                        }
                                        else
                                        {
                                            @foreach (var item in Notifications)
                                            {
                                                <div class="flex items-start gap-2 border-b border-dashed border-line px-3 py-2 last:border-b-0">
                                                    <span aria-hidden="true" class="mt-[0.4375rem] h-1.5 w-1.5 flex-shrink-0 rounded-full @(item.IsRead ? string.Empty : "bg-accent")"></span>
                                                    <button type="button"
                                                            class="min-w-0 flex-1 text-left"
                                                            @onclick="() => OpenNotificationAsync(item)">
                                                        <span class="flex items-center justify-between gap-2 font-mono text-13 text-muted">
                                                            <span>#@item.TicketId</span>
                                                            <span class="whitespace-nowrap">@FormatNotificationTime(item.CreatedAt)</span>
                                                        </span>
                                                        <span class="block break-words text-13 text-fg">@item.Message</span>
                                                    </button>
                                                    <button type="button"
                                                            class="flex-shrink-0 px-1 font-mono text-13 text-muted hover:text-danger"
                                                            aria-label="@L.Translate("notifications.delete")"
                                                            @onclick="() => DeleteNotificationAsync(item.Id)">
                                                        ×
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <details class="header-dropdown relative">
                            <summary class="header-dropdown-summary flex items-center gap-2 rounded-md px-1 hover:bg-surface"
                                     aria-label="@AuthService.CurrentUser?.Login">
                                <Avatar Name="@DisplayName" Size="AvatarSize.Md" />
                                <span class="hidden text-13 text-fg sm:inline">
                                    @DisplayName
                                </span>
                            </summary>

                            <div class="header-dropdown-menu absolute right-0 z-50 mt-1 w-48 rounded-lg border border-line bg-surface p-1">
                                <NavLink href="profile"
                                         class="flex h-8 w-full items-center rounded-md px-2 text-13 text-fg hover:bg-canvas">
                                    @L.Translate("profile.title")
                                </NavLink>
                                <button type="button"
                                        @onclick="HandleLogout"
                                        class="flex h-8 w-full items-center rounded-md px-2 text-left text-13 text-fg hover:bg-canvas hover:text-danger">
                                    @L.Translate("common.logout")
                                </button>
                            </div>
                        </details>
                    </div>
                </header>

                <main class="main-content-area flex-1 overflow-y-auto bg-canvas">
                    @Body
                </main>
            </div>
        </div>
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<ToastContainer Toasts="ToastService.Toasts" OnRemoveToast="ToastService.RemoveToastAsync" />

<ServiceDeskSystem.Components.Shared.HotkeysModal @ref="hotkeysModal" />

<CommandPalette />
