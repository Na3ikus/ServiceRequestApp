@using ServiceDeskSystem.Domain.Entities
@using ServiceDeskSystem.Domain.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="kanban-card @(CanDrag ? "cursor-grab active:cursor-grabbing" : "cursor-pointer") 
     rounded-xl shadow-xs border p-3.5 transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 flex flex-col justify-between
     @(!Ticket.IsPriorityAssessed && IsAdminOrDeveloper
         ? "border-dashed border-amber-400/80 dark:border-amber-500/50 bg-amber-50/20 dark:bg-amber-950/15 hover:border-amber-500" 
         : "bg-white dark:bg-gray-800 border-gray-200/80 dark:border-gray-700/60 hover:border-blue-400/60 dark:hover:border-blue-500/50")"
@ref="cardElement" draggable="@(CanDrag ? "true" : "false")" @onclick="HandleClick">

    <div>
        <!-- Header: ID + Type + Unassessed + Priority -->
        <div class="flex items-center justify-between gap-1.5 mb-2.5">
            <div class="flex items-center gap-1.5 flex-wrap min-w-0">
                <span class="text-xs font-mono font-bold text-gray-400 dark:text-gray-500 flex-shrink-0">#@Ticket.Id</span>
                
                <!-- Ticket Type Badge -->
                <span class="@GetTicketTypeBadgeClass(Ticket.Type) px-1.5 py-0.5 rounded text-[10px] font-bold flex-shrink-0">
                    @GetTicketTypeText(Ticket.Type)
                </span>

                @if (!Ticket.IsPriorityAssessed && IsAdminOrDeveloper)
                {
                    <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300 text-[10px] font-bold border border-amber-200 dark:border-amber-800/60 shrink-0">
                        ⚠️ @L.Translate("tickets.triageCompact")
                    </span>
                }
            </div>

            <span class="@GetPriorityBadgeClass(Ticket.Priority) px-2 py-0.5 rounded text-xs font-semibold flex-shrink-0">
                @GetPriorityText(Ticket.Priority)
            </span>
        </div>

        <!-- Title -->
        <p class="text-sm font-semibold text-gray-800 dark:text-white line-clamp-2 leading-snug mb-2.5">
            @Ticket.Title
        </p>

        <!-- Tags (if any) -->
        @if (Ticket.Tags is { Count: > 0 })
        {
            <div class="flex flex-wrap gap-1 mb-2.5">
                @foreach (var tag in Ticket.Tags.Take(3))
                {
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold"
                          style="background-color: @(tag.Color)18; color: @tag.Color; border: 1px solid @(tag.Color)35;">
                        #@tag.Name
                    </span>
                }
                @if (Ticket.Tags.Count > 3)
                {
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                        +@(Ticket.Tags.Count - 3)
                    </span>
                }
            </div>
        }
    </div>

    <!-- Footer: Author + Assignee -->
    <div class="flex items-center justify-between gap-2 pt-2 border-t border-gray-100 dark:border-gray-700/40 mt-1">
        <!-- Author avatar -->
        <div class="flex items-center gap-1.5 min-w-0">
            <div class="w-5 h-5 rounded-full bg-gradient-to-br from-gray-400 to-gray-600 flex items-center justify-center flex-shrink-0">
                <span class="text-white text-[9px] font-bold">@(Ticket.Author?.Login?.Length > 0 ? Ticket.Author.Login.Substring(0, 1).ToUpper() : "?")</span>
            </div>
            <span class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-[80px]">@Ticket.Author?.Login</span>
        </div>

        <!-- Assignee or unassigned -->
        @if (Ticket.Developer is not null)
        {
            <div class="flex items-center gap-1 min-w-0">
                <div class="w-5 h-5 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center flex-shrink-0">
                    <span class="text-white text-[9px] font-bold">@(Ticket.Developer.Login?.Length > 0 ? Ticket.Developer.Login.Substring(0, 1).ToUpper() : "?")</span>
                </div>
                <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 truncate max-w-[80px]">@Ticket.Developer.Login</span>
            </div>
        }
        else
        {
            <span class="text-xs text-gray-400 dark:text-gray-500 italic flex-shrink-0">@L.Translate("table.unassigned")</span>
        }
    </div>
</div>

@code {
    private ElementReference cardElement;
    private TicketStatus? _lastInitializedStatus = null;
    private bool _lastCanDrag = false;

    [Parameter, EditorRequired]
    public Ticket Ticket { get; set; } = null!;

    [Parameter]
    public bool CanDrag { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-initialize draggable whenever CanDrag is true and the status or drag permission changed.
        // This is critical: after a card moves to a new column Blazor re-renders it with new Ticket.Status,
        // but firstRender is false, so without this check the JS listener would still report the old sourceStatus.
        if (CanDrag && (firstRender || Ticket.Status != _lastInitializedStatus || CanDrag != _lastCanDrag))
        {
            _lastInitializedStatus = Ticket.Status;
            _lastCanDrag = CanDrag;
            await JSRuntime.InvokeVoidAsync("kanban.initDraggable", cardElement, Ticket.Id, Ticket.Status.ToString());
        }
    }

    private void HandleClick() => ViewTicket(Ticket.Id);
}
