@page "/statistics"
@using System.Globalization
@using ServiceDeskSystem.Application.Services.Tickets.Models
@using ServiceDeskSystem.Components.Pages.Admin.Components
@using ServiceDeskSystem.Domain.Enums
@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-7xl mx-auto p-4 sm:p-6">
    @if (HasAccess)
    {
        <PageHeader Segments="Segments" Subtitle="@L.Translate("stats.subtitle")">
            <Actions>
                <SegmentedControl Label="@L.Translate("stats.period")" Options="PeriodOptions" Value="@Days.ToString(CultureInfo.InvariantCulture)"
                                  ValueChanged="SelectPeriodAsync" />
            </Actions>
        </PageHeader>

        <nav data-stats-tabs aria-label="@L.Translate("stats.sections")"
             class="mb-6 flex gap-1 overflow-x-auto overflow-y-hidden border-b border-line font-mono text-14">
            @foreach (var tab in Tabs)
            {
                var active = tab == ActiveTab;
                <button type="button" data-tab="@tab" aria-current="@(active ? "true" : null)"
                        class="relative shrink-0 whitespace-nowrap px-3 py-2 hover:text-fg @(active ? "text-fg" : "text-muted")"
                        @onclick="() => SelectTab(tab)">
                    <span>@tab</span>
                    @if (active)
                    {
                        <span aria-hidden="true" class="absolute inset-x-2 bottom-0 h-0.5 bg-accent"></span>
                    }
                </button>
            }
        </nav>

        @if (Report is not { } report)
        {
            @if (IsLoading)
            {
                <p data-loading class="px-3.5 py-7 font-mono text-13 text-muted">@Heading("common.loading")</p>
            }
            else
            {
                <p data-load-failed class="px-3.5 py-7 font-mono text-13 text-muted">@Heading("stats.loadFailed")</p>
            }
        }
        else
        {
            @* The previous report stays on screen while a new period loads. *@
            <div data-report aria-busy="@(IsLoading ? "true" : "false")">
                @if (ActiveTab == "team")
                {
                    @Team(report)
                }
                else
                {
                    @Overview(report)
                }
            </div>
        }
    }
</div>

@code {
    private RenderFragment Figure(string key, string label, string value, bool danger = false, string? unit = null) => __builder =>
    {
        <div data-figure="@key">
            <p class="font-mono text-24 font-medium leading-tight tabular-nums @(danger ? "text-danger" : "text-fg")">@value@if (unit is not null)
                {
                    <span class="text-15 font-normal text-muted">@unit</span>
                }</p>
            <p class="mt-1 font-mono text-13 text-muted"># @label</p>
        </div>
    };

    private RenderFragment SectionHeading(string text, string? note = null) => __builder =>
    {
        <h2 class="mb-3 font-mono text-13 font-normal text-muted"># @text@if (note is not null)
            {
                <text> · @note</text>
            }</h2>
    };

    private RenderFragment Overview(StatisticsReportDto report) => __builder =>
    {
        var period = report.Period;
        var critical = report.Snapshot.CriticalOpen;
        <div data-figures class="mb-8 flex flex-wrap gap-x-12 gap-y-4">
            @Figure("open", Heading("stats.open"), Number(report.Snapshot.Open))
            @Figure("critical", Heading("stats.criticalOpen"), Number(critical), danger: critical > 0)
            @Figure("created", WithPeriod("stats.created"), Number(period.Created))
            @Figure("resolved", WithPeriod("stats.resolved"), Number(period.Resolved))
            @Figure("resolution", WithPeriod("stats.avgResolution"), FormatDuration(period.AverageResolution))
            @if (period.ResolvedPercent is int percent)
            {
                @Figure("ratio", WithPeriod("stats.resolvedPerCreated"), Number(percent), unit: "%")
            }
            else
            {
                @Figure("ratio", WithPeriod("stats.resolvedPerCreated"), "—")
            }
        </div>

        <section data-section="trend" class="mb-9">
            <div class="flex flex-wrap items-baseline gap-x-3">
                @SectionHeading(WithPeriod("stats.trend"))
                <div aria-hidden="true" class="ml-auto flex gap-4 font-mono text-12 text-muted">
                    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-sm bg-accent/35"></span>@Heading("stats.created")</span>
                    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-sm bg-accent"></span>@Heading("stats.resolved")</span>
                </div>
            </div>
            @Trend(report)
        </section>

        <section data-section="distributions" class="mb-9 grid grid-cols-1 gap-8 lg:grid-cols-3">
            <div data-dist="status">
                @SectionHeading(Heading("stats.byStatus"), Heading("stats.now"))
                @Distribution(StatusOrder.Select(s => new DistributionRow(
                    s.ToString(), GetStatusText(s), report.Snapshot.ByStatus.GetValueOrDefault(s), IsDone(s) ? BarTone.Muted : BarTone.Accent)))
            </div>
            <div>
                <div data-dist="priority">
                    @SectionHeading(Heading("stats.byPriority"), Heading("stats.openOnly"))
                    @Distribution(PriorityOrder.Select(p => new DistributionRow(
                        p.ToString(), GetPriorityText(p), report.Snapshot.ByPriority.GetValueOrDefault(p), p == TicketPriority.Critical ? BarTone.Danger : BarTone.Accent)))
                </div>
                <div data-dist="type" class="mt-6">
                    @SectionHeading(Heading("stats.byType"), Heading("stats.openOnly"))
                    @Distribution(TypeRows(report.Snapshot))
                </div>
            </div>
            <div data-dist="tags">
                @SectionHeading(Heading("stats.tags"), Heading("stats.openOnly"))
                @Distribution(report.Snapshot.Tags.Take(TopTags).Select(t => new DistributionRow(t.TagId.ToString(CultureInfo.InvariantCulture), t.Name, t.Count, BarTone.Accent)))
            </div>
        </section>

        <section data-section="products">
            @SectionHeading(WithPeriod("stats.products"))
            @Products(report)
        </section>
    };

    private RenderFragment Trend(StatisticsReportDto report) => __builder =>
    {
        var max = Math.Max(1, report.Trend.Max(d => Math.Max(d.Created, d.Resolved)));
        <div data-trend role="img" aria-label="@TrendSummary(report)"
             class="flex h-40 items-end border-b border-line @(report.Trend.Count > 30 ? "gap-px" : "gap-[3px]")">
            @foreach (var day in report.Trend)
            {
                <div data-day="@day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" title="@DayTitle(day)" class="group flex h-full flex-1 items-end gap-px">
                    <i data-bar="created" class="block min-h-px flex-1 rounded-t-sm bg-accent/35 group-hover:outline group-hover:outline-1 group-hover:outline-fg/40" style="height: @Percent(day.Created, max)%"></i>
                    <i data-bar="resolved" class="block min-h-px flex-1 rounded-t-sm bg-accent group-hover:outline group-hover:outline-1 group-hover:outline-fg/40" style="height: @Percent(day.Resolved, max)%"></i>
                </div>
            }
        </div>
        <div data-axis aria-hidden="true" class="mt-1.5 flex justify-between font-mono text-12 text-muted">
            @foreach (var label in AxisLabels(report))
            {
                <span>@label</span>
            }
        </div>
    };

    private RenderFragment Distribution(IEnumerable<DistributionRow> source) => __builder =>
    {
        var rows = source.ToList();
        if (rows.Count == 0)
        {
            <p data-no-data class="font-mono text-13 text-muted">@L.Translate("stats.noData")</p>
            return;
        }

        var max = Math.Max(1, rows.Max(r => r.Value));
        <div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1.5 font-mono text-13">
            @foreach (var row in rows)
            {
                <span data-label="@row.Key" class="@LabelClass(row.Tone)">@row.Label</span>
                <span aria-hidden="true" class="h-2 overflow-hidden rounded-sm bg-line">
                    <span data-bar="@row.Key" class="block h-full rounded-sm @BarClass(row.Tone)" style="width: @Percent(row.Value, max)%"></span>
                </span>
                <span data-value="@row.Key" class="text-right tabular-nums @(row.Tone == BarTone.Muted ? "text-muted" : null)">@Number(row.Value)@if (row.Share is int share)
                    {
                        <span class="ml-1.5 text-muted">@share%</span>
                    }</span>
            }
        </div>
    };

    private RenderFragment Products(StatisticsReportDto report) => __builder =>
    {
        if (report.Products.Count == 0)
        {
            <p data-no-data class="font-mono text-13 text-muted">@L.Translate("stats.noData")</p>
            return;
        }

        var slowest = report.Products.Max(p => p.AverageResolution ?? TimeSpan.Zero);
        <div class="overflow-x-auto">
            <table data-table="products" class="w-full min-w-[640px] border-collapse text-left text-14">
                <thead>
                    <tr class="border-b border-line font-mono text-13 text-muted">
                        <SortHeader Text="@Heading("stats.product")" Column="name" Sort="productSort" OnSort="SortProducts" />
                        <SortHeader Text="@Heading("stats.open")" Column="open" Sort="productSort" OnSort="SortProducts" Class="w-28 text-right" />
                        <SortHeader Text="@Heading("stats.created")" Column="created" Sort="productSort" OnSort="SortProducts" Class="w-28 text-right" />
                        <SortHeader Text="@Heading("stats.resolved")" Column="resolved" Sort="productSort" OnSort="SortProducts" Class="w-28 text-right" />
                        <SortHeader Text="@Heading("stats.avgResolution")" Column="avg" Sort="productSort" OnSort="SortProducts" Class="w-64" />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in SortedProducts(report))
                    {
                        <tr @key="product.ProductId" data-row="@product.ProductId" class="border-b border-dashed border-line hover:bg-surface">
                            <td class="truncate text-fg" title="@product.Name">@product.Name</td>
                            <td class="text-right font-mono text-13 tabular-nums">@Number(product.Open)</td>
                            <td class="text-right font-mono text-13 tabular-nums">@Number(product.Created)</td>
                            <td class="text-right font-mono text-13 tabular-nums">@Number(product.Resolved)</td>
                            <td class="whitespace-nowrap font-mono text-13 tabular-nums">
                                @MiniBar(product.AverageResolution is { } avg && slowest > TimeSpan.Zero ? avg.Ticks * 100.0 / slowest.Ticks : 0)@FormatDuration(product.AverageResolution)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment MiniBar(double percent) => __builder =>
    {
        <span aria-hidden="true" class="mr-2 inline-block h-1.5 w-20 overflow-hidden rounded-sm bg-line align-middle">
            <span data-mini class="block h-full bg-accent" style="width: @percent.ToString("0.#", CultureInfo.InvariantCulture)%"></span>
        </span>
    };

    private RenderFragment Team(StatisticsReportDto report) => __builder =>
    {
        var team = report.Team;
        <div data-figures class="mb-8 flex flex-wrap gap-x-12 gap-y-4">
            @Figure("with-active", Heading("stats.withActive"), Number(team.Count(r => r.Active > 0)))
            @Figure("closed", WithPeriod("stats.closed"), Number(team.Sum(r => r.ClosedInPeriod)))
            @Figure("logged", WithPeriod("stats.logged"), FormatHours(team.Sum(r => r.MinutesInPeriod)))
        </div>

        @if (team.Count == 0)
        {
            <p data-no-data class="font-mono text-13 text-muted">@L.Translate("stats.noData")</p>
            return;
        }

        var maxWorkload = Math.Max(1, team.Max(r => r.Workload));
        <div class="overflow-x-auto">
            <table data-table="team" class="w-full min-w-[820px] border-collapse text-left text-14">
                <thead>
                    <tr class="border-b border-line font-mono text-13 text-muted">
                        <SortHeader Text="@Heading("stats.developer")" Column="name" Sort="teamSort" OnSort="SortTeam" />
                        <SortHeader Text="@Heading("stats.inProgress")" Column="inprogress" Sort="teamSort" OnSort="SortTeam" Class="w-28 text-right" />
                        <SortHeader Text="@Heading("stats.active")" Column="active" Sort="teamSort" OnSort="SortTeam" Class="w-24 text-right" />
                        <SortHeader Text="@WithPeriod("stats.closed")" Column="closed" Sort="teamSort" OnSort="SortTeam" Class="w-32 text-right" />
                        <SortHeader Text="@WithPeriod("stats.time")" Column="time" Sort="teamSort" OnSort="SortTeam" Class="w-28 text-right" />
                        <SortHeader Text="@Heading("stats.avgPerTicket")" Column="avg" Sort="teamSort" OnSort="SortTeam" Class="w-32 text-right" />
                        <SortHeader Text="@Heading("stats.workload")" Column="workload" Sort="teamSort" OnSort="SortTeam" Class="w-40" />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in SortedTeam(report))
                    {
                        var cell = row.IsIdle ? "text-muted" : null;
                        <tr @key="row.UserId" data-row="@row.UserId" data-idle="@(row.IsIdle ? "true" : null)" class="border-b border-dashed border-line hover:bg-surface">
                            <td>
                                <span class="flex min-w-0 items-center gap-2.5">
                                    <Avatar Name="@row.DisplayName" Size="AvatarSize.Sm" />
                                    <span class="truncate @(row.IsIdle ? "text-muted" : "text-fg")">@row.DisplayName</span>
                                    <span class="shrink-0 font-mono text-13 text-muted">@@@row.Login</span>
                                </span>
                            </td>
                            <td class="text-right font-mono text-13 tabular-nums @cell">@Number(row.InProgress)</td>
                            <td class="text-right font-mono text-13 tabular-nums @cell">@Number(row.Active)</td>
                            <td class="text-right font-mono text-13 tabular-nums @cell">@Number(row.ClosedInPeriod)</td>
                            <td class="text-right font-mono text-13 tabular-nums @cell">@(row.MinutesInPeriod > 0 ? FormatDuration(TimeSpan.FromMinutes(row.MinutesInPeriod), withDays: false) : "—")</td>
                            <td class="text-right font-mono text-13 tabular-nums @cell">@(row.AverageMinutesPerTicket is double avg ? FormatDuration(TimeSpan.FromMinutes(avg), withDays: false) : "—")</td>
                            <td class="whitespace-nowrap font-mono text-13 tabular-nums @cell">@MiniBar(row.Workload * 100.0 / maxWorkload)@Number(row.Workload)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p data-workload-note class="mt-2.5 font-mono text-12 text-muted">@L.Translate("stats.workloadNote")</p>
    };
}
