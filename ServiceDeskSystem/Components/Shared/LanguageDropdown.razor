@using ServiceDeskSystem.Application.Services.Localization
@inject ILocalizationService L
@implements IDisposable

<div class="relative inline-block text-left" @onclick:stopPropagation="true">
    <button type="button" 
            @onclick="ToggleDropdown"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/60 text-xs sm:text-sm font-semibold shadow-xs transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
            aria-expanded="@isOpen"
            aria-haspopup="true">
        <!-- Globe Icon -->
        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>@GetCurrentLanguageDisplay()</span>
        <!-- Dropdown chevron -->
        <svg class="w-3.5 h-3.5 text-gray-400 transition-transform duration-200 @(isOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
    </button>

    @if (isOpen)
    {
        <!-- Backdrop for clicking outside -->
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>

        <div class="absolute right-0 mt-1.5 w-44 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-xl py-1 z-50 animate-in fade-in zoom-in-95 duration-100">
            @foreach (var lang in L.SupportedLanguages)
            {
                var isSelected = lang.Code == L.CurrentLanguage;
                <button type="button"
                        @onclick="@(() => SelectLanguage(lang.Code))"
                        class="w-full flex items-center justify-between px-3.5 py-2 text-xs sm:text-sm font-medium transition-colors duration-150 @(isSelected ? "bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 font-semibold" : "text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/60")">
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-[10px] px-1.5 py-0.5 rounded bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 uppercase tracking-wider">@lang.Code</span>
                        <span>@lang.NativeName</span>
                    </div>
                    @if (isSelected)
                    {
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                        </svg>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private bool isOpen;

    protected override void OnInitialized()
    {
        L.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        isOpen = !isOpen;
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private void SelectLanguage(string code)
    {
        L.SetLanguage(code);
        isOpen = false;
    }

    private string GetCurrentLanguageDisplay()
    {
        var current = L.SupportedLanguages.FirstOrDefault(l => l.Code == L.CurrentLanguage);
        return current?.NativeName ?? L.CurrentLanguage.ToUpperInvariant();
    }

    public void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
    }
}
