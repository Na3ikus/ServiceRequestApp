@page "/my-tickets"

@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-7xl mx-auto p-4 sm:p-6">
    <PageHeader Segments="Segments" Subtitle="@L.Translate("myTickets.subtitle")">
        <Actions>
            <a href="create-ticket" class="btn-accent inline-flex items-center">@Heading("nav.newTicket")</a>
        </Actions>
    </PageHeader>

    @if (Tickets is null)
    {
        <div class="space-y-2" aria-busy="true">
            @for (var i = 0; i < 6; i++)
            {
                <div class="h-11 rounded-md bg-surface"></div>
            }
        </div>
    }
    else if (Tickets.Count == 0)
    {
        <EmptyState Message="@L.Translate("myTickets.noTickets")" ActionText="@Heading("nav.newTicket")"
                    OnAction="@(() => Navigation.NavigateTo("/create-ticket"))" />
    }
    else
    {
        var shown = TicketFilter.Apply(Tickets, Filter);
        <TicketFilters Value="Filter" ValueChanged="f => Filter = f" Shown="shown.Count" Total="Tickets.Count" />

        @if (shown.Count == 0)
        {
            <EmptyState Message="@L.Translate("tickets.nothingFound")" ActionText="@Heading("search.clearFilters")"
                        OnAction="@(() => Filter = new TicketFilterState())" />
        }
        else
        {
            <TicketTable Tickets="shown" OnTicketClick="ViewTicket" ShowAuthor="false" />
        }
    }
</div>

@code {
    private static readonly IReadOnlyList<PathSegment> Segments = [new ("my-tickets")];

    private TicketFilterState Filter { get; set; } = new ();
}
