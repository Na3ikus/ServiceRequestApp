@page "/admin"
@page "/admin/{Section}"
@using ServiceDeskSystem.Components.Pages.Admin.Components
@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-7xl mx-auto p-4 sm:p-6">
    @if (!IsAdmin)
    {
        <PageHeader Segments="DeniedSegments" />
        <div data-access-denied>
            <EmptyState Message="@L.Translate("admin.accessDenied")" />
        </div>
    }
    else
    {
        <PageHeader Segments="Segments" Subtitle="@L.Translate("admin.subtitle")" />

        <nav data-admin-tabs aria-label="@L.Translate("nav.section.management")"
             class="mb-5 flex gap-1 overflow-x-auto border-b border-line font-mono text-14">
            @foreach (var tab in Sections)
            {
                var active = tab == ActiveSection;
                <a href="@($"/admin/{tab}")" data-tab="@tab" aria-current="@(active ? "page" : null)"
                   class="relative shrink-0 whitespace-nowrap px-3 py-2 hover:text-fg @(active ? "text-fg" : "text-muted")">
                    <span>@tab</span>@TabBadge(tab)
                    @if (active)
                    {
                        <span aria-hidden="true" class="absolute inset-x-2 -bottom-px h-0.5 bg-accent"></span>
                    }
                </a>
            }
        </nav>

        @switch (ActiveSection)
        {
            case "techstacks":
                <TechStacksTab TechStacks="TechStacks" OnTechStacksChanged="LoadDataAsync" />
                break;
            case "users":
                <UsersTab Users="Users" OnUsersChanged="LoadDataAsync" />
                break;
            case "tags":
                <TagsTab Tags="Tags" OnTagsChanged="LoadDataAsync" />
                break;
            case "sla":
                <SlaTab Policies="SlaPolicies" Products="Products" OnPoliciesChanged="LoadDataAsync" />
                break;
            case "smtp":
                <SmtpTab Log="SmtpLog" IsChecking="IsCheckingSmtp" IsSending="IsSendingTestEmail"
                         OnCheck="CheckSmtpAsync" OnSend="SendTestEmailAsync" />
                break;
            default:
                <ProductsTab Products="Products" TechStacks="TechStacks" OnProductsChanged="LoadDataAsync" />
                break;
        }
    }
</div>

@code {
    private RenderFragment TabBadge(string tab) => __builder =>
    {
        if (tab == "smtp")
        {
            var (state, dotClass, text) = SmtpState();
            <span data-smtp-dot="@state" title="@text" class="ml-1.5 inline-block h-[7px] w-[7px] rounded-full align-middle @dotClass"></span>
            <span class="sr-only">@text</span>
        }
        else if (Count(tab) is int count)
        {
            <span class="ml-1.5 text-12 text-muted">@count</span>
        }
    };
}
