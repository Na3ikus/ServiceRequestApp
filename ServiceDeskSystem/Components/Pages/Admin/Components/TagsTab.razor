@inherits BaseComponent
@using System.Globalization

@{
    var rows = GetFilteredTags();
}

<AdminToolbar @bind-Value="SearchQuery">
    <Actions>
        <button type="button" data-action="add" class="btn-accent h-8 px-3 text-13" title="@L.Translate("tags.addTag")"
                @onclick="ShowAddTag">+ @Heading("details.tagShort")</button>
    </Actions>
</AdminToolbar>

@if (rows is null)
{
    <p data-loading class="px-3.5 py-7 font-mono text-13 text-muted">@Heading("common.loading")</p>
}
else if (rows.Count == 0 && !Row.IsAdding)
{
    @if (string.IsNullOrWhiteSpace(SearchQuery))
    {
        <EmptyState Message="@L.Translate("details.noTags")" />
    }
    else
    {
        <EmptyState Message="@L.Translate("admin.noSearchResults")" ActionText="@Heading("admin.clearSearch")" OnAction="ClearSearch" />
    }
}
else
{
    <div class="overflow-x-auto">
        <table data-term class="w-full min-w-[560px] border-collapse text-left text-14">
            <thead>
                <tr class="border-b border-line font-mono text-13 text-muted">
                    <SortHeader Text="@Heading("details.tagShort")" Column="name" Sort="Sort" OnSort="SortBy" />
                    <th class="w-40 font-normal">@Heading("tags.tagColor")</th>
                    <SortHeader Text="@Heading("admin.tickets")" Column="count" Sort="Sort" OnSort="SortBy" Class="w-28 text-right" />
                    <th class="w-24 font-normal"><span class="sr-only">@L.Translate("admin.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Row.IsAdding)
                {
                    @EditFields(L.Translate("tags.addTag"))
                }
                @foreach (var tag in rows)
                {
                    var tickets = tag.Tickets?.Count ?? 0;
                    if (Row.IsEditing(tag.Id))
                    {
                        @EditFields(L.Translate("tags.editTag"))
                    }
                    else if (Row.IsDeleting(tag.Id))
                    {
                        <DeletePrompt @key="@($"delete-{tag.Id}")" Columns="Columns" Kind="tag" Name="@tag.Name"
                                      Detail="@(tickets > 0 ? string.Format(CultureInfo.CurrentCulture, L.Translate("admin.tagDeleteDetail"), tickets) : null)"
                                      IsDeleting="Row.IsBusy" OnConfirm="() => DeleteTagAsync(tag)" OnCancel="Row.Close" />
                    }
                    else
                    {
                        <tr @key="tag" data-row="@tag.Id" class="border-b border-dashed border-line hover:bg-surface">
                            <td>@Chip(tag.Name, tag.Color)</td>
                            <td class="font-mono text-13 text-muted">@tag.Color</td>
                            <td class="text-right font-mono @(tickets == 0 ? "text-muted" : "text-fg")">@tickets</td>
                            <td class="whitespace-nowrap text-right font-mono text-13">
                                <button type="button" data-action="edit" class="text-muted hover:text-fg" @onclick="() => EditTag(tag)">@Heading("common.edit")</button>
                                <button type="button" data-action="delete" class="ml-3 text-muted hover:text-danger"
                                        title="@L.Translate("common.delete")" aria-label="@L.Translate("common.delete")"
                                        @onclick="() => Row.ConfirmDelete(tag.Id)">×</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int Columns = 4;

    private static RenderFragment Chip(string name, string color) => __builder =>
    {
        <span class="inline-flex max-w-full items-center gap-1.5 rounded-md border border-line px-[7px] py-px font-mono text-13 text-fg">
            <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @color" aria-hidden="true"></span>
            <span class="truncate">@name</span>
        </span>
    };

    private RenderFragment EditFields(string label) => __builder =>
    {
        <EditRow @key="@($"edit-{EditingTag.Id}-{Row.IsAdding}")" Columns="Columns" Label="@label" IsSaving="Row.IsBusy" Error="@Row.Error"
                 OnSave="SaveAsync" OnCancel="Row.Close" FocusTarget="() => firstField">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-[2fr_2fr_3fr]">
                <div>
                    <label for="tag-name" class="mb-1 block text-13 text-muted">@Heading("tags.tagName")</label>
                    <input id="tag-name" type="text" class="input-field h-8 px-2.5 text-14" @ref="firstField"
                           placeholder="@L.Translate("tags.namePlaceholder")"
                           @bind="EditingTag.Name" @bind:event="oninput" />
                </div>
                <div>
                    <label for="tag-color-hex" class="mb-1 block text-13 text-muted">@Heading("tags.tagColor")</label>
                    <div class="flex items-center gap-2">
                        <input type="color" class="input-field h-8 w-10 shrink-0 cursor-pointer p-0.5"
                               aria-label="@L.Translate("tags.tagColor")" @bind="EditingTag.Color" @bind:event="oninput" />
                        <input id="tag-color-hex" type="text" class="input-field h-8 px-2.5 font-mono text-13 uppercase" placeholder="#3B82F6"
                               @bind="EditingTag.Color" @bind:event="oninput" />
                    </div>
                </div>
                <div>
                    <span class="mb-1 block text-13 text-muted">@Heading("tags.colorPresets")</span>
                    <div class="flex min-h-8 flex-wrap items-center gap-2">
                        @foreach (var color in PresetColors)
                        {
                            var picked = string.Equals(EditingTag.Color, color, StringComparison.OrdinalIgnoreCase);
                            <button type="button" data-preset="@color" aria-label="@color" aria-pressed="@(picked ? "true" : "false")"
                                    class="h-5 w-5 rounded-full @(picked ? "ring-2 ring-accent ring-offset-2 ring-offset-surface" : null)"
                                    style="background-color: @color"
                                    @onclick="() => EditingTag.Color = color"></button>
                        }
                    </div>
                </div>
            </div>
            <div class="mt-3 flex items-center gap-2 text-13 text-muted">
                <span>@Heading("tags.livePreview"):</span>
                <span data-tag-preview>@Chip(string.IsNullOrWhiteSpace(EditingTag.Name) ? Heading("tags.tagPreview") : EditingTag.Name, string.IsNullOrWhiteSpace(EditingTag.Color) ? DefaultColor : EditingTag.Color)</span>
            </div>
        </EditRow>
    };
}
