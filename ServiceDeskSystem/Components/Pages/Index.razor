@page "/"
@using ServiceDeskSystem.Domain.Enums
@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent
@inject ITicketService TicketService
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-7xl mx-auto p-4 sm:p-6">
    @if (currentUser != null)
    {
        <PageHeader>
            <Actions>
                <a href="create-ticket" class="btn-accent inline-flex items-center">@Heading("nav.newTicket")</a>
                <a href="@TicketsLink" class="btn-ghost inline-flex h-9 items-center px-3">@Heading(currentUser.Role == UserRole.User ? "nav.myTickets" : "nav.allTickets")</a>
            </Actions>
        </PageHeader>

        <h2 class="text-20 font-medium text-fg">
            @L.Translate("home.welcomeBack") @(currentUser.Person?.FirstName ?? currentUser.Login)<span class="cursor-blink text-accent-ink" aria-hidden="true">_</span>
        </h2>
        <p class="mt-1 text-13 text-muted">@L.Translate("home.subtitle")</p>

        @if (IsStaff)
        {
            <h3 class="mt-8 mb-2 font-mono text-13 text-muted"># @Heading("home.overview")</h3>
            <DashboardStats />

            @if (unassessedCount > 0)
            {
                <div data-triage-notice class="mt-4 flex flex-wrap items-center justify-between gap-3 border-l-2 border-accent bg-surface px-4 py-3">
                    <p class="text-15 text-fg">@string.Format(UiCulture, L.Translate("tickets.triageAlertDesc"), unassessedCount)</p>
                    <a href="tickets" class="font-mono text-13 text-fg hover:underline">@Heading("tickets.viewTriageQueue") →</a>
                </div>
            }
        }

        <div class="mt-8 mb-2 flex items-baseline justify-between gap-4">
            <h3 class="font-mono text-13 text-muted"># @Heading("home.recentActivity")</h3>
            @if (recentTickets is { Count: > 0 })
            {
                <a href="@TicketsLink" class="font-mono text-13 text-muted hover:text-fg">@Heading("home.viewAll") →</a>
            }
        </div>
        <TicketLog Tickets="recentTickets" ShowTriage="IsStaff" EmptyMessage="@L.Translate("home.noRecentActivity")" />
    }
</div>

@code {
    private User? currentUser;
    private List<Ticket>? recentTickets;
    private int unassessedCount;

    private bool IsStaff => currentUser?.Role is UserRole.Admin or UserRole.Developer;

    private string TicketsLink => currentUser?.Role == UserRole.User ? "/my-tickets" : "/tickets";

    protected override async Task OnInitializedAsync()
    {
        currentUser = AuthService.CurrentUser;

        if (currentUser == null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (currentUser.Role == UserRole.User)
        {
            var myTickets = await TicketService.GetUserTicketsAsync(currentUser.Id);
            recentTickets = myTickets.OrderByDescending(t => t.CreatedAt).Take(5).ToList();
        }
        else if (currentUser.Role == UserRole.Developer)
        {
            var devTickets = await TicketService.GetDeveloperTicketsAsync(currentUser.Id);
            recentTickets = devTickets.Take(5).ToList();

            var paged = await TicketService.GetPagedTicketsAsync(1, 10);
            unassessedCount = paged.Items.Count(t => !t.IsPriorityAssessed);
        }
        else // Admin
        {
            var paged = await TicketService.GetPagedTicketsAsync(1, 5);
            recentTickets = paged.Items.ToList();

            var triageCheck = await TicketService.GetPagedTicketsAsync(1, 10);
            unassessedCount = triageCheck.Items.Count(t => !t.IsPriorityAssessed);
        }
    }
}
