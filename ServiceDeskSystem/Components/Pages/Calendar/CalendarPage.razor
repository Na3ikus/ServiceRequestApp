@page "/calendar"
@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-7xl mx-auto p-4 sm:p-6">
    <PageHeader Segments="Segments" Subtitle="@L.Translate("details.calendarDesc")">
        <Actions>
            <div class="flex items-center gap-1">
                <button type="button" class="btn-ghost h-9 w-9 px-0 font-mono" aria-label="@L.Translate("calendar.previousMonth")"
                        @onclick="() => ShowMonth(-1)">‹</button>
                <span data-month-title class="min-w-36 text-center font-mono text-15 text-fg" aria-live="polite">@MonthTitle</span>
                <button type="button" class="btn-ghost h-9 w-9 px-0 font-mono" aria-label="@L.Translate("calendar.nextMonth")"
                        @onclick="() => ShowMonth(1)">›</button>
            </div>
            <button type="button" data-today class="btn-ghost h-9 px-3 font-mono text-13" @onclick="ShowToday">@Heading("calendar.today")</button>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <div class="hidden grid-cols-7 gap-px overflow-hidden rounded-lg border border-line bg-line md:grid" aria-busy="true">
            @for (var i = 0; i < 35; i++)
            {
                <div class="h-28 bg-surface"></div>
            }
        </div>
    }
    else
    {
        var events = Events();
        var first = month;
        var gridStart = GridStart(first);
        var weeks = (int)Math.Ceiling((first.DayNumber - gridStart.DayNumber + DateTime.DaysInMonth(first.Year, first.Month)) / 7.0);

        @* Month grid (md and up) *@
        <div class="hidden md:block">
            <div class="grid grid-cols-7 gap-px overflow-hidden rounded-lg border border-line bg-line">
                @foreach (var name in DayNames())
                {
                    <div data-day-name class="bg-surface px-2 py-1.5 font-mono text-12 text-muted">@name.ToLower(UiCulture)</div>
                }
                @for (var i = 0; i < weeks * 7; i++)
                {
                    var day = gridStart.AddDays(i);
                    var inMonth = day.Month == first.Month;
                    var dayEvents = inMonth && events.TryGetValue(day, out var list) ? list : [];
                    <div data-day="@day.ToString("yyyy-MM-dd")" class="min-h-28 p-1.5 @(inMonth ? "bg-canvas" : "bg-surface")">
                        <div class="mb-1 font-mono text-13">
                            @if (day == Today)
                            {
                                <span data-today-mark class="mark">@day.Day</span>
                            }
                            else
                            {
                                <span class="@(inMonth ? "text-fg" : "text-muted opacity-60")">@day.Day</span>
                            }
                        </div>
                        @if (dayEvents.Count > 0)
                        {
                            <div class="space-y-1">
                                @foreach (var e in dayEvents.Take(ChipsPerDay))
                                {
                                    @Chip(e)
                                }
                                @if (dayEvents.Count > ChipsPerDay)
                                {
                                    <a data-more href="@($"calendar#{DayAnchor(day)}")" class="block font-mono text-12 text-muted hover:text-fg"
                                       aria-label="@($"+{dayEvents.Count - ChipsPerDay} · {day.ToString("d MMMM", UiCulture)}")">
                                        +@(dayEvents.Count - ChipsPerDay)
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* The month's days with events, under the grid (and instead of it on phones). *@
        <section data-agenda class="md:mt-8" aria-labelledby="calendar-month-list">
            <h2 id="calendar-month-list" class="mb-3 hidden font-mono text-13 text-muted md:block"># @Heading("calendar.thisMonth")</h2>
            @if (events.Count == 0)
            {
                <EmptyState Message="@L.Translate("calendar.noEvents")" />
            }
            else
            {
                @foreach (var (day, dayEvents) in events.OrderBy(kv => kv.Key))
                {
                    <div id="@DayAnchor(day)" class="mb-5 scroll-mt-4">@DayList(day, dayEvents)</div>
                }
            }
        </section>
    }
</div>

@code {
    private RenderFragment Chip(CalendarEvent e) => __builder =>
    {
        <a href="@($"/ticket/{e.Ticket.Id}")" data-chip="@e.Kind"
           class="block truncate rounded border px-1.5 py-0.5 font-mono text-12 hover:bg-surface @KindClass(e.Kind)"
           title="@($"{KindLabel(e.Kind)}: #{e.Ticket.Id} {e.Ticket.Title}")">@Marker(e.Kind) #@e.Ticket.Id @e.Ticket.Title</a>
    };

    private RenderFragment DayList(DateOnly day, IReadOnlyList<CalendarEvent> dayEvents) => __builder =>
    {
        <h3 class="mb-1 font-mono text-13 @(day == Today ? "text-fg" : "text-muted")"># @day.ToString("d MMMM, ddd", UiCulture).ToLower(UiCulture)</h3>
        <ul class="border-t border-dashed border-line">
            @foreach (var e in dayEvents)
            {
                <li class="border-b border-dashed border-line">
                    <a href="@($"/ticket/{e.Ticket.Id}")" class="flex items-baseline gap-3 px-2 py-2 hover:bg-surface">
                        <span class="font-mono text-13 @KindText(e.Kind)">@Marker(e.Kind)</span>
                        <span class="shrink-0 font-mono text-13 text-muted">#@e.Ticket.Id</span>
                        <span class="min-w-0 flex-1 truncate text-15 text-fg">@e.Ticket.Title</span>
                        <span class="shrink-0 font-mono text-12 @KindText(e.Kind)">@KindLabel(e.Kind).ToLower(UiCulture)</span>
                    </a>
                </li>
            }
        </ul>
    };
}
