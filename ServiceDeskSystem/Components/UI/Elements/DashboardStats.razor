@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent

<div class="grid grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded-lg border border-line bg-line">
    <StatFigure Label="@Heading("dashboard.totalTickets")" Value="displayTotalTickets" />
    <StatFigure Label="@Heading("dashboard.openTickets")" Value="displayOpenTickets" Total="displayTotalTickets" />
    <StatFigure Label="@Heading("dashboard.criticalPriority")" Value="displayCriticalTickets" Total="displayTotalTickets"
                Danger="true" Alarm="criticalTickets > 0" />
    <StatFigure Label="@Heading("dashboard.myTickets")" Value="displayMyTickets" Total="displayTotalTickets" />
</div>
