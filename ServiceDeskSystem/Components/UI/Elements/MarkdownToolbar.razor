@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ServiceDeskSystem.Application.Services.Localization.ILocalizationService L

@* Mono glyphs instead of icons; title and aria-label carry the action name. *@
<div role="toolbar" aria-label="@(L.Translate("markdown.hint").TrimEnd(':'))" class="mb-2 flex w-fit items-center gap-0.5 rounded-md border border-line bg-surface p-1 font-mono text-13">
    <button type="button" @onclick='() => ApplyFormatting("**", "**")' class="@ButtonClass font-semibold" title="@L.Translate("markdown.bold")" aria-label="@L.Translate("markdown.bold")">B</button>
    <button type="button" @onclick='() => ApplyFormatting("*", "*")' class="@ButtonClass italic" title="@L.Translate("markdown.italic")" aria-label="@L.Translate("markdown.italic")">I</button>
    <span aria-hidden="true" class="mx-1 h-4 w-px bg-line"></span>
    <button type="button" @onclick='() => ApplyFormatting("`", "`")' class="@ButtonClass" title="@L.Translate("markdown.code")" aria-label="@L.Translate("markdown.code")">`</button>
    <button type="button" @onclick='() => ApplyFormatting("> ", "")' class="@ButtonClass" title="@L.Translate("markdown.quote")" aria-label="@L.Translate("markdown.quote")">&gt;</button>
    <span aria-hidden="true" class="mx-1 h-4 w-px bg-line"></span>
    <button type="button" @onclick='() => ApplyFormatting("[", "](https://)")' class="@ButtonClass" title="@L.Translate("markdown.link")" aria-label="@L.Translate("markdown.link")">[]</button>
</div>

@code {
    private const string ButtonClass = "flex h-7 min-w-7 items-center justify-center rounded px-1.5 text-muted hover:bg-canvas hover:text-fg";

    [Parameter, EditorRequired]
    public ElementReference TargetElement { get; set; }

    private async Task ApplyFormatting(string prefix, string suffix)
    {
        try
        {
            await JS.InvokeVoidAsync("window.markdownEditor.insertFormatting", TargetElement, prefix, suffix);
        }
        catch (Exception)
        {
            // Ignore errors
        }
    }
}
