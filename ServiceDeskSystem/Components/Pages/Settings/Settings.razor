                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.fontFamily")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.fontFamilyDesc")</p>
                    </div>
                    <div class="flex gap-3 flex-wrap">
                        @foreach (var (val, label, cssFont) in new[] {
                            ("inter", "Inter", "'Inter', sans-serif"),
                            ("jetbrains", "JetBrains Mono", "'JetBrains Mono', monospace"),
                            ("outfit", "Outfit", "'Outfit', sans-serif"),
                            ("nunito", "Nunito", "'Nunito', sans-serif"),
                            ("fira", "Fira Sans", "'Fira Sans', sans-serif") })
                        {
                            var v = val; var lbl = label; var css = cssFont;
                            <button @onclick="() => SetFontFamily(v)"
                                    class="@(fontFamily == v ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") flex flex-col items-start px-4 py-2.5 rounded-xl font-medium text-sm transition-all hover:shadow-md">
                                <span style="font-family: @css; font-weight: 600;">@lbl</span>
                                <span class="text-xs opacity-60 mt-0.5" style="font-family: @css;">Aa Bb Cc</span>
                            </button>
                        }
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Page Transitions -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.pageTransition")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.pageTransitionDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        @foreach (var (val, labelKey) in new[] { ("fade", "settings.transitionFade"), ("slide", "settings.transitionSlide"), ("none", "settings.transitionNone") })
                        {
                            var v = val; var lk = labelKey;
                            <button @onclick="() => SetPageTransition(v)"
                                    class="@(pageTransition == v ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                                @L.Translate(lk)
                            </button>
                        }
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Contrast Mode -->
                <div class="flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.contrastMode")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.contrastModeDesc")</p>
                    </div>
                    <div class="flex gap-2">
                        <button @onclick='() => SetContrastMode("standard")'
                                class="@(contrastMode == "standard" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.contrastStandard")
                        </button>
                        <button @onclick='() => SetContrastMode("high")'
                                class="@(contrastMode == "high" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18V4c4.41 0 8 3.59 8 8s-3.59 8-8 8z"/></svg>
                            @L.Translate("settings.contrastHigh")
                        </button>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Font Size Slider -->
                <div class="flex flex-col gap-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.fontSize")</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.fontSizeDesc")</p>
                        </div>
                        <span class="font-size-value-badge">@fontSize%</span>
                    </div>
                    <div class="font-size-slider-track">
                        <span class="font-size-label-sm">A</span>
                        <input type="range"
                               min="85"
                               max="115"
                               step="5"
                               value="@fontSize"
                               class="font-size-slider"
                               style="--slider-pct: @(((fontSize - 85.0) / 30.0 * 100).ToString("F0"))%"
                               @oninput="OnFontSizeInput"
                               @onchange="OnFontSizeChanged" />
                        <span class="font-size-label-lg">A</span>
                    </div>
                    <div class="flex justify-between text-xs text-gray-400 dark:text-gray-500 px-5">
                        <span>85%</span>
                        <span>100%</span>
                        <span>115%</span>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Keyboard Shortcuts -->
                <div>
                    <div class="flex items-center justify-between gap-4 mb-3">
                        <div>
                            <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.keyboardShortcuts")</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.keyboardShortcutsDesc")</p>
                        </div>
                        <button @onclick="ToggleKeyboardShortcuts"
                                class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 @(keyboardShortcutsEnabled ? "bg-blue-600" : "bg-gray-300 dark:bg-gray-600")">
                            <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow-md transition-transform duration-200 @(keyboardShortcutsEnabled ? "translate-x-6" : "translate-x-1")"></span>
                        </button>
                    </div>

                    @if (keyboardShortcutsEnabled)
                    {
                        <div class="bg-gray-50 dark:bg-gray-700/30 rounded-xl p-4 border border-gray-100 dark:border-gray-700/50 space-y-2.5">
                            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">@L.Translate("settings.shortcutHint")</p>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-700 dark:text-gray-300">@L.Translate("settings.shortcutNewTicket")</span>
                                <span class="kbd-badge">N</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-700 dark:text-gray-300">@L.Translate("settings.shortcutTickets")</span>
                                <span class="kbd-badge">T</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-700 dark:text-gray-300">@L.Translate("settings.shortcutSearch")</span>
                                <span class="kbd-badge">/</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-700 dark:text-gray-300">@L.Translate("settings.shortcutTheme")</span>
                                <span class="kbd-badge">D</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ═══════════════ Notifications Section ═══════════════ -->
        <section class="bg-white dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 overflow-hidden transition-colors hover:shadow-xl duration-300">
            <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700/50 flex items-center gap-3">
                <div class="p-2 bg-amber-100 dark:bg-amber-900/30 rounded-lg">
                    <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-gray-800 dark:text-white">@L.Translate("settings.notifications")</h2>
            </div>

            <div class="p-6 space-y-6">
                <!-- Sound -->
                <div class="flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.soundNotifications")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.soundDesc")</p>
                    </div>
                    <button @onclick="ToggleSoundNotifications"
                            class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 @(soundEnabled ? "bg-blue-600" : "bg-gray-300 dark:bg-gray-600")">
                        <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow-md transition-transform duration-200 @(soundEnabled ? "translate-x-6" : "translate-x-1")"></span>
                    </button>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Desktop notifications -->
                <div class="flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.desktopNotifications")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.desktopDesc")</p>
                    </div>
                    <button @onclick="ToggleDesktopNotifications"
                            class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 @(desktopNotificationsEnabled ? "bg-blue-600" : "bg-gray-300 dark:bg-gray-600")">
                        <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow-md transition-transform duration-200 @(desktopNotificationsEnabled ? "translate-x-6" : "translate-x-1")"></span>
                    </button>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Notification Position -->
                <div class="flex flex-col gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.notifPosition")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.notifPositionDesc")</p>
                    </div>
                    <div class="notif-position-grid">
                        @foreach (var (val, labelKey, pos) in new[] {
                            ("top-right", "settings.notifTopRight", "top-right"),
                            ("top-center", "settings.notifTopCenter", "top-center"),
                            ("bottom-right", "settings.notifBottomRight", "bottom-right"),
                            ("bottom-center", "settings.notifBottomCenter", "bottom-center") })
                        {
                            var v = val; var lk = labelKey; var p = pos;
                            <button @onclick="() => SetNotifPosition(v)"
                                    class="@(notifPosition == v ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") notif-position-btn rounded-xl font-medium text-sm transition-all hover:shadow-md">
                                <div class="notif-position-preview">
                                    <div class="notif-position-dot notif-position-dot--@p"></div>
