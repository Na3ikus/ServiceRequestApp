<div class="flex items-center justify-between gap-6 py-3 border-b border-dashed border-line">
    <div class="min-w-0">
        <div class="text-[15px] text-fg">@Label</div>
        @if (!string.IsNullOrEmpty(Description))
        {
            <div class="text-[13px] leading-[1.45] text-muted">@Description</div>
        }
    </div>
    <div class="shrink-0">
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
