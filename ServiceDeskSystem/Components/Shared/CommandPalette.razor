@implements IDisposable
@inject IJSRuntime JS
@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent

@if (_isOpen)
{
    <div class="fixed inset-0 z-[9998] flex items-start justify-center bg-canvas/80 px-4 pt-[10vh]" @onclick="Close" role="dialog" aria-modal="true" aria-label="Command palette">
        <div class="w-full max-w-[38rem] overflow-hidden rounded-lg border border-line bg-surface shadow-[0_8px_24px_rgb(0_0_0/0.12)]" @onclick:stopPropagation>
            <div class="flex items-center gap-2 border-b border-line px-4">
                <span aria-hidden="true" class="font-mono text-15 text-accent-ink">&gt;</span>
                <input @ref="_inputRef"
                       type="text"
                       class="h-12 min-w-0 flex-1 bg-transparent font-mono text-15 text-fg outline-none placeholder:text-muted"
                       placeholder="@L.Translate("cmd.placeholder")"
                       aria-label="@L.Translate("cmd.placeholder")"
                       @bind="_query"
                       @bind:event="oninput"
                       @bind:after="OnQueryChanged"
                       @onkeydown="OnKeyDown" />
                <Kbd>Esc</Kbd>
            </div>

            @if (_filteredItems.Count == 0 && !string.IsNullOrWhiteSpace(_query))
            {
                <EmptyState Message="@L.Translate("cmd.noResults")" />
            }
            else
            {
                <div class="max-h-[22rem] overflow-y-auto p-1" role="listbox">
                    @for (int i = 0; i < _filteredItems.Count; i++)
                    {
                        var item = _filteredItems[i];
                        var idx = i;
                        var selected = idx == _selectedIndex;
                        <button type="button"
                                class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left font-mono text-14 hover:bg-canvas @(selected ? "bg-canvas text-fg" : "text-muted")"
                                role="option"
                                aria-selected="@(selected ? "true" : "false")"
                                @onclick="() => ExecuteItem(item)">
                            <span aria-hidden="true" class="w-[1ch] flex-shrink-0 text-accent-ink">@(selected ? "›" : "")</span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate">@item.Label</span>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <span class="block truncate font-sans text-13 text-muted">@item.Description</span>
                                }
                            </span>
                            @if (!string.IsNullOrWhiteSpace(item.Shortcut))
                            {
                                <Kbd>@item.Shortcut</Kbd>
                            }
                        </button>
                    }
                </div>
            }

            <div class="flex flex-wrap gap-4 border-t border-line px-4 py-2 text-13 text-muted">
                <span><Kbd>↑</Kbd> <Kbd>↓</Kbd> @L.Translate("cmd.navigate")</span>
                <span><Kbd>Enter</Kbd> @L.Translate("cmd.select")</span>
                <span><Kbd>Esc</Kbd> @L.Translate("cmd.close")</span>
            </div>
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private string _query = string.Empty;
    private int _selectedIndex;
    private ElementReference _inputRef;
    private List<CommandItem> _allItems = [];
    private List<CommandItem> _filteredItems = [];
    private DotNetObjectReference<CommandPalette>? _dotNetRef;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _allItems = BuildItems();
        _filteredItems = _allItems;
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("commandPalette.register", _dotNetRef);
            }
            catch
            {
                // Prerender safe
            }
        }

        if (_isOpen)
        {
            try { await _inputRef.FocusAsync(); } catch { }
        }
    }

    [JSInvokable]
    public void Toggle()
    {
        if (_isOpen) Close();
        else Open();
    }

    [JSInvokable]
    public void Open()
    {
        _query = string.Empty;
        _filteredItems = _allItems;
        _selectedIndex = 0;
        _isOpen = true;
        InvokeAsync(StateHasChanged);
    }

    private void Close()
    {
        _isOpen = false;
        _query = string.Empty;
        StateHasChanged();
    }

    private void OnQueryChanged()
    {
        _selectedIndex = 0;
        var q = _query.Trim().ToLowerInvariant();
        _filteredItems = string.IsNullOrWhiteSpace(q)
            ? _allItems
            : _allItems.Where(x =>
                x.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (x.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Keywords?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                _selectedIndex = Math.Min(_selectedIndex + 1, _filteredItems.Count - 1);
                StateHasChanged();
                break;
            case "ArrowUp":
                _selectedIndex = Math.Max(_selectedIndex - 1, 0);
                StateHasChanged();
                break;
            case "Enter":
                if (_selectedIndex >= 0 && _selectedIndex < _filteredItems.Count)
                    ExecuteItem(_filteredItems[_selectedIndex]);
                break;
            case "Escape":
                Close();
                break;
        }
    }

    private void ExecuteItem(CommandItem item)
    {
        Close();
        if (!string.IsNullOrWhiteSpace(item.Href))
            Navigation.NavigateTo(item.Href);
        else
            item.Action?.Invoke();
    }

    private List<CommandItem> BuildItems()
    {
        return new List<CommandItem>
        {
            new("Go to Home", "/", null, "home dashboard"),
            new("Go to All Tickets", "/tickets", null, "tickets list all"),
            new("Create New Ticket", "/create-ticket", null, "new ticket create", "N"),
            new("My Tickets", "/my-tickets", null, "my tickets personal"),
            new("Calendar", "/calendar", null, "calendar schedule dates"),
            new("Statistics", "/statistics", null, "stats analytics charts"),
            new("My Profile", "/profile", null, "profile account user"),
            new("Settings", "/settings", null, "settings preferences theme"),
            new("Toggle Theme", null, () => Theme.ToggleTheme(), "dark light mode theme", "D"),
        };
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _dotNetRef?.Dispose();
        }
        base.Dispose(disposing);
    }

    private record CommandItem(
        string Label,
        string? Href,
        Action? Action,
        string? Keywords = null,
        string? Shortcut = null,
        string? Description = null
    );
}
