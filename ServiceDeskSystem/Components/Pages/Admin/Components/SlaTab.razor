@inherits BaseComponent
@using ServiceDeskSystem.Domain.Enums

@{
    var rows = GetFilteredPolicies();
}

<AdminToolbar @bind-Value="SearchQuery">
    <Actions>
        <button type="button" data-action="recalculate" class="btn-outline" disabled="@IsRecalculating"
                title="@L.Translate("sla.recalculateHint")" @onclick="RecalculateAsync">
            @(IsRecalculating ? Heading("sla.recalculating") : Heading("sla.recalculate"))
        </button>
        <button type="button" data-action="add" class="btn-accent h-8 px-3 text-13" title="@L.Translate("sla.addPolicy")"
                @onclick="ShowAddPolicy">+ @Heading("sla.policy")</button>
    </Actions>
</AdminToolbar>

@if (rows is null)
{
    <p data-loading class="px-3.5 py-7 font-mono text-13 text-muted">@Heading("common.loading")</p>
}
else if (rows.Count == 0 && !Row.IsAdding)
{
    @if (string.IsNullOrWhiteSpace(SearchQuery))
    {
        <EmptyState Message="@L.Translate("sla.noPolicies")" />
    }
    else
    {
        <EmptyState Message="@L.Translate("admin.noSearchResults")" ActionText="@Heading("admin.clearSearch")" OnAction="ClearSearch" />
    }
}
else
{
    <div class="overflow-x-auto">
        <table data-term class="w-full min-w-[880px] border-collapse text-left text-14">
            <thead>
                <tr class="border-b border-line font-mono text-13 text-muted">
                    <SortHeader Text="@Heading("sla.policy")" Column="name" Sort="Sort" OnSort="SortBy" />
                    <SortHeader Text="@Heading("sla.priority")" Column="priority" Sort="Sort" OnSort="SortBy" Class="w-28" />
                    <th class="w-40 font-normal">@Heading("table.product")</th>
                    <th class="w-24 text-right font-normal">@Heading("sla.response")</th>
                    <th class="w-24 text-right font-normal">@Heading("sla.resolution")</th>
                    <th class="w-24 text-right font-normal">@Heading("sla.warnAt")</th>
                    <th class="w-20 font-normal">@Heading("sla.active")</th>
                    <th class="w-24 font-normal"><span class="sr-only">@L.Translate("admin.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Row.IsAdding)
                {
                    @EditFields(L.Translate("sla.addPolicy"))
                }
                @foreach (var policy in rows)
                {
                    if (Row.IsEditing(policy.Id))
                    {
                        @EditFields(L.Translate("sla.editPolicy"))
                    }
                    else if (Row.IsDeleting(policy.Id))
                    {
                        <DeletePrompt @key="@($"delete-{policy.Id}")" Columns="Columns" Kind="policy" Name="@policy.Name"
                                      IsDeleting="Row.IsBusy" OnConfirm="() => DeletePolicyAsync(policy)" OnCancel="Row.Close" />
                    }
                    else
                    {
                        <tr @key="policy.Id" data-row="@policy.Id" data-inactive="@(!policy.IsActive)"
                            class="border-b border-dashed border-line hover:bg-surface @(policy.IsActive ? null : "[&>td]:opacity-60")">
                            <td>
                                <div class="flex min-w-0 flex-wrap items-center gap-2">
                                    <span class="truncate text-fg" title="@policy.Name">@policy.Name</span>
                                    @if (policy.EscalateOnBreach)
                                    {
                                        <span data-escalates><Tag Tone="Tone.Danger">@Heading("sla.escalates")</Tag></span>
                                    }
                                </div>
                            </td>
                            <td><PriorityTag Priority="policy.Priority" /></td>
                            <td class="truncate text-muted">@(policy.Product?.Name ?? L.Translate("sla.allProducts"))</td>
                            <td class="text-right font-mono">@SlaPolicy.FormatMinutes(policy.ResponseMinutes)</td>
                            <td class="text-right font-mono">@SlaPolicy.FormatMinutes(policy.ResolutionMinutes)</td>
                            <td class="text-right font-mono">@policy.WarningThresholdPercent%</td>
                            <td>
                                <ToggleSwitch Label="@(policy.IsActive ? L.Translate("sla.disable") : L.Translate("sla.enable"))"
                                              Value="policy.IsActive" ValueChanged="_ => ToggleActiveAsync(policy)" />
                            </td>
                            <td class="whitespace-nowrap text-right font-mono text-13">
                                <button type="button" data-action="edit" class="text-muted hover:text-fg" @onclick="() => EditPolicy(policy)">@Heading("common.edit")</button>
                                <button type="button" data-action="delete" class="ml-3 text-muted hover:text-danger"
                                        title="@L.Translate("common.delete")" aria-label="@L.Translate("common.delete")"
                                        @onclick="() => Row.ConfirmDelete(policy.Id)">×</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int Columns = 8;

    private const string LabelClass = "mb-1 block text-13 text-muted";

    private RenderFragment EditFields(string label) => __builder =>
    {
        <EditRow @key="@($"edit-{EditingPolicy.Id}-{Row.IsAdding}")" Columns="Columns" Label="@label" IsSaving="Row.IsBusy" Error="@Row.Error"
                 OnSave="SaveAsync" OnCancel="Row.Close" FocusTarget="() => firstField">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-[2fr_3fr_1fr_1.5fr]">
                <div>
                    <label for="sla-name" class="@LabelClass">@Heading("sla.policyName")</label>
                    <input id="sla-name" type="text" class="input-field h-8 px-2.5 text-14" @ref="firstField"
                           placeholder="@L.Translate("sla.namePlaceholder")"
                           @bind="EditingPolicy.Name" @bind:event="oninput" />
                </div>
                <div>
                    <label for="sla-description" class="@LabelClass">@Heading("sla.description")</label>
                    <input id="sla-description" type="text" class="input-field h-8 px-2.5 text-14"
                           @bind="EditingPolicy.Description" @bind:event="oninput" />
                </div>
                <div>
                    <label for="sla-priority" class="@LabelClass">@Heading("sla.priority")</label>
                    <select id="sla-priority" class="input-field h-8 min-w-0 px-2 text-14" @bind="EditingPolicy.Priority">
                        @foreach (var priority in Enum.GetValues<TicketPriority>())
                        {
                            <option value="@priority">@GetPriorityText(priority)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="sla-product" class="@LabelClass">@Heading("table.product")</label>
                    <select id="sla-product" class="input-field h-8 min-w-0 px-2 text-14" @bind="SelectedProductId">
                        <option value="0">@L.Translate("sla.allProducts")</option>
                        @foreach (var product in Products ?? [])
                        {
                            <option value="@product.Id">@product.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-3 grid grid-cols-1 items-end gap-3 md:grid-cols-[1fr_1fr_2fr_auto_auto]">
                <div>
                    <label for="sla-response" class="@LabelClass">@Heading("sla.responseMinutes") <span data-formatted="response" class="font-mono">= @SlaPolicy.FormatMinutes(EditingPolicy.ResponseMinutes)</span></label>
                    <input id="sla-response" type="number" min="1" class="input-field h-8 px-2.5 font-mono text-13"
                           @bind="EditingPolicy.ResponseMinutes" @bind:event="oninput" />
                </div>
                <div>
                    <label for="sla-resolution" class="@LabelClass">@Heading("sla.resolutionMinutes") <span data-formatted="resolution" class="font-mono">= @SlaPolicy.FormatMinutes(EditingPolicy.ResolutionMinutes)</span></label>
                    <input id="sla-resolution" type="number" min="1" class="input-field h-8 px-2.5 font-mono text-13"
                           @bind="EditingPolicy.ResolutionMinutes" @bind:event="oninput" />
                </div>
                <div>
                    <label for="sla-warn" class="@LabelClass" title="@L.Translate("sla.warnAtDesc")">@Heading("sla.warnAt")</label>
                    <div class="flex h-8 items-center gap-2.5">
                        <input id="sla-warn" type="range" min="1" max="99" step="1" class="input-field h-8 w-full border-0 bg-transparent px-0 accent-[rgb(var(--accent))]"
                               aria-describedby="sla-warn-value"
                               @bind="EditingPolicy.WarningThresholdPercent" @bind:event="oninput" />
                        <span id="sla-warn-value" class="w-10 shrink-0 text-right font-mono text-13 text-fg">@EditingPolicy.WarningThresholdPercent%</span>
                    </div>
                </div>
                <div class="flex h-8 items-center gap-2 text-14 text-fg">
                    <ToggleSwitch Label="@L.Translate("sla.escalateOnBreach")" Value="EditingPolicy.EscalateOnBreach"
                                  ValueChanged="value => EditingPolicy.EscalateOnBreach = value" />
                    <span aria-hidden="true">@Heading("sla.escalates")</span>
                </div>
                <div class="flex h-8 items-center gap-2 text-14 text-fg">
                    <ToggleSwitch Label="@L.Translate("sla.active")" Value="EditingPolicy.IsActive"
                                  ValueChanged="value => EditingPolicy.IsActive = value" />
                    <span aria-hidden="true">@Heading("sla.active")</span>
                </div>
            </div>
        </EditRow>
    };
}
