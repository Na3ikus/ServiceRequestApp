@inherits BaseComponent
@using ServiceDeskSystem.Services.Presence

<p data-online-summary class="mb-3 font-mono text-13 text-muted">
    @string.Format(UiCulture, Heading("admin.online.summary"), Sessions.Count, Sessions.Where(s => s.UserId is not null).Select(s => s.UserId).Distinct().Count())
</p>

@if (Sessions.Count == 0)
{
    <EmptyState Message="@L.Translate("admin.online.empty")" />
}
else
{
    <div class="overflow-x-auto">
        <table data-term class="w-full min-w-[640px] border-collapse text-left text-14">
            <thead>
                <tr class="border-b border-line font-mono text-13 text-muted">
                    <th class="font-normal">@Heading("admin.user")</th>
                    <th class="w-36 font-normal">@Heading("admin.role")</th>
                    <th class="w-44 font-normal">@Heading("admin.online.ip")</th>
                    <th class="w-36 font-normal">@Heading("admin.online.since")</th>
                    <th class="w-36 font-normal">@Heading("admin.online.state")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Sessions)
                {
                    <tr @key="session.CircuitId" data-online-row="@(session.Login ?? "guest")"
                        class="border-b border-dashed border-line hover:bg-surface">
                        <td>
                            @if (session.Login is null)
                            {
                                <span class="font-mono text-13 text-muted">@Heading("admin.online.guest")</span>
                            }
                            else
                            {
                                <span class="font-mono text-13 text-fg">@@@session.Login</span>
                            }
                            @if (session.CircuitId == OwnCircuitId)
                            {
                                <span data-own-session class="ml-1.5 font-mono text-12 text-muted">(@L.Translate("admin.online.you"))</span>
                            }
                        </td>
                        <td>
                            @if (session.Role is { } role)
                            {
                                <RoleTag Role="role" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td data-online-ip class="font-mono text-13 tabular-nums">@(session.IpAddress ?? "—")</td>
                        <td class="font-mono text-13 tabular-nums text-muted">@ConnectedAt(session)</td>
                        <td data-online-state="@(session.IsConnected ? "live" : "reconnecting")" class="font-mono text-13">
                            <span aria-hidden="true" class="mr-1.5 inline-block h-[7px] w-[7px] rounded-full align-middle @(session.IsConnected ? "bg-accent" : "bg-muted")"></span>
                            @Heading(session.IsConnected ? "admin.online.live" : "admin.online.reconnecting")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary>Gets or sets the open tabs, as <see cref="OnlineSessionTracker.Sessions"/> lists them.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<OnlineSession> Sessions { get; set; } = [];

    /// <summary>Gets or sets the circuit of the admin looking at the list, marked "you".</summary>
    [Parameter]
    public string? OwnCircuitId { get; set; }

    // Today's connections show the time only.
    private string ConnectedAt(OnlineSession session)
    {
        var local = ToLocal(session.ConnectedAtUtc);
        return DateOnly.FromDateTime(local) == UserZone.Today
            ? local.ToString("HH:mm", UiCulture)
            : local.ToString("d MMM, HH:mm", UiCulture);
    }
}
