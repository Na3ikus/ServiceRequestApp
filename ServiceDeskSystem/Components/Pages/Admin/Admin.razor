@page "/admin"
@using ServiceDeskSystem.Components.Features
@using ServiceDeskSystem.Components.Pages.Admin.Components
@using ServiceDeskSystem.Domain.Enums
@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="admin-shell @(Theme.IsDarkMode ? "is-dark" : "is-light")">
    @if (AuthService.CurrentUser?.Role != UserRole.Admin)
    {
        <div class="admin-access-denied">
            <div class="admin-access-denied-inner">
                <div class="admin-access-denied-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                        </path>
                    </svg>
                </div>
                <span class="admin-access-denied-text">@L.Translate("admin.accessDenied")</span>
            </div>
        </div>
    }
    else
    {
        <!-- Hero Header -->
        <div class="admin-hero">
            <div class="admin-hero-glow admin-hero-glow-1"></div>
            <div class="admin-hero-glow admin-hero-glow-2"></div>
            <div class="admin-hero-content">
                <div class="admin-hero-title-row">
                    <div class="admin-hero-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z">
                            </path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="admin-hero-heading">@L.Translate("admin.title")</h1>
                        <p class="admin-hero-sub">@L.Translate("admin.subtitle")</p>
                    </div>
                </div>

                <div class="admin-stats-strip">
                    <div class="admin-stat">
                        <svg class="admin-stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                        <div class="admin-stat-value">@(products?.Count ?? 0)</div>
                        <div class="admin-stat-label">@L.Translate("admin.products")</div>
                    </div>
                    <div class="admin-stat-divider"></div>
                    <div class="admin-stat">
                        <svg class="admin-stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                        <div class="admin-stat-value">@(techStacks?.Count ?? 0)</div>
                        <div class="admin-stat-label">@L.Translate("admin.techStacks")</div>
                    </div>
                    <div class="admin-stat-divider"></div>
                    <div class="admin-stat">
                        <svg class="admin-stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <div class="admin-stat-value">@(users?.Count ?? 0)</div>
                        <div class="admin-stat-label">@L.Translate("admin.users")</div>
                    </div>
                    <div class="admin-stat-divider"></div>
                    <div class="admin-stat">
                        <svg class="admin-stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <div class="admin-stat-value">
                            <span class="admin-smtp-dot @(smtpCheckSuccess == true ? "ok" : smtpCheckSuccess == false ? "fail" : "unknown")"></span>
                            @(isCheckingSmtp ? L.Translate("admin.smtp.checking") : smtpCheckSuccess == true ? L.Translate("admin.smtp.connected") : smtpCheckSuccess == false ? L.Translate("admin.smtp.noConnection") : L.Translate("admin.smtp.unknown"))
                        </div>
                        <div class="admin-stat-label">SMTP</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Two-column Layout -->
        <div class="admin-body">
            <!-- Sub-Sidebar -->
            <aside class="admin-sub-sidebar @(isMobileNavOpen ? "mobile-open" : "")">
                <div class="admin-sub-sidebar-overlay" @onclick="CloseMobileNav"></div>
                <nav class="admin-sub-nav">
                    <div class="admin-sub-nav-header">
                        <span class="admin-sub-nav-title">@L.Translate("nav.section.management")</span>
                    </div>

                    <button @onclick="@(() => SetActiveTab("products"))"
                            class="admin-nav-item @(activeTab == "products" ? "is-active" : "")">
                        <span class="admin-nav-item-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                            </svg>
                        </span>
                        <span class="admin-nav-item-label">@L.Translate("admin.products")</span>
                        @if (products is not null)
                        {
                            <span class="admin-nav-badge">@products.Count</span>
                        }
                    </button>

                    <button @onclick="@(() => SetActiveTab("techstacks"))"
                            class="admin-nav-item @(activeTab == "techstacks" ? "is-active" : "")">
                        <span class="admin-nav-item-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                            </svg>
                        </span>
                        <span class="admin-nav-item-label">@L.Translate("admin.techStacks")</span>
                        @if (techStacks is not null)
                        {
                            <span class="admin-nav-badge">@techStacks.Count</span>
                        }
                    </button>

                    <button @onclick="@(() => SetActiveTab("users"))"
                            class="admin-nav-item @(activeTab == "users" ? "is-active" : "")">
                        <span class="admin-nav-item-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </span>
                        <span class="admin-nav-item-label">@L.Translate("admin.users")</span>
                        @if (users is not null)
                        {
                            <span class="admin-nav-badge">@users.Count</span>
                        }
                    </button>

                    <div class="admin-nav-separator"></div>

                    <button @onclick="@(() => SetActiveTab("smtp"))"
                            class="admin-nav-item @(activeTab == "smtp" ? "is-active" : "")">
                        <span class="admin-nav-item-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </span>
                        <span class="admin-nav-item-label">@L.Translate("admin.smtp")</span>
                        <span class="admin-nav-smtp-dot @(smtpCheckSuccess == true ? "ok" : smtpCheckSuccess == false ? "fail" : "unknown")"></span>
                    </button>
                </nav>
            </aside>

            <!-- Mobile Nav Toggle -->
            <button class="admin-mobile-nav-toggle" @onclick="ToggleMobileNav">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="@(isMobileNavOpen ? "M6 18L18 6M6 6l12 12" : "M4 6h16M4 12h16M4 18h7")" />
                </svg>
                <span>@GetActiveTabLabel()</span>
                <svg class="admin-mobile-nav-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            <!-- Content Area -->
            <main class="admin-content" @key="activeTab">
                @if (activeTab == "products")
                {
                    <ProductsTab Products="products" TechStacks="techStacks" OnProductsChanged="LoadDataAsync" />
                }
                else if (activeTab == "techstacks")
                {
                    <TechStacksTab TechStacks="techStacks" OnTechStacksChanged="LoadDataAsync" />
                }
                else if (activeTab == "users")
                {
                    <UsersTab Users="users" OnUsersChanged="LoadDataAsync" />
                }
                else if (activeTab == "smtp")
                {
                    <SmtpTab SmtpCheckSuccess="smtpCheckSuccess"
                             SmtpCheckMessage="@smtpCheckMessage"
                             IsCheckingSmtp="@isCheckingSmtp"
                             OnCheckSmtp="CheckSmtpAsync" />
                }
            </main>
        </div>
    }
</div>
