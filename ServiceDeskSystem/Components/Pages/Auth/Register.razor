@page "/register"
@layout EmptyLayout
@using ServiceDeskSystem.Components.Features
@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<AuthShell Path="register" Subtitle="@L.Translate("register.title")">
    <EditForm Model="registerModel" OnValidSubmit="HandleRegisterAsync" FormName="RegisterForm">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-4 rounded-md border border-danger px-3 py-2 text-[13px] text-danger" role="alert">
                @ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-4 rounded-md border border-line px-3 py-2 text-[13px] text-fg" role="status">
                @SuccessMessage
            </div>
        }

        <div class="space-y-4">
            <!-- First & Last Name -->
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="firstName" class="mb-1 block text-[13px] text-muted">
                        @L.Translate("register.firstName")
                    </label>
                    <input id="firstName" @bind="registerModel.FirstName" @bind:event="oninput" type="text"
                           placeholder="@L.Translate("register.enterFirstName")"
                           class="input-field" />
                    <ValidationMessage For="@(() => registerModel.FirstName)" class="mt-1 text-[13px] text-danger" />
                </div>

                <div>
                    <label for="lastName" class="mb-1 block text-[13px] text-muted">
                        @L.Translate("register.lastName")
                    </label>
                    <input id="lastName" @bind="registerModel.LastName" @bind:event="oninput" type="text"
                           placeholder="@L.Translate("register.enterLastName")"
                           class="input-field" />
                    <ValidationMessage For="@(() => registerModel.LastName)" class="mt-1 text-[13px] text-danger" />
                </div>
            </div>

            <!-- Username -->
            <div>
                <label for="username" class="mb-1 block text-[13px] text-muted">
                    @L.Translate("login.username")
                </label>
                <input id="username" @bind="registerModel.Username" @bind:event="oninput" type="text"
                       placeholder="@L.Translate("login.enterUsername")"
                       class="input-field" />
                <ValidationMessage For="@(() => registerModel.Username)" class="mt-1 text-[13px] text-danger" />
            </div>

            <!-- Email -->
            <div>
                <label for="email" class="mb-1 block text-[13px] text-muted">
                    @L.Translate("register.email")
                </label>
                <input id="email" type="email" @bind="registerModel.Email" @bind:event="oninput"
                       placeholder="@L.Translate("register.enterEmail")"
                       class="input-field" />
                <ValidationMessage For="@(() => registerModel.Email)" class="mt-1 text-[13px] text-danger" />
            </div>

            <!-- Password -->
            <div>
                <label for="password" class="mb-1 block text-[13px] text-muted">
                    @L.Translate("login.password")
                </label>
                <div class="relative">
                    <input id="password" type="@(ShowPassword ? "text" : "password")"
                           @bind="registerModel.Password" @bind:event="oninput"
                           @onkeydown="HandlePasswordKeyDown" @onkeyup="HandlePasswordKeyUp"
                           placeholder="@L.Translate("login.enterPassword")"
                           class="input-field pr-9" />
                    <button type="button" @onclick="TogglePasswordVisibility"
                            class="absolute inset-y-0 right-0 flex items-center pr-3 text-muted hover:text-fg"
                            aria-label="@(ShowPassword ? L.Translate("login.hidePassword") : L.Translate("login.showPassword"))">
                        @if (ShowPassword)
                        {
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                            </svg>
                        }
                        else
                        {
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        }
                    </button>
                </div>
                @if (IsCapsLockOn)
                {
                    <p class="mt-1.5 text-[13px] text-muted"><Kbd>Caps Lock</Kbd> @L.Translate("auth.capsLock")</p>
                }
                <ValidationMessage For="@(() => registerModel.Password)" class="mt-1 text-[13px] text-danger" />
            </div>

            <!-- Confirm Password -->
            <div>
                <label for="confirmPassword" class="mb-1 block text-[13px] text-muted">
                    @L.Translate("register.confirmPassword")
                </label>
                <div class="relative">
                    <input id="confirmPassword" type="@(ShowConfirmPassword ? "text" : "password")"
                           @bind="registerModel.ConfirmPassword" @bind:event="oninput"
                           @onkeydown="HandlePasswordKeyDown" @onkeyup="HandlePasswordKeyUp"
                           placeholder="@L.Translate("register.enterConfirmPassword")"
                           class="input-field pr-9" />
                    <button type="button" @onclick="ToggleConfirmPasswordVisibility"
                            class="absolute inset-y-0 right-0 flex items-center pr-3 text-muted hover:text-fg"
                            aria-label="@(ShowConfirmPassword ? L.Translate("login.hidePassword") : L.Translate("login.showPassword"))">
                        @if (ShowConfirmPassword)
                        {
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                            </svg>
                        }
                        else
                        {
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="mt-1 text-[13px] text-danger" />
            </div>

            <!-- Submit -->
            <button type="submit" disabled="@IsLoading" class="btn-accent w-full">
                @if (IsLoading)
                {
                    <span>@L.Translate("register.signingUp")<span class="font-mono"> …</span></span>
                }
                else
                {
                    <span>@L.Translate("register.signUp")</span>
                }
            </button>
        </div>
    </EditForm>

    <!-- Login Link -->
    <p class="mt-4 text-center text-[13px] text-muted">
        @L.Translate("register.haveAccount")
        <a href="/login" class="text-fg underline">
            @L.Translate("register.signIn")
        </a>
    </p>
</AuthShell>
