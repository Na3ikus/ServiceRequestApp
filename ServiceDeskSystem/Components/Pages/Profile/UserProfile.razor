@page "/profile"
@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent
@using ServiceDeskSystem.Application.Services.Profile
@using ServiceDeskSystem.Application.Services.Profile.Models
@using Microsoft.AspNetCore.Components.Forms

<div class="max-w-6xl mx-auto p-4 sm:p-6">
    <PageHeader Segments="Segments">
        <Actions>
            @if (isSaved)
            {
                <span data-saved role="status" class="font-mono text-13"><span class="mark">[ok]</span> <span class="text-muted">@Heading("profile.saved")</span></span>
            }
        </Actions>
    </PageHeader>

    @if (loadError != null)
    {
        <div role="alert" class="rounded-md border border-danger px-3 py-2 text-13 text-danger">@L.Translate(loadError)</div>
    }
    else if (isLoading)
    {
        <div class="grid gap-8 lg:grid-cols-[280px_1fr]" aria-busy="true">
            <div class="h-56 rounded-lg bg-surface"></div>
            <div class="space-y-3">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="h-9 rounded-md bg-surface"></div>
                }
                <div class="h-24 rounded-md bg-surface"></div>
            </div>
        </div>
    }
    else if (model != null && user != null)
    {
        <div class="grid items-start gap-8 lg:grid-cols-[280px_1fr]">
            <aside>
                <div data-identity class="rounded-lg border border-line bg-surface p-5">
                    <Avatar Name="@FullName" Size="AvatarSize.Xl" />
                    <p data-full-name class="mt-4 text-20 font-medium text-fg break-words">@FullName</p>
                    <p class="font-mono text-13 text-muted">@@@user.Login</p>
                    <div class="mt-3"><RoleTag Role="user.Role" /></div>
                    @if (PrimaryContact is { } contact)
                    {
                        <p class="mt-3 text-13 break-all"><span class="text-muted">@ContactTypeName(contact.ContactTypeId)</span> <span class="text-fg">@contact.Value</span></p>
                    }
                </div>

                <h2 class="mt-6 mb-2 font-mono text-13 text-muted"># @Heading("profile.numbers")</h2>
                @if (numbers.Count == 0)
                {
                    <div class="h-16 rounded-md bg-surface" aria-busy="true"></div>
                }
                else
                {
                    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line">
                        @foreach (var (labelKey, value) in numbers)
                        {
                            <div data-number class="flex flex-col-reverse bg-canvas px-3 py-2.5">
                                <dt class="font-mono text-12 text-muted">@Heading(labelKey)</dt>
                                <dd class="font-mono text-20 tabular-nums text-fg">@value</dd>
                            </div>
                        }
                    </dl>
                }
            </aside>

            <EditForm Model="model" OnValidSubmit="HandleValidSubmit" class="min-w-0">
                <h2 class="mb-3 font-mono text-13 text-muted"># @Heading("profile.personal")</h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label for="profile-first" class="mb-1 block text-13 text-muted">@L.Translate("profile.firstName")</label>
                        <input id="profile-first" class="input-field" @bind="model.FirstName" @bind:event="oninput" />
                    </div>
                    <div>
                        <label for="profile-last" class="mb-1 block text-13 text-muted">@L.Translate("profile.lastName")</label>
                        <input id="profile-last" class="input-field" @bind="model.LastName" @bind:event="oninput" />
                    </div>
                    <div class="md:col-span-2">
                        <label for="profile-middle" class="mb-1 block text-13 text-muted">@L.Translate("profile.middleName")</label>
                        <input id="profile-middle" class="input-field" @bind="model.MiddleName" @bind:event="oninput" />
                    </div>
                    <div class="md:col-span-2">
                        <label for="profile-bio" class="mb-1 block text-13 text-muted">@L.Translate("profile.bio")</label>
                        <InputTextArea id="profile-bio" @bind-Value="model.Bio" rows="4"
                                       class="input-field h-auto py-2"
                                       placeholder="@L.Translate("profile.bioPlaceholder")" />
                    </div>
                </div>

                <div class="mt-8 mb-3 flex items-baseline justify-between gap-4">
                    <h2 class="font-mono text-13 text-muted"># @Heading("profile.contacts.title")</h2>
                    <button type="button" class="btn-ghost font-mono text-13" @onclick="AddContact">+ @Heading("profile.contacts.add")</button>
                </div>
                @if (!model.Contacts.Any())
                {
                    <EmptyState Message="@L.Translate("profile.contacts.noContacts")" />
                }
                <div class="space-y-2">
                    @foreach (var contact in model.Contacts)
                    {
                        <div data-contact class="flex items-center gap-2">
                            <InputSelect @bind-Value="contact.ContactTypeId" class="input-field w-1/3 min-w-28"
                                         aria-label="@L.Translate("profile.contacts.selectType")">
                                <option value="0">@L.Translate("profile.contacts.selectType")</option>
                                @foreach (var t in contactTypes)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </InputSelect>
                            <input class="input-field flex-1" @bind="contact.Value" @bind:event="oninput"
                                   placeholder="@L.Translate("profile.contacts.valuePlaceholder")"
                                   aria-label="@L.Translate("profile.contacts.valuePlaceholder")" />
                            <button type="button" class="btn-ghost h-9 w-9 shrink-0 px-0 font-mono hover:text-danger"
                                    title="@L.Translate("profile.contacts.delete")" aria-label="@L.Translate("profile.contacts.delete")"
                                    @onclick="() => RemoveContact(contact)">×</button>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(warningMessage))
                {
                    <div role="alert" class="mt-6 rounded-md border border-danger px-3 py-2 text-13 text-danger">@L.Translate(warningMessage)</div>
                }
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div role="alert" class="mt-6 rounded-md border border-danger px-3 py-2 text-13 text-danger">@L.Translate(errorMessage)</div>
                }

                <div class="mt-6 flex justify-end border-t border-line pt-4">
                    <button type="submit" class="btn-accent" disabled="@isSaving">
                        @L.Translate(isSaving ? "profile.saving" : "profile.saveChanges")
                    </button>
                </div>
            </EditForm>
        </div>

        <h2 class="mt-10 mb-3 font-mono text-13 text-muted"># @Heading("profile.activity")</h2>
        <ActivityHeatmap Days="activity" Today="today" />

        <h2 class="mt-10 mb-2 font-mono text-13 text-muted"># @Heading("profile.recentTickets")</h2>
        <TicketLog Tickets="recentTickets" ShowTriage="IsStaff" EmptyMessage="@L.Translate("home.noRecentActivity")" />
    }
</div>
