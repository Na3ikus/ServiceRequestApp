@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent

<!-- Created by Nazar "N1h3" Hutsol -->
<nav class="flex h-full w-full flex-col border-r border-line bg-surface" aria-label="Main navigation">
    <div class="flex h-12 flex-shrink-0 items-center border-b border-line px-4">
        <a href="" class="inline-flex">
            <Logo Size="LogoSize.Md" />
        </a>
    </div>

    <div class="flex-1 overflow-y-auto px-2 py-4">
        @foreach (var menuSection in sections)
        {
            <section class="mb-4 last:mb-0">
                <h2 class="mb-1 px-2 font-mono text-[13px] text-muted"># @menuSection.Title</h2>
                <ul>
                    @foreach (var item in menuSection.Items)
                    {
                        <li>
                            <NavLink href="@item.Url"
                                     Match="@item.Match"
                                     ActiveClass="active"
                                     class="group flex h-8 items-center rounded-md px-2 font-mono text-[13px] text-muted hover:bg-canvas hover:text-fg [&.active]:text-fg">
                                <span aria-hidden="true" class="invisible w-[1ch] flex-shrink-0 text-accent-ink group-[.active]:visible">›</span>
                                <span class="ml-[1ch] truncate">@item.Title</span>
                            </NavLink>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <div class="flex-shrink-0 border-t border-line px-4 py-3">
        <span class="text-[13px] text-muted">@L.Translate("common.footer")</span>
    </div>
</nav>
