<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ServiceDeskSystemApp.ViewModels"
             xmlns:models="clr-namespace:ServiceDeskSystemApp.Models.Tickets"
             xmlns:converters="clr-namespace:ServiceDeskSystemApp.Converters"
             xmlns:loc="clr-namespace:ServiceDeskSystemApp.Resources.Localization"
             x:Class="ServiceDeskSystemApp.Views.TicketDetailPage"
             x:DataType="viewmodels:TicketDetailViewModel"
             Title="{Binding Ticket.Id, StringFormat='Ticket #{0}'}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:PriorityToColorConverter x:Key="PriorityToColorConverter" />
            <converters:FirstLetterConverter x:Key="FirstLetterConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <ScrollView.Triggers>
                <DataTrigger TargetType="ScrollView" Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
                <DataTrigger TargetType="ScrollView" Binding="{Binding Ticket}" Value="{x:Null}">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </ScrollView.Triggers>

            <VerticalStackLayout Spacing="16" Padding="16">
                <!-- Header Card with Gradient -->
                <Border StrokeShape="RoundRectangle 16" StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                            <GradientStop Color="{StaticResource Accent}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Padding="20" Spacing="12">
                        <!-- ID and Badges -->
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding Ticket.Id, StringFormat='#{0}'}" 
                                   TextColor="#E0E7FF" 
                                   FontAttributes="Bold" 
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{Binding Ticket.Status, Converter={StaticResource StatusToColorConverter}}">
                                <Label Text="{Binding Ticket.Status}" TextColor="White" FontSize="12" FontAttributes="Bold" Padding="8,4" />
                            </Border>

                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{Binding Ticket.Priority, Converter={StaticResource PriorityToColorConverter}}">
                                <Label Text="{Binding Ticket.Priority}" TextColor="White" FontSize="12" FontAttributes="Bold" Padding="8,4" />
                            </Border>
                            
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{StaticResource PrimaryLight}" Opacity="0.8">
                                <Label Text="{Binding Ticket.TicketType}" TextColor="White" FontSize="12" FontAttributes="Bold" Padding="8,4" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Title -->
                        <Label Text="{Binding Ticket.Title}" 
                               TextColor="White" 
                               FontAttributes="Bold" 
                               FontSize="24"
                               LineBreakMode="WordWrap" />

                        <!-- Author and Date -->
                        <Label TextColor="#E0E7FF" FontSize="14">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static loc:AppResources.CreatedBy}" />
                                    <Span Text=" " />
                                    <Span Text="{Binding Ticket.CreatedByName}" FontAttributes="Bold" />
                                    <Span Text=" • " />
                                    <Span Text="{Binding Ticket.CreatedAt, StringFormat='{}{0:MMM dd, yyyy}'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- Description -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label Text="{x:Static loc:AppResources.Description}" 
                               FontAttributes="Bold" 
                               FontSize="16" 
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="{Binding Ticket.Description}" 
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Steps to Reproduce (if available) -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Ticket.StepsToReproduce}" Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding Ticket.StepsToReproduce}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label Text="{x:Static loc:AppResources.StepsToReproduce}" 
                               FontAttributes="Bold" 
                               FontSize="16" 
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="{Binding Ticket.StepsToReproduce}" 
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Details Grid -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                    <Grid Padding="16" RowSpacing="12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Assigned To -->
                        <Label Grid.Row="0" Grid.Column="0" Text="{x:Static loc:AppResources.AssignedTo}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Ticket.AssignedToName}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" HorizontalOptions="End" />

                        <!-- Due Date -->
                        <Label Grid.Row="1" Grid.Column="0" Text="{x:Static loc:AppResources.DueDate}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Ticket.DueDate, StringFormat='{}{0:MMM dd, yyyy}'}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" HorizontalOptions="End" />

                        <!-- Environment -->
                        <Label Grid.Row="2" Grid.Column="0" Text="{x:Static loc:AppResources.Environment}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Ticket.Environment}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" HorizontalOptions="End" />

                        <!-- Created At -->
                        <Label Grid.Row="3" Grid.Column="0" Text="{x:Static loc:AppResources.CreatedAt}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Ticket.CreatedAt, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" HorizontalOptions="End" />
                    </Grid>
                </Border>

                <!-- Comments -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                    <VerticalStackLayout Padding="16" Spacing="16">
                        <Label Text="{x:Static loc:AppResources.Comments}" 
                               FontAttributes="Bold" 
                               FontSize="16" 
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                        <Label Text="{x:Static loc:AppResources.NoComments}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               IsVisible="False">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Ticket.Comments.Count}" Value="0">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Ticket.Comments}" Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <CollectionView ItemsSource="{Binding Ticket.Comments}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CommentDto">
                                    <Grid ColumnSpacing="12" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Avatar -->
                                        <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="{StaticResource PrimaryLight}" VerticalOptions="Start">
                                            <Label Text="{Binding CreatedByName, Converter={StaticResource FirstLetterConverter}}" 
                                                   TextColor="White" 
                                                   FontAttributes="Bold" 
                                                   FontSize="18"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Comment Body -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding CreatedByName}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                                <Label Text="{Binding CreatedAt, StringFormat='{}{0:MMM dd, HH:mm}'}" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" FontSize="12" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Text}" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" 
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
