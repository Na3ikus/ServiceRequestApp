@inherits BaseComponent

@{
    var rows = GetFilteredStacks();
}

<AdminToolbar @bind-Value="SearchQuery">
    <Actions>
        <button type="button" data-action="add" class="btn-accent h-8 px-3 text-13" title="@L.Translate("admin.addTechStack")"
                @onclick="ShowAddTechStack">+ @Heading("admin.techStack")</button>
    </Actions>
</AdminToolbar>

@if (rows is null)
{
    <p data-loading class="px-3.5 py-7 font-mono text-13 text-muted">@Heading("common.loading")</p>
}
else if (rows.Count == 0 && !Row.IsAdding)
{
    @if (string.IsNullOrWhiteSpace(SearchQuery))
    {
        <EmptyState Message="@L.Translate("admin.noTechStacks")" />
    }
    else
    {
        <EmptyState Message="@L.Translate("admin.noSearchResults")" ActionText="@Heading("admin.clearSearch")" OnAction="ClearSearch" />
    }
}
else
{
    <div class="overflow-x-auto">
        <table data-term class="w-full min-w-[560px] border-collapse text-left text-14">
            <thead>
                <tr class="border-b border-line font-mono text-13 text-muted">
                    <SortHeader Text="@Heading("admin.name")" Column="name" Sort="Sort" OnSort="SortBy" />
                    <SortHeader Text="@Heading("admin.type")" Column="type" Sort="Sort" OnSort="SortBy" Class="w-48" />
                    <SortHeader Text="@Heading("admin.productsCount")" Column="count" Sort="Sort" OnSort="SortBy" Class="w-28 text-right" />
                    <th class="w-24 font-normal"><span class="sr-only">@L.Translate("admin.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Row.IsAdding)
                {
                    @EditFields(L.Translate("admin.addTechStack"))
                }
                @foreach (var stack in rows)
                {
                    var products = stack.Products?.Count ?? 0;
                    if (Row.IsEditing(stack.Id))
                    {
                        @EditFields(L.Translate("admin.editTechStack"))
                    }
                    else if (Row.IsDeleting(stack.Id))
                    {
                        <DeletePrompt @key="@($"delete-{stack.Id}")" Columns="Columns" Kind="techstack" Name="@stack.Name"
                                      IsDeleting="Row.IsBusy" OnConfirm="() => DeleteTechStackAsync(stack)" OnCancel="Row.Close" />
                    }
                    else
                    {
                        <tr @key="stack" data-row="@stack.Id" class="border-b border-dashed border-line hover:bg-surface">
                            <td class="truncate text-fg" title="@stack.Name">@stack.Name</td>
                            <td><Tag>@stack.Type</Tag></td>
                            <td class="text-right font-mono @(products == 0 ? "text-muted" : "text-fg")">@products</td>
                            <td class="whitespace-nowrap text-right font-mono text-13">
                                <button type="button" data-action="edit" class="text-muted hover:text-fg" @onclick="() => EditTechStack(stack)">@Heading("common.edit")</button>
                                <button type="button" data-action="delete" class="ml-3 text-muted hover:text-danger disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:text-muted"
                                        disabled="@(products > 0)"
                                        title="@(products > 0 ? L.Translate("admin.cannotDeleteTechStackWithProducts") : L.Translate("common.delete"))"
                                        aria-label="@(products > 0 ? L.Translate("admin.cannotDeleteTechStackWithProducts") : L.Translate("common.delete"))"
                                        @onclick="() => Row.ConfirmDelete(stack.Id)">×</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int Columns = 4;

    private RenderFragment EditFields(string label) => __builder =>
    {
        <EditRow @key="@($"edit-{EditingTechStack.Id}-{Row.IsAdding}")" Columns="Columns" Label="@label" IsSaving="Row.IsBusy" Error="@Row.Error"
                 OnSave="SaveAsync" OnCancel="Row.Close" FocusTarget="() => firstField">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <div>
                    <label for="stack-name" class="mb-1 block text-13 text-muted">@Heading("admin.name")</label>
                    <input id="stack-name" type="text" class="input-field h-8 px-2.5 text-14" @ref="firstField"
                           placeholder="@L.Translate("admin.techStackNamePlaceholder")"
                           @bind="EditingTechStack.Name" @bind:event="oninput" />
                </div>
                <div>
                    <label for="stack-type" class="mb-1 block text-13 text-muted">@Heading("admin.type")</label>
                    <input id="stack-type" type="text" class="input-field h-8 px-2.5 text-14"
                           placeholder="@L.Translate("admin.techStackTypePlaceholder")"
                           @bind="EditingTechStack.Type" @bind:event="oninput" />
                </div>
            </div>
        </EditRow>
    };
}
