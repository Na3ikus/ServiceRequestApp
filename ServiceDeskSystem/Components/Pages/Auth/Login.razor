@page "/login"
@layout EmptyLayout
@using ServiceDeskSystem.Components.Features
@using ServiceDeskSystem.Domain.Enums
@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<AuthShell Path="login" Subtitle="@L.Translate("login.title")">
    <EditForm Model="loginModel" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-4 rounded-md border border-danger px-3 py-2 text-13 text-danger" role="alert">
                @ErrorMessage
            </div>
        }

        <div class="space-y-4">
            <!-- Username field -->
            <div>
                <label for="username" class="mb-1 block text-13 text-muted">
                    @L.Translate("login.username")
                </label>
                <input id="username" type="text" @bind="loginModel.Username" @bind:event="oninput"
                       placeholder="@L.Translate("login.enterUsername")"
                       class="input-field" />
                <ValidationMessage For="@(() => loginModel.Username)" class="mt-1 text-13 text-danger" />
            </div>

            <!-- Password field -->
            <div>
                <label for="password" class="mb-1 block text-13 text-muted">
                    @L.Translate("login.password")
                </label>
                <div class="relative">
                    <input id="password" type="@(ShowPassword ? "text" : "password")"
                           @bind="loginModel.Password" @bind:event="oninput"
                           @onkeydown="HandlePasswordKeyDown" @onkeyup="HandlePasswordKeyUp"
                           placeholder="@L.Translate("login.enterPassword")"
                           class="input-field pr-9" />
                    <button type="button" @onclick="TogglePasswordVisibility"
                            class="absolute inset-y-0 right-0 flex items-center pr-3 text-muted hover:text-fg"
                            aria-label="@(ShowPassword ? L.Translate("login.hidePassword") : L.Translate("login.showPassword"))">
                        @if (ShowPassword)
                        {
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                            </svg>
                        }
                        else
                        {
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        }
                    </button>
                </div>
                @if (IsCapsLockOn)
                {
                    <p class="mt-1.5 text-13 text-muted"><Kbd>Caps Lock</Kbd> @L.Translate("auth.capsLock")</p>
                }
                <ValidationMessage For="@(() => loginModel.Password)" class="mt-1 text-13 text-danger" />
            </div>

            <!-- Submit button -->
            <button type="submit" disabled="@IsLoading" class="btn-accent w-full">
                @if (IsLoading)
                {
                    <span>@L.Translate("login.signingIn")<span class="font-mono"> …</span></span>
                }
                else
                {
                    <span>@L.Translate("login.signIn")</span>
                }
            </button>
        </div>
    </EditForm>

    <!-- Register Link -->
    <p class="mt-4 text-center text-13 text-muted">
        @L.Translate("login.noAccount")
        <a href="/register" class="text-fg underline">
            @L.Translate("login.signUp")
        </a>
    </p>

    <!-- Quick Demo Accounts (Controlled by AuthSettings:ShowDemoAccounts or Environment) -->
    @if (ShouldShowDemoAccounts)
    {
        <div class="mt-6 border-t border-line pt-4">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-mono text-13 text-muted"># demo</span>
                <Tag Tone="Tone.Muted">@(Env.IsDevelopment() ? "Dev Mode" : "Demo")</Tag>
            </div>

            <div class="space-y-1">
                <button type="button" @onclick='@(() => FillDemoAccount("admin", "admin123"))'
                        class="btn-ghost flex h-8 w-full items-center justify-start gap-2 font-mono text-13">
                    <RoleTag Role="UserRole.Admin" /> <span>admin</span>
                </button>

                <button type="button" @onclick='@(() => FillDemoAccount("o.kovalenko", "dev123"))'
                        class="btn-ghost flex h-8 w-full items-center justify-start gap-2 font-mono text-13">
                    <RoleTag Role="UserRole.Developer" /> <span>o.kovalenko</span>
                </button>

                <button type="button" @onclick='@(() => FillDemoAccount("m.shevchenko", "client123"))'
                        class="btn-ghost flex h-8 w-full items-center justify-start gap-2 font-mono text-13">
                    <RoleTag Role="UserRole.User" /> <span>m.shevchenko</span>
                </button>
            </div>
        </div>
    }
</AuthShell>
