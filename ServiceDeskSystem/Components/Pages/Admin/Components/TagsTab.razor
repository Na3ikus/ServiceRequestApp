@inherits BaseComponent
@using ServiceDeskSystem.Domain.Entities

@{
    var filteredTags = GetFilteredTags();
}

<div class="atab-card">
    <!-- Toolbar -->
    <div class="atab-toolbar">
        <div class="atab-toolbar-left">
            <h2 class="atab-title">@L.Translate("tags.title")</h2>
            @if (filteredTags is not null)
            {
                <span class="atab-count-badge">@filteredTags.Count</span>
            }
        </div>
        <div class="atab-toolbar-right">
            <div class="atab-search-wrap">
                <svg class="atab-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
                </svg>
                <input type="search"
                       class="atab-search-input"
                       placeholder="@(L.Translate("search.label"))..."
                       @bind="SearchQuery"
                       @bind:event="oninput" />
            </div>
            <button @onclick="ShowAddTag" class="atab-add-btn">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                @L.Translate("tags.addTag")
            </button>
        </div>
    </div>

    @if (Tags is null)
    {
        <div class="atab-loading">
            <svg class="atab-spinner" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>@L.Translate("common.loading")</span>
        </div>
    }
    else if (filteredTags is not null && filteredTags.Count == 0)
    {
        <div class="atab-empty">
            <div class="atab-empty-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
            </div>
            <p class="atab-empty-title">@(string.IsNullOrWhiteSpace(SearchQuery) ? L.Translate("details.noTags") : L.Translate("admin.noSearchResults"))</p>
            @if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                <button class="atab-empty-clear" @onclick="@(() => SearchQuery = string.Empty)">
                    @L.Translate("admin.clearSearch")
                </button>
            }
        </div>
    }
    else
    {
        <div class="atab-table-wrap">
            <table class="atab-table">
                <thead>
                    <tr>
                        <th class="atab-th sortable @(SortColumn == "name" ? "sort-active" : "")"
                            @onclick="@(() => SetSort("name"))">
                            @L.Translate("tags.tagName")
                            <span class="sort-arrow">@GetSortArrow("name")</span>
                        </th>
                        <th class="atab-th">@L.Translate("tags.tagColor")</th>
                        <th class="atab-th atab-th-center sortable @(SortColumn == "count" ? "sort-active" : "")"
                            @onclick="@(() => SetSort("count"))">
                            @L.Translate("tags.ticketsCount")
                            <span class="sort-arrow">@GetSortArrow("count")</span>
                        </th>
                        <th class="atab-th atab-th-actions">@L.Translate("admin.actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tag in filteredTags!)
                    {
                        <tr class="atab-row">
                            <td class="atab-td atab-td-primary">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-white shadow-2xs"
                                      style="background-color: @tag.Color;">
                                    <svg class="w-3 h-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                    </svg>
                                    @tag.Name
                                </span>
                            </td>
                            <td class="atab-td">
                                <div class="flex items-center gap-2">
                                    <div class="w-4 h-4 rounded-full border border-gray-200 dark:border-gray-700 shadow-2xs" style="background-color: @tag.Color;"></div>
                                    <span class="font-mono text-xs text-gray-600 dark:text-gray-400">@tag.Color</span>
                                </div>
                            </td>
                            <td class="atab-td atab-td-center">
                                <span class="atab-ticket-count @(tag.Tickets?.Count > 0 ? "has-tickets" : "")">
                                    @(tag.Tickets?.Count ?? 0)
                                </span>
                            </td>
                            <td class="atab-td atab-td-actions">
                                <div class="atab-actions">
                                    <button class="atab-action-btn edit" @onclick="@(() => EditTag(tag))" title="@L.Translate("admin.edit")">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button class="atab-action-btn delete" @onclick="@(() => DeleteTag(tag))" title="@L.Translate("admin.delete")">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="atab-footer">
            <span class="atab-footer-info">
                @if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    @($"{filteredTags!.Count} / {Tags?.Count ?? 0}")
                }
                else
                {
                    @($"{Tags?.Count ?? 0}")
                }
            </span>
        </div>
    }
</div>

@if (ShowModal)
{
    <div class="amodal-overlay" @onclick="CloseModal">
        <div class="amodal-box animate-fade-in" @onclick:stopPropagation>
            <button @onclick="CloseModal" class="amodal-close" aria-label="@L.Translate("common.close")">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="amodal-header">
                <div class="amodal-header-icon blue">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                    </svg>
                </div>
                <div>
                    <h3 class="amodal-title">@ModalTitle</h3>
                    <p class="amodal-subtitle">@L.Translate("tags.title")</p>
                </div>
            </div>

            <div class="amodal-body">
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="amodal-error">@ErrorMessage</div>
                }

                <div class="amodal-field">
                    <label class="amodal-label">@L.Translate("tags.tagName")</label>
                    <input type="text" 
                           class="amodal-input" 
                           @bind="EditingTag.Name" 
                           placeholder="@L.Translate("tags.namePlaceholder")" />
                </div>

                <div class="amodal-field">
                    <label class="amodal-label">@L.Translate("tags.tagColor")</label>
                    <div class="flex items-center gap-3">
                        <input type="color" class="h-10 w-14 rounded-lg cursor-pointer border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 p-1" @bind="EditingTag.Color" />
                        <input type="text" 
                               class="amodal-input font-mono uppercase flex-1" 
                               @bind="EditingTag.Color" 
                               placeholder="#3B82F6" />
                    </div>
                </div>

                <div class="amodal-field">
                    <label class="amodal-label">@L.Translate("tags.colorPresets")</label>
                    <div class="flex flex-wrap gap-2 pt-1">
                        @foreach (var color in PresetColors)
                        {
                            <button type="button" 
                                    @onclick="@(() => EditingTag.Color = color)"
                                    class="w-7 h-7 rounded-full transition-transform hover:scale-110 border-2 @(EditingTag.Color == color ? "border-black dark:border-white ring-2 ring-blue-500 ring-offset-1" : "border-transparent")" 
                                    style="background-color: @color;"></button>
                        }
                    </div>
                </div>

                <div class="amodal-field">
                    <label class="amodal-label">@L.Translate("tags.livePreview")</label>
                    <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 flex items-center justify-center">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-white shadow-sm"
                              style="background-color: @(string.IsNullOrWhiteSpace(EditingTag.Color) ? "#3B82F6" : EditingTag.Color);">
                            <svg class="w-3.5 h-3.5 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                            </svg>
                            @(string.IsNullOrWhiteSpace(EditingTag.Name) ? L.Translate("tags.tagPreview") : EditingTag.Name)
                        </span>
                    </div>
                </div>
            </div>

            <div class="amodal-footer">
                <button @onclick="CloseModal" class="amodal-btn-cancel">
                    @L.Translate("common.cancel")
                </button>
                <button @onclick="SaveModal" disabled="@IsSaving" class="amodal-btn-save">
                    @if (IsSaving)
                    {
                        <svg class="amodal-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                        <span>@L.Translate("common.saving")</span>
                    }
                    else
                    {
                        <span>@L.Translate("common.save")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
