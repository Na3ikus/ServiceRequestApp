@inherits BaseComponent

@{
    var rows = GetFilteredProducts();
}

<AdminToolbar @bind-Value="SearchQuery">
    <Actions>
        <button type="button" data-action="add" class="btn-accent h-8 px-3 text-13" title="@L.Translate("admin.addProduct")"
                @onclick="ShowAddProduct">+ @Heading("table.product")</button>
    </Actions>
</AdminToolbar>

@if (rows is null)
{
    <p data-loading class="px-3.5 py-7 font-mono text-13 text-muted">@Heading("common.loading")</p>
}
else if (rows.Count == 0 && !Row.IsAdding)
{
    @if (string.IsNullOrWhiteSpace(SearchQuery))
    {
        <EmptyState Message="@L.Translate("admin.noProducts")" />
    }
    else
    {
        <EmptyState Message="@L.Translate("admin.noSearchResults")" ActionText="@Heading("admin.clearSearch")" OnAction="ClearSearch" />
    }
}
else
{
    <div class="overflow-x-auto">
        <table data-term class="w-full min-w-[720px] border-collapse text-left text-14">
            <thead>
                <tr class="border-b border-line font-mono text-13 text-muted">
                    <SortHeader Text="@Heading("admin.name")" Column="name" Sort="Sort" OnSort="SortBy" Class="w-[22%]" />
                    <th class="font-normal">@Heading("admin.description")</th>
                    <SortHeader Text="@Heading("admin.version")" Column="version" Sort="Sort" OnSort="SortBy" Class="w-28" />
                    <SortHeader Text="@Heading("admin.techStack")" Column="techstack" Sort="Sort" OnSort="SortBy" Class="w-40" />
                    <th class="w-20 text-right font-normal">@Heading("admin.tickets")</th>
                    <th class="w-24 font-normal"><span class="sr-only">@L.Translate("admin.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Row.IsAdding)
                {
                    @EditFields(L.Translate("admin.addProduct"))
                }
                @foreach (var product in rows)
                {
                    var tickets = product.Tickets?.Count ?? 0;
                    if (Row.IsEditing(product.Id))
                    {
                        @EditFields(L.Translate("admin.editProduct"))
                    }
                    else if (Row.IsDeleting(product.Id))
                    {
                        <DeletePrompt @key="@($"delete-{product.Id}")" Columns="Columns" Kind="product" Name="@product.Name"
                                      IsDeleting="Row.IsBusy" OnConfirm="() => DeleteProductAsync(product)" OnCancel="Row.Close" />
                    }
                    else
                    {
                        <tr @key="product" data-row="@product.Id" class="border-b border-dashed border-line hover:bg-surface">
                            <td class="truncate text-fg" title="@product.Name">@product.Name</td>
                            <td class="max-w-0 truncate text-muted" title="@product.Description">@product.Description</td>
                            <td class="truncate font-mono text-13">@product.CurrentVersion</td>
                            <td>
                                @if (product.TechStack is not null)
                                {
                                    <Tag Title="@product.TechStack.Type">@product.TechStack.Name</Tag>
                                }
                            </td>
                            <td class="text-right font-mono @(tickets == 0 ? "text-muted" : "text-fg")">@tickets</td>
                            <td class="whitespace-nowrap text-right font-mono text-13">
                                <button type="button" data-action="edit" class="text-muted hover:text-fg" @onclick="() => EditProduct(product)">@Heading("common.edit")</button>
                                <button type="button" data-action="delete" class="ml-3 text-muted hover:text-danger disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:text-muted"
                                        disabled="@(tickets > 0)"
                                        title="@(tickets > 0 ? L.Translate("admin.cannotDeleteProductWithTickets") : L.Translate("common.delete"))"
                                        aria-label="@(tickets > 0 ? L.Translate("admin.cannotDeleteProductWithTickets") : L.Translate("common.delete"))"
                                        @onclick="() => Row.ConfirmDelete(product.Id)">×</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int Columns = 6;

    private RenderFragment EditFields(string label) => __builder =>
    {
        <EditRow @key="@($"edit-{EditingProduct.Id}-{Row.IsAdding}")" Columns="Columns" Label="@label" IsSaving="Row.IsBusy" Error="@Row.Error"
                 OnSave="SaveAsync" OnCancel="Row.Close" FocusTarget="() => firstField">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-[2fr_3fr_1fr_1.5fr]">
                <div>
                    <label for="product-name" class="mb-1 block text-13 text-muted">@Heading("admin.name")</label>
                    <input id="product-name" type="text" class="input-field h-8 px-2.5 text-14" @ref="firstField"
                           placeholder="@L.Translate("admin.productNamePlaceholder")"
                           @bind="EditingProduct.Name" @bind:event="oninput" />
                </div>
                <div>
                    <label for="product-description" class="mb-1 block text-13 text-muted">@Heading("admin.description")</label>
                    <input id="product-description" type="text" class="input-field h-8 px-2.5 text-14"
                           placeholder="@L.Translate("admin.productDescriptionPlaceholder")"
                           @bind="EditingProduct.Description" @bind:event="oninput" />
                </div>
                <div>
                    <label for="product-version" class="mb-1 block text-13 text-muted">@Heading("admin.version")</label>
                    <input id="product-version" type="text" class="input-field h-8 px-2.5 font-mono text-13" placeholder="1.0.0"
                           @bind="EditingProduct.CurrentVersion" @bind:event="oninput" />
                </div>
                <div>
                    <label for="product-stack" class="mb-1 block text-13 text-muted">@Heading("admin.techStack")</label>
                    <select id="product-stack" class="input-field h-8 min-w-0 px-2 text-14" @bind="EditingProduct.TechStackId">
                        @foreach (var ts in TechStacks ?? [])
                        {
                            <option value="@ts.Id">@ts.Name (@ts.Type)</option>
                        }
                    </select>
                </div>
            </div>
        </EditRow>
    };
}
