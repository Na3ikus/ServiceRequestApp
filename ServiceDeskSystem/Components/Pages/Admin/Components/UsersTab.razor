@inherits BaseComponent
@using ServiceDeskSystem.Domain.Enums

@{
    var filteredUsers = GetFilteredUsers();
}

<div class="atab-card">
    <!-- Toolbar -->
    <div class="atab-toolbar">
        <div class="atab-toolbar-left">
            <h2 class="atab-title">@L.Translate("admin.users")</h2>
            @if (filteredUsers is not null)
            {
                <span class="atab-count-badge">@filteredUsers.Count</span>
            }
        </div>
        <div class="atab-toolbar-right">
            <div class="atab-search-wrap">
                <svg class="atab-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
                </svg>
                <input type="search"
                       class="atab-search-input"
                       placeholder="@(L.Translate("search.label"))..."
                       @bind="SearchQuery"
                       @bind:event="oninput" />
            </div>
        </div>
    </div>

    @if (Users is null)
    {
        <div class="atab-loading">
            <svg class="atab-spinner" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>@L.Translate("common.loading")</span>
        </div>
    }
    else if (filteredUsers is not null && filteredUsers.Count == 0)
    {
        <div class="atab-empty">
            <div class="atab-empty-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <p class="atab-empty-title">@(string.IsNullOrWhiteSpace(SearchQuery) ? L.Translate("admin.noUsers") : L.Translate("admin.noSearchResults"))</p>
            @if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                <button class="atab-empty-clear" @onclick="@(() => SearchQuery = string.Empty)">
                    @L.Translate("admin.clearSearch")
                </button>
            }
        </div>
    }
    else
    {
        <div class="atab-table-wrap">
            <div class="atab-table w-full min-w-[600px]">
                <div class="grid grid-cols-12">
                    <div class="atab-th col-span-5">@L.Translate("admin.fullName")</div>
                    <div class="atab-th col-span-3">@L.Translate("admin.role")</div>
                    <div class="atab-th atab-th-center col-span-3">@L.Translate("admin.status")</div>
                    <div class="atab-th atab-th-actions col-span-1">@L.Translate("admin.actions")</div>
                </div>
                <div>
                    @foreach (var user in filteredUsers!)
                    {
                        var initials = GetInitials(user.Person.FirstName, user.Person.LastName);
                        var avatarClass = GetAvatarClass(user.Role);

                        <div class="atab-row grid grid-cols-12 items-center">
                            <!-- Avatar + Name + Login -->
                            <div class="atab-td col-span-5 truncate">
                                <div class="auser-info">
                                    <div class="auser-avatar @avatarClass shrink-0">@initials</div>
                                    <div class="auser-details truncate">
                                        <span class="auser-name truncate">@($"{user.Person.FirstName} {user.Person.LastName}")</span>
                                        <span class="auser-login truncate">@@@user.Login</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Role select -->
                            <div class="atab-td col-span-3">
                                <select @bind="user.Role"
                                        @bind:after="@(() => UpdateUserRole(user.Id, user.Role))"
                                        disabled="@(!CanEditUserRole(user))"
                                        class="atab-role-select @(!CanEditUserRole(user) ? "disabled" : "") @GetRoleSelectClass(user.Role) w-full">
                                    <option value="@UserRole.Admin">@L.Translate("admin.roleAdmin")</option>
                                    <option value="@UserRole.Developer">@L.Translate("admin.roleDeveloper")</option>
                                    <option value="@UserRole.User">@L.Translate("admin.roleUser")</option>
                                </select>
                            </div>

                            <!-- Status toggle -->
                            <div class="atab-td atab-td-center col-span-3">
                                <button @onclick="@(() => ToggleUserStatus(user.Id))"
                                        disabled="@(!CanToggleUserStatus(user))"
                                        class="atab-status-btn @(user.IsActive ? "active" : "inactive") @(!CanToggleUserStatus(user) ? "disabled" : "")">
                                    <span class="atab-status-dot"></span>
                                    @(user.IsActive ? L.Translate("admin.active") : L.Translate("admin.inactive"))
                                </button>
                            </div>

                            <!-- Actions -->
                            <div class="atab-td atab-td-actions col-span-1 flex justify-end gap-2 pr-4">
                                <button @onclick="@(() => DeleteUser(user))"
                                        class="atab-action-btn delete @(!CanDeleteUser(user) ? "disabled" : "")"
                                        disabled="@(!CanDeleteUser(user))"
                                        title="@L.Translate("common.delete")">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="atab-footer">
            <span class="atab-footer-info">
                @if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    @($"{filteredUsers!.Count} / {Users?.Count ?? 0}")
                }
                else
                {
                    @($"{Users?.Count ?? 0}")
                }
            </span>
        </div>
    }
</div>
