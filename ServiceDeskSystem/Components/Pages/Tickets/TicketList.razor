@page "/tickets"

@inherits BaseComponent
@rendermode InteractiveServer

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-7xl mx-auto p-4 sm:p-6">
    <PageHeader Segments="Segments">
        <Actions>
            <SegmentedControl Label="@L.Translate("settings.defaultView")" Options="ViewOptions"
                              Value="@ViewMode" ValueChanged="SetViewModeAsync" />
            <a href="create-ticket" class="btn-accent inline-flex items-center">@Heading("nav.newTicket")</a>
        </Actions>
    </PageHeader>

    <h2 class="mt-2 mb-2 font-mono text-13 text-muted"># @Heading("home.overview")</h2>
    <div class="mb-8">
        <DashboardStats />
    </div>

    @if (Tickets is null)
    {
        <div class="space-y-2" aria-busy="true">
            @for (var i = 0; i < 6; i++)
            {
                <div class="h-11 rounded-md bg-surface"></div>
            }
        </div>
    }
    else if (Tickets.Count == 0)
    {
        <EmptyState Message="@L.Translate("tickets.noTickets")" ActionText="@Heading("nav.newTicket")"
                    OnAction="@(() => Navigation.NavigateTo("/create-ticket"))" />
    }
    else
    {
        <TicketFilters Value="Filter" ValueChanged="SetFilter" Shown="FilteredTickets.Count" Total="Tickets.Count" />

        @if (FilteredTickets.Count == 0)
        {
            <EmptyState Message="@L.Translate("tickets.nothingFound")" ActionText="@Heading("search.clearFilters")"
                        OnAction="@(() => SetFilter(new TicketFilterState()))" />
        }
        else if (ViewMode == KanbanView)
        {
            <KanbanBoard Tickets="FilteredTickets"
                         CurrentUserId="CurrentUserId"
                         IsAdmin="IsAdmin"
                         OnStatusChanged="HandleKanbanStatusChangedAsync" />
        }
        else
        {
            <TicketTable Tickets="FilteredTickets" OnTicketClick="ViewTicket" />
        }
    }
</div>
