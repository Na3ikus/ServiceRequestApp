<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ServiceDeskSystemApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ServiceDeskSystemApp"
    xmlns:views="clr-namespace:ServiceDeskSystemApp.Views"
    xmlns:loc="clr-namespace:ServiceDeskSystemApp.Resources.Localization"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">

    <TabBar>
        <Tab Title="Dashboard">
            <ShellContent
                ContentTemplate="{DataTemplate views:DashboardPage}"
                Route="DashboardPage" />
        </Tab>
        <Tab Title="Tickets">
            <ShellContent
                ContentTemplate="{DataTemplate views:TicketsPage}"
                Route="TicketsPage" />
        </Tab>
        <Tab Title="Profile">
            <ShellContent
                ContentTemplate="{DataTemplate views:ProfilePage}"
                Route="ProfilePage" />
        </Tab>
    </TabBar>

</Shell>
