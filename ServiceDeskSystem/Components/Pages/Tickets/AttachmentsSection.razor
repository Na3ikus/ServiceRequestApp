@using ServiceDeskSystem.Application.Services.Attachments
@using ServiceDeskSystem.Domain.Entities
@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent
@inject IAttachmentService AttachmentService

<section data-section="attachments" class="border-t border-line py-6">
    <div class="mb-3 flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-13 text-muted"># @Heading("details.attachments")</h2>
        <label data-add-file class="btn-ghost inline-flex cursor-pointer items-center font-mono text-13 focus-within:outline focus-within:outline-1 focus-within:outline-fg"
               title="@L.Translate("details.maxFileSize")">
            + @Heading("details.fileShort")
            <InputFile OnChange="OnInputFileChange" class="sr-only" multiple />
        </label>
    </div>

    @if (isUploading)
    {
        <p role="status" class="mb-2 font-mono text-13 text-muted">@Heading("details.uploadingFiles") @uploadProgress%</p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p role="alert" class="mb-2 text-13 text-danger">@errorMessage</p>
    }

    @if (attachments is null)
    {
        <div class="h-9 rounded-md bg-surface" aria-busy="true"></div>
    }
    else if (attachments.Count == 0)
    {
        <p class="font-mono text-13 text-muted">&gt; @L.Translate("details.noAttachments")</p>
    }
    else
    {
        <ul class="border-t border-dashed border-line">
            @foreach (var file in attachments)
            {
                var isImage = file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                <li data-attachment class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-dashed border-line py-2">
                    @if (isImage)
                    {
                        <button type="button" class="min-w-0 flex-1 basis-48 truncate text-left text-14 text-fg hover:underline" @onclick="() => ShowLightbox(file)">@file.FileName</button>
                    }
                    else
                    {
                        <a href="/@file.FilePath" download="@file.FileName" target="_blank" class="min-w-0 flex-1 basis-48 truncate text-14 text-fg hover:underline">@file.FileName</a>
                    }
                    <span class="font-mono text-13 text-muted">@FormatSize(file.FileSize) · @(file.UploadedBy?.Login ?? "—") · @ToLocal(file.UploadedAt).ToString("dd MMM yyyy", UiCulture)</span>
                    <a href="/@file.FilePath" download="@file.FileName" class="btn-ghost inline-flex h-6 items-center px-1.5 font-mono text-13"
                       title="@L.Translate("common.download")" aria-label="@($"{L.Translate("common.download")}: {file.FileName}")">↓</a>
                    @if (CanDeleteAny || file.UploadedById == CurrentUserId)
                    {
                        <button type="button" class="btn-ghost h-6 px-1.5 font-mono text-13 hover:text-danger"
                                title="@L.Translate("common.delete")" aria-label="@($"{L.Translate("common.delete")}: {file.FileName}")"
                                @onclick="() => DeleteAttachmentAsync(file.Id)">×</button>
                    }
                </li>
            }
        </ul>
    }
</section>

@if (lightboxAttachment != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4 sm:p-8" role="dialog" aria-modal="true"
         aria-label="@lightboxAttachment.FileName" @onclick="CloseLightbox">
        <button type="button" class="absolute right-4 top-4 font-mono text-20 text-white/70 hover:text-white"
                aria-label="@L.Translate("common.close")" @onclick="CloseLightbox">×</button>
        <figure class="flex max-h-full flex-col items-center gap-3" @onclick:stopPropagation="true">
            <img src="/@lightboxAttachment.FilePath" alt="@lightboxAttachment.FileName" class="max-h-[85vh] max-w-full rounded-md object-contain" />
            <figcaption class="font-mono text-13 text-white/70">@lightboxAttachment.FileName</figcaption>
        </figure>
    </div>
}

@code {
    private const long MaxFileSize = 10 * 1024 * 1024; // 10 MB

    private List<Attachment>? attachments;
    private bool isUploading;
    private int uploadProgress;
    private string? errorMessage;
    private Attachment? lightboxAttachment;

    [Parameter, EditorRequired] public int TicketId { get; set; }

    [Parameter, EditorRequired] public int CurrentUserId { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the viewer may delete any attachment (admin/developer).
    /// </summary>
    [Parameter, EditorRequired] public bool CanDeleteAny { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAttachmentsAsync();
    }

    private async Task LoadAttachmentsAsync()
    {
        var result = await AttachmentService.GetAttachmentsByTicketIdAsync(TicketId);
        attachments = result.ToList();
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        errorMessage = null;

        var files = e.GetMultipleFiles();
        if (files.Count == 0)
        {
            return;
        }

        isUploading = true;
        uploadProgress = 0;
        StateHasChanged();

        try
        {
            var uploadedCount = 0;
            foreach (var file in files)
            {
                if (file.Size > MaxFileSize)
                {
                    errorMessage = $"{L.Translate("details.fileTooLarge")}: {file.Name}";
                    continue;
                }

                using var stream = file.OpenReadStream(MaxFileSize);
                var result = await AttachmentService.UploadAttachmentAsync(TicketId, file.Name, file.ContentType, stream, CurrentUserId);

                if (!result.Success)
                {
                    errorMessage = result.ErrorMessage;
                }

                uploadedCount++;
                uploadProgress = (int)((double)uploadedCount / files.Count * 100);
                StateHasChanged();
            }

            await LoadAttachmentsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAttachmentAsync(int id)
    {
        var result = await AttachmentService.DeleteAttachmentAsync(id, CurrentUserId);
        if (result.Success)
        {
            await LoadAttachmentsAsync();
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }
    }

    private void ShowLightbox(Attachment file) => lightboxAttachment = file;

    private void CloseLightbox() => lightboxAttachment = null;

    private static string FormatSize(long bytes)
    {
        string[] suffix = ["B", "KB", "MB", "GB"];
        var i = 0;
        double size = bytes;
        while (size >= 1024 && i < suffix.Length - 1)
        {
            size /= 1024;
            i++;
        }

        return $"{Math.Round(size, 1)} {suffix[i]}";
    }
}
