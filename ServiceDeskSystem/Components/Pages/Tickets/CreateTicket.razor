@page "/create-ticket"
@inherits BaseComponent
@rendermode InteractiveServer
@using ServiceDeskSystem.Domain.Enums

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-6xl mx-auto p-4 sm:p-6">
    <PageHeader Segments="Segments" Subtitle="@L.Translate("create.subtitle")" />

    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
        <form data-create-form class="min-w-0 space-y-5" novalidate @onsubmit="HandleSubmitAsync">
            <div data-field="type">
                <p id="create-type-label" class="mb-1.5 text-13 text-muted">@Heading("create.ticketType") <span class="text-danger">*</span></p>
                <div class="max-w-full overflow-x-auto">
                    <SegmentedControl Label="@L.Translate("create.ticketType")" Options="TypeOptions"
                                      Value="@(Model.TicketType?.ToString() ?? string.Empty)" ValueChanged="SelectType" />
                </div>
                @if (Model.TicketType is { } type)
                {
                    <p data-type-description class="mt-1.5 text-13 text-muted">@L.Translate(TypeKey(type) + ".desc")</p>
                }
                @ErrorFor(TicketCreateModel.TypeField)
            </div>

            <div data-field="title">
                <label for="create-title" class="mb-1.5 block text-13 text-muted">@Heading("create.ticketTitle") <span class="text-danger">*</span></label>
                <input id="create-title" class="input-field" placeholder="@L.Translate("create.titlePlaceholder")"
                       aria-invalid="@Invalid(TicketCreateModel.TitleField)"
                       @bind="Model.Title" @bind:event="oninput" />
                @ErrorFor(TicketCreateModel.TitleField)
            </div>

            <div data-field="description">
                <p class="mb-1.5 text-13 text-muted">@Heading("create.description") <span class="text-danger">*</span></p>
                <RichTextEditor @bind-Value="Model.Description" Placeholder="@L.Translate("create.descriptionPlaceholder")" />
                @ErrorFor(TicketCreateModel.DescriptionField)
            </div>

            @if (Model.TicketType != TicketType.Project || IsAdminOrDeveloper)
            {
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    @if (Model.TicketType != TicketType.Project)
                    {
                        <div data-field="product">
                            <label for="create-product" class="mb-1.5 block text-13 text-muted">@Heading("create.product") <span class="text-danger">*</span></label>
                            <select id="create-product" class="input-field" aria-invalid="@Invalid(TicketCreateModel.ProductField)"
                                    @bind="Model.ProductId">
                                <option value="">@L.Translate("create.selectProduct")</option>
                                @foreach (var product in Products)
                                {
                                    <option value="@product.Id">@product.Name</option>
                                }
                            </select>
                            @ErrorFor(TicketCreateModel.ProductField)
                        </div>
                    }

                    @if (IsAdminOrDeveloper)
                    {
                        <div data-field="priority">
                            <label for="create-priority" class="mb-1.5 block text-13 text-muted">@Heading("create.priority") <span class="text-danger">*</span></label>
                            <select id="create-priority" class="input-field" @bind="Model.Priority" @bind:after="OnPriorityChanged">
                                @foreach (var priority in Enum.GetValues<TicketPriority>())
                                {
                                    <option value="@priority">@GetPriorityText(priority)</option>
                                }
                            </select>

                            @if (Model.Priority == TicketPriority.Critical)
                            {
                                <div data-critical class="mt-2 space-y-1.5 rounded-md border border-danger px-3 py-2 text-13 text-danger">
                                    <p class="font-medium">@L.Translate("create.criticalWarningTitle")</p>
                                    <label class="flex cursor-pointer items-start gap-2">
                                        <input type="checkbox" class="mt-1" @bind="IsCriticalConfirmed" />
                                        <span>@L.Translate("create.confirmCritical")</span>
                                    </label>
                                    @if (!string.IsNullOrEmpty(CriticalConfirmationError))
                                    {
                                        <p role="alert" class="font-medium">@CriticalConfirmationError</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (Model.TicketType == TicketType.Bug)
            {
                <div data-bug-details class="space-y-5 border-t border-line pt-5">
                    <h2 class="font-mono text-13 text-muted"># @Heading("create.bugDetails")</h2>

                    <div>
                        <p class="mb-1.5 text-13 text-muted">@Heading("create.stepsToReproduce") <span>(@L.Translate("create.optional"))</span></p>
                        <RichTextEditor @bind-Value="Model.StepsToReproduce" Placeholder="@L.Translate("create.stepsPlaceholder")" />
                    </div>

                    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                        <div>
                            <label for="create-environment" class="mb-1.5 block text-13 text-muted">@Heading("create.environment") <span>(@L.Translate("create.optional"))</span></label>
                            <input id="create-environment" class="input-field" placeholder="@L.Translate("create.environmentPlaceholder")"
                                   @bind="Model.Environment" />
                        </div>
                        <div>
                            <label for="create-version" class="mb-1.5 block text-13 text-muted">@Heading("details.affectedVersion") <span>(@L.Translate("create.optional"))</span></label>
                            <input id="create-version" class="input-field font-mono" placeholder="@L.Translate("create.versionPlaceholder")"
                                   @bind="Model.AffectedVersion" @bind:event="oninput" />
                        </div>
                    </div>
                </div>
            }

            <div class="flex justify-end gap-2 border-t border-line pt-4">
                <button type="button" data-cancel class="btn-ghost h-9 px-3 text-15" @onclick="Cancel">@Heading("create.cancel")</button>
                <button type="submit" data-submit class="btn-accent" disabled="@IsSubmitting">
                    @Heading(IsSubmitting ? "create.creating" : "create.submit")
                </button>
            </div>
        </form>

        <aside data-preview class="hidden lg:block">
            <div class="rounded-lg border border-line bg-surface p-4">
                <p class="mb-3 font-mono text-13 text-muted">preview · #new</p>
                <div class="mb-2 flex flex-wrap gap-1.5">
                    @if (Model.TicketType is { } previewType)
                    {
                        <TypeTag Type="previewType" />
                    }
                    <StatusTag Status="TicketStatus.Open" />
                    <PriorityTag Priority="PreviewPriority" />
                </div>
                <p data-preview-title class="break-words text-15 font-medium text-fg">@(string.IsNullOrWhiteSpace(Model.Title) ? "—" : Model.Title)</p>
                <dl class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 text-13">
                    <dt class="text-muted">@Heading("table.author")</dt>
                    <dd class="truncate text-fg">@(AuthService.CurrentUser?.Login ?? "—")</dd>
                    <dt class="text-muted">@Heading("table.product")</dt>
                    <dd class="truncate text-fg">@(SelectedProduct?.Name ?? "—")</dd>
                    <dt class="text-muted">@Heading("details.affectedVersion")</dt>
                    <dd class="truncate font-mono text-fg">@(string.IsNullOrWhiteSpace(Model.AffectedVersion) ? "—" : Model.AffectedVersion)</dd>
                </dl>
            </div>
            <ul class="mt-4 space-y-1.5 font-mono text-13 text-muted">
                <li>&gt; @L.Translate("create.tip1")</li>
                <li>&gt; @L.Translate("create.tip2")</li>
                @if (!IsAdminOrDeveloper)
                {
                    <li>&gt; @L.Translate("create.tip3")</li>
                }
            </ul>
        </aside>
    </div>
</div>
