@page "/settings"
@inherits ServiceDeskSystem.Components.UI.Base.BaseComponent
@rendermode InteractiveServer
@using ServiceDeskSystem.Application.Services.Auth
@using Microsoft.JSInterop

<!-- Created by Nazar "N1h3" Hutsol -->
<div class="max-w-4xl mx-auto p-4 sm:p-6 animate-fade-in">

    <!-- Page Header -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-lg shadow-violet-500/30">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@L.Translate("settings.title")</h1>
                <p class="text-sm text-gray-500 dark:text-gray-400">@L.Translate("settings.subtitle")</p>
            </div>
        </div>
    </div>

    <div class="space-y-6">

        <!-- ═══════════════ Appearance Section ═══════════════ -->
        <section class="bg-white dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 overflow-hidden transition-colors hover:shadow-xl duration-300">
            <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700/50 flex items-center gap-3">
                <div class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
                    <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-gray-800 dark:text-white">@L.Translate("settings.appearance")</h2>
            </div>

            <div class="p-6 space-y-6">
                <!-- Theme - Preview Cards -->
                <div class="flex flex-col gap-3">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.theme")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.themeDesc")</p>
                    </div>
                    <div class="flex gap-4">
                        <!-- Light theme card -->
                        <button class="theme-preview-card" @onclick="() => SetTheme(false)">
                            <div class="theme-preview-thumb theme-preview-thumb--light @(!Theme.IsDarkMode ? "is-selected" : "")">
                                <div class="theme-mock">
                                    <div class="theme-mock-topbar"></div>
                                    <div class="theme-mock-rows">
                                        <div class="theme-mock-row" style="width:100%"></div>
                                        <div class="theme-mock-row" style="width:80%"></div>
                                        <div class="theme-mock-row" style="width:60%"></div>
                                    </div>
                                    <div class="theme-mock-accent" style="background: linear-gradient(90deg, #3b82f6, #6366f1);"></div>
                                </div>
                            </div>
                            <span class="theme-preview-label">
                                <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                                @L.Translate("theme.light")
                                @if (!Theme.IsDarkMode)
                                {
                                    <span class="theme-preview-badge">✓ @L.Translate("settings.activeTheme")</span>
                                }
                            </span>
                        </button>

                        <!-- Dark theme card -->
                        <button class="theme-preview-card" @onclick="() => SetTheme(true)">
                            <div class="theme-preview-thumb theme-preview-thumb--dark @(Theme.IsDarkMode && !Theme.IsSystemTheme ? "is-selected" : "")">
                                <div class="theme-mock">
                                    <div class="theme-mock-topbar" style="background:#334155;"></div>
                                    <div class="theme-mock-rows">
                                        <div class="theme-mock-row" style="width:100%; background:#334155;"></div>
                                        <div class="theme-mock-row" style="width:80%; background:#334155;"></div>
                                        <div class="theme-mock-row" style="width:60%; background:#334155;"></div>
                                    </div>
                                    <div class="theme-mock-accent" style="background: linear-gradient(90deg, #6366f1, #8b5cf6);"></div>
                                </div>
                            </div>
                            <span class="theme-preview-label">
                                <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                                @L.Translate("theme.dark")
                                @if (Theme.IsDarkMode && !Theme.IsSystemTheme)
                                {
                                    <span class="theme-preview-badge">✓ @L.Translate("settings.activeTheme")</span>
                                }
                            </span>
                        </button>

                        <!-- System/Auto theme card -->
                        <button class="theme-preview-card" @onclick="SetThemeSystem">
                            <div class="theme-preview-thumb theme-preview-thumb--system @(Theme.IsSystemTheme ? "is-selected" : "")">
                                <div class="theme-mock">
                                    <div class="theme-mock-topbar" style="background: linear-gradient(90deg, #e2e8f0, #334155);"></div>
                                    <div class="theme-mock-rows">
                                        <div class="theme-mock-row" style="width:100%; background: linear-gradient(90deg, #e2e8f0, #334155);"></div>
                                        <div class="theme-mock-row" style="width:80%; background: linear-gradient(90deg, #e2e8f0, #334155);"></div>
                                        <div class="theme-mock-row" style="width:60%; background: linear-gradient(90deg, #e2e8f0, #334155);"></div>
                                    </div>
                                    <div class="theme-mock-accent" style="background: linear-gradient(90deg, #3b82f6, #8b5cf6);"></div>
                                </div>
                            </div>
                            <span class="theme-preview-label">
                                <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-2"></path></svg>
                                @L.Translate("settings.themeSystem")
                                @if (Theme.IsSystemTheme)
                                {
                                    <span class="theme-preview-badge">✓ @L.Translate("settings.activeTheme")</span>
                                }
                            </span>
                        </button>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Language -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.language")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.languageDesc")</p>
                    </div>
                    <div class="flex gap-3">
                        <button @onclick='() => SetLanguageAsync("en")'
                                class="@(L.CurrentLanguage == "en" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm transition-all hover:shadow-md">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"></path></svg>
                            English
                        </button>
                        <button @onclick='() => SetLanguageAsync("uk")'
                                class="@(L.CurrentLanguage == "uk" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm transition-all hover:shadow-md">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"></path></svg>
                            Українська
                        </button>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Date Format -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.dateFormat")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.dateFormatDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        @foreach (var fmt in new[] { "DD/MM/YYYY", "MM/DD/YYYY", "YYYY-MM-DD" })
                        {
                            var f = fmt;
                            <button @onclick="() => SetDateFormat(f)"
                                    class="@(dateFormat == f ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-3 py-2 rounded-xl font-mono font-semibold text-xs transition-all hover:shadow-md whitespace-nowrap">
                                @f
                            </button>
                        }
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Card Style -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.cardStyle")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.cardStyleDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <button @onclick='() => SetCardStyle("flat")'
                                class="@(cardStyle == "flat" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.cardFlat")
                        </button>
                        <button @onclick='() => SetCardStyle("elevated")'
                                class="@(cardStyle == "elevated" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.cardElevated")
                        </button>
                        <button @onclick='() => SetCardStyle("glassmorphism")'
                                class="@(cardStyle == "glassmorphism" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.cardGlass")
                        </button>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Sidebar Layout -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.sidebarLayout")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.sidebarLayoutDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <button @onclick='() => SetSidebarMode("full")'
                                class="@(!Theme.IsSidebarCollapsed ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                            @L.Translate("settings.sidebarFull")
                        </button>
                        <button @onclick='() => SetSidebarMode("compact")'
                                class="@(Theme.IsSidebarCollapsed ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8M4 18h16"></path></svg>
                            @L.Translate("settings.sidebarCompact")
                        </button>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Page Background Texture -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.bgTexture")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.bgTextureDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <button @onclick='() => SetBgTexture("clean")'
                                class="@(bgTexture == "clean" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.bgClean")
                        </button>
                        <button @onclick='() => SetBgTexture("dot-grid")'
                                class="@(bgTexture == "dot-grid" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                            @L.Translate("settings.bgDotGrid")
                        </button>
                        <button @onclick='() => SetBgTexture("mesh-gradient")'
                                class="@(bgTexture == "mesh-gradient" ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-gradient-to-r from-blue-400 to-purple-500"></span>
                            @L.Translate("settings.bgMesh")
                        </button>
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Border Radius -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.borderRadius")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.borderRadiusDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        @foreach (var (val, labelKey, svgPath) in new[] { 
                            ("sharp", "settings.radiusSharp", "<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" />"), 
                            ("rounded", "settings.radiusRounded", "<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"4\" />"), 
                            ("pill", "settings.radiusPill", "<rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"6\" />") 
                        })
                        {
                            var v = val; var lk = labelKey; var p = svgPath;
                            <button @onclick="() => SetBorderRadius(v)"
                                    class="@(borderRadius == v ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                                <svg class="w-4 h-4 opacity-70 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    @((MarkupString)p)
                                </svg>
                                @L.Translate(lk)
                            </button>
                        }
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Sidebar Color -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.sidebarColor")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.sidebarColorDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        @foreach (var (val, labelKey, svgPath) in new[] {
                            ("default", "settings.sidebarColorDefault", "<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" /><path d=\"M9 3v18\" />"),
                            ("dark", "settings.sidebarColorDark", "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z\" />"),
                            ("branded", "settings.sidebarColorBranded", "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01\" />"),
                            ("transparent", "settings.sidebarColorTransparent", "<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" stroke-dasharray=\"2 2\" />") })
                        {
                            var v = val; var lk = labelKey; var p = svgPath;
                            <button @onclick="() => SetSidebarColor(v)"
                                    class="@(sidebarColor == v ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") flex items-center gap-1.5 px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                                <svg class="w-4 h-4 opacity-70 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    @((MarkupString)p)
                                </svg>
                                @L.Translate(lk)
                            </button>
                        }
                    </div>
                </div>

                <hr class="border-gray-100 dark:border-gray-700/50" />

                <!-- Content Width -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">@L.Translate("settings.contentWidth")</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@L.Translate("settings.contentWidthDesc")</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        @foreach (var (val, labelKey, svgPath) in new[] { 
                            ("narrow", "settings.widthNarrow", "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 4v16M15 4v16M4 12h5M15 12h5\" />"), 
                            ("standard", "settings.widthStandard", "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 4v16M18 4v16M4 12h2M18 12h2\" />"), 
                            ("wide", "settings.widthWide", "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 4v16M20 4v16\" />") 
                        })
                        {
                            var v = val; var lk = labelKey; var p = svgPath;
                            <button @onclick="() => SetContentWidth(v)"
                                    class="@(contentWidth == v ? "ring-2 ring-blue-500 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 shadow-md shadow-blue-500/20" : "ring-1 ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300") flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-sm transition-all hover:shadow-md whitespace-nowrap">
                                <svg class="w-4 h-4 opacity-70 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    @((MarkupString)p)
                                </svg>
                                @L.Translate(lk)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══════════════ Visual Effects Section ═══════════════ -->
        <section class="bg-white dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 overflow-hidden transition-colors hover:shadow-xl duration-300">
